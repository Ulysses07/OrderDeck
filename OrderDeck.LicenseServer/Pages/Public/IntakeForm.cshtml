@page "/r/{slug}"
@model IntakeFormModel
@{
    Layout = null;
    ViewData["Title"] = Model.Config?.CustomTitle ?? "Bilgi Gönder";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
<main class="container py-4" style="max-width: 480px;">
    <h2 class="mb-4">@(Model.Config!.CustomTitle ?? "Bilgi Gönder")</h2>
    <form method="post" asp-page-handler="Submit" autocomplete="off">
        <input type="hidden" asp-for="Slug" />

        <p class="text-muted small mb-3">
            İzlediğiniz platformlardaki kullanıcı adlarınızı girin (en az bir tane).
            Birden fazla platformdan izliyorsanız hepsini yazabilirsiniz.
        </p>

        <div class="mb-3">
            <label asp-for="Input.InstagramUsername" class="form-label">Instagram kullanıcı adı</label>
            <input asp-for="Input.InstagramUsername" class="form-control form-control-lg" maxlength="64" autofocus />
            <span asp-validation-for="Input.InstagramUsername" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.YouTubeUsername" class="form-label">YouTube kullanıcı adı</label>
            <input asp-for="Input.YouTubeUsername" class="form-control form-control-lg" maxlength="64" />
            <span asp-validation-for="Input.YouTubeUsername" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.FacebookUsername" class="form-label">Facebook kullanıcı adı</label>
            <input asp-for="Input.FacebookUsername" class="form-control form-control-lg" maxlength="64" />
            <span asp-validation-for="Input.FacebookUsername" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.TikTokUsername" class="form-label">TikTok kullanıcı adı</label>
            <input asp-for="Input.TikTokUsername" class="form-control form-control-lg" maxlength="64" />
            <span asp-validation-for="Input.TikTokUsername" class="text-danger"></span>
        </div>

        <hr class="my-4" />

        <div class="mb-3">
            <label asp-for="Input.FullName" class="form-label">Ad Soyad</label>
            <input asp-for="Input.FullName" class="form-control form-control-lg" maxlength="200" />
            <span asp-validation-for="Input.FullName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label">E-posta <span class="text-danger">*</span></label>
            <input asp-for="Input.Email" type="email" class="form-control form-control-lg" maxlength="200" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Address" class="form-label">Kargo Adresi</label>
            <textarea asp-for="Input.Address" class="form-control" rows="3" maxlength="500"></textarea>
            <span asp-validation-for="Input.Address" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Phone" class="form-label">WhatsApp Numarası <span class="text-danger">*</span></label>
            <input asp-for="Input.Phone" type="tel" class="form-control form-control-lg"
                   placeholder="555 123 45 67" maxlength="20" />
            <div class="form-text">+90 otomatik eklenecek. 10 haneli mobil numarayı girin.</div>
            <span asp-validation-for="Input.Phone" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Tckn" class="form-label">TC Kimlik No <span class="text-muted">(opsiyonel — fatura için)</span></label>
            <input asp-for="Input.Tckn" type="text" inputmode="numeric" class="form-control form-control-lg"
                   maxlength="11" placeholder="11 haneli" />
            <span asp-validation-for="Input.Tckn" class="text-danger"></span>
        </div>

        <div class="form-check mb-2">
            <input asp-for="Input.WhatsAppConsent" class="form-check-input" type="checkbox" />
            <label asp-for="Input.WhatsAppConsent" class="form-check-label">
                WhatsApp üzerinden bilgilendirme/kampanya mesajı almayı kabul ediyorum.
            </label>
        </div>

        <div class="form-check mb-3">
            <input asp-for="Input.SmsConsent" class="form-check-input" type="checkbox" />
            <label asp-for="Input.SmsConsent" class="form-check-label">
                SMS üzerinden bilgilendirme/kampanya mesajı almayı kabul ediyorum.
            </label>
        </div>

        <p class="text-muted" style="font-size: 0.8rem;">
            Gönderdiğiniz bilgiler yalnızca sipariş, kargo ve fatura işlemleriniz için
            yayıncı tarafından kullanılır. Verileriniz üçüncü kişilerle pazarlama amacıyla
            paylaşılmaz. İzin verdiğiniz kanallardan iletişim kurulabilir.
        </p>

        <input type="text" name="website" tabindex="-1" autocomplete="off"
               style="position:absolute;left:-9999px;display:none" />

        <button type="submit" class="btn btn-success btn-lg w-100">
            Tamamla ve WhatsApp'tan Gönder
        </button>
    </form>
</main>
</body>
</html>
