@page "/musteri-kayit/{slug}"
@model IntakeFormModel
@{
    Layout = null;
    ViewData["Title"] = Model.Config?.CustomTitle ?? "Bilgi Gönder";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        :root {
            --od-red: #e11900;
            --od-red-dark: #b91400;
            --od-amber: #f59e0b;
            --od-ink: #18181b;
            --od-muted: #6b7280;
            --od-line: #e5e7eb;
            --od-bg: #f4f4f5;
            --od-ok: #16a34a;
            --od-warn: #d97706;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0; background: var(--od-bg); color: var(--od-ink);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased; line-height: 1.5;
        }
        .wrap { max-width: 480px; margin: 0 auto; padding: 20px 16px 48px; }
        .brand { display:flex; align-items:center; gap:8px; font-weight:800; letter-spacing:-.02em;
                 color:var(--od-red); font-size:18px; margin-bottom:18px; }
        .brand .dot { width:10px; height:10px; border-radius:50%; background:var(--od-red); }
        .card { background:#fff; border:1px solid var(--od-line); border-radius:16px;
                box-shadow:0 1px 2px rgba(0,0,0,.04), 0 8px 24px rgba(0,0,0,.05); padding:22px; }
        h1 { font-size:22px; font-weight:800; margin:0 0 4px; letter-spacing:-.02em; }
        .sub { color:var(--od-muted); font-size:14px; margin:0 0 18px; }
        .section-label { font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.04em;
                         color:var(--od-muted); margin:18px 0 10px; }
        .field { margin-bottom:14px; }
        label.lbl { display:block; font-size:13.5px; font-weight:600; margin-bottom:6px; }
        .req { color:var(--od-red); }
        .opt { color:var(--od-muted); font-weight:400; }
        input.inp, textarea.inp, select.inp {
            width:100%; padding:11px 12px; font-size:16px; color:var(--od-ink);
            border:1.5px solid var(--od-line); border-radius:10px; background:#fff; outline:none;
            transition:border-color .15s, box-shadow .15s; font-family:inherit;
        }
        input.inp:focus, textarea.inp:focus, select.inp:focus { border-color:var(--od-red); box-shadow:0 0 0 3px rgba(225,25,0,.12); }
        input.inp.invalid, textarea.inp.invalid, select.inp.invalid { border-color:var(--od-red); }
        textarea.inp { resize:vertical; min-height:74px; }
        select.inp { appearance:none; -webkit-appearance:none; height:46px; cursor:pointer;
                     background-image:url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%236b7280'%3E%3Cpath d='M4.5 6.5 8 10l3.5-3.5z'/%3E%3C/svg%3E");
                     background-repeat:no-repeat; background-position:right 10px center; background-size:16px;
                     padding-right:32px; }
        select.inp:disabled { background-color:#f9fafb; color:var(--od-muted); cursor:not-allowed; }
        .row2 { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
        .with-prefix { position:relative; }
        .with-prefix .pfx { position:absolute; left:12px; top:50%; transform:translateY(-50%);
                            color:var(--od-muted); font-size:16px; pointer-events:none; }
        .with-prefix input.inp { padding-left:26px; }
        .hint { font-size:12px; color:var(--od-muted); margin-top:5px; }
        .err { font-size:12.5px; color:var(--od-red); margin-top:5px; min-height:1px; }
        .yt-status { font-size:13px; margin-top:6px; display:flex; align-items:center; gap:8px; min-height:20px; }
        .yt-status img { width:22px; height:22px; border-radius:50%; }
        .yt-confirm { display: flex; align-items: center; gap: 8px; margin-top: 8px;
                      font-size: 14px; cursor: pointer; }
        /* Yazar kuralı, tarayıcının [hidden]{display:none} kuralını köken
           önceliğiyle ezer. Bu satır olmadan onay kutusu HİÇ gizlenmez:
           kanal kartı çizilmeden de ekranda durur ve müşteri görmediği bir
           kanalı "bana ait" diye onaylayabilir — özelliğin tek koruması bu bağ. */
        .yt-confirm[hidden] { display: none; }
        .yt-confirm input { width: 18px; height: 18px; flex: none; cursor: pointer; }
        .yt-ok { color:var(--od-ok); font-weight:600; }
        .yt-warn { color:var(--od-warn); font-weight:600; }
        .yt-checking { color:var(--od-muted); }
        .spinner { width:14px; height:14px; border:2px solid var(--od-line); border-top-color:var(--od-muted);
                   border-radius:50%; animation:spin .7s linear infinite; }
        @@keyframes spin { to { transform:rotate(360deg); } }
        hr.div { border:0; border-top:1px solid var(--od-line); margin:20px 0; }
        .check { display:flex; align-items:flex-start; gap:10px; margin-bottom:10px; font-size:13.5px; color:var(--od-ink); }
        .check input { width:18px; height:18px; margin-top:1px; accent-color:var(--od-red); flex:0 0 auto; }
        .kvkk { font-size:11.5px; color:var(--od-muted); margin:14px 0 4px; }
        .btn { width:100%; padding:14px; font-size:16px; font-weight:700; color:#fff; background:var(--od-red);
               border:0; border-radius:12px; cursor:pointer; margin-top:16px;
               transition:background .15s, transform .05s; }
        .btn:hover { background:var(--od-red-dark); }
        .btn:active { transform:translateY(1px); }
        .platform-ico { display:inline-block; width:16px; text-align:center; margin-right:5px; }
        .hidden-hp { position:absolute; left:-9999px; display:none; }
        a.btn { display:block; text-align:center; text-decoration:none; }
        .ok-ico { width:52px; height:52px; border-radius:50%; background:rgba(22,163,74,.12);
                  color:var(--od-ok); font-size:28px; line-height:52px; text-align:center;
                  margin:0 auto 14px; }
        .ok-wrap { text-align:center; }
        .ok-wrap h1 { margin-bottom:8px; }
    </style>
</head>
<body>
<div class="wrap">
    <div class="brand"><span class="dot"></span> OrderDeck</div>
    <div class="card">
@if (Model.Submitted)
{
        <div class="ok-wrap">
            <div class="ok-ico">✓</div>
            <h1>Kaydın alındı</h1>
            @if (Model.WhatsAppUrl is not null)
            {
                <p class="sub">
                    Şimdi WhatsApp açılıp yayıncıya göndereceğin mesaj hazır gelecek.
                    Açılmazsa aşağıdaki butona dokun.
                </p>
                <a class="btn" id="waLink" href="@Model.WhatsAppUrl" rel="noopener">WhatsApp'tan gönder</a>
            }
            else
            {
                <p class="sub">
                    Bilgilerin yayıncıya ulaştı. WhatsApp bağlantısı şu an kullanılamıyor,
                    tekrar form doldurmana gerek yok.
                </p>
            }
        </div>
}
else
{
        <h1>@(Model.Config!.CustomTitle ?? "Bilgi Gönder")</h1>
        <p class="sub">Bilgilerini gir, tamamla — WhatsApp'tan yayıncıya iletilsin.</p>

        <form id="intakeForm" method="post" asp-page-handler="Submit" autocomplete="off">
            <input type="hidden" asp-for="Slug" />

            <div class="section-label">Kullanıcı adların (en az bir tane)</div>

            <div class="field">
                <label class="lbl" asp-for="Input.InstagramUsername"><span class="platform-ico">📷</span>Instagram</label>
                <div class="with-prefix">
                    <span class="pfx">@@</span>
                    <input class="inp uname" asp-for="Input.InstagramUsername" maxlength="200"
                           inputmode="text" placeholder="kullaniciadi veya profil adresi" />
                </div>
                <span class="err" asp-validation-for="Input.InstagramUsername"></span>
            </div>

            <div class="field">
                <label class="lbl" asp-for="Input.YouTubeUsername"><span class="platform-ico">📺</span>YouTube</label>
                <div class="with-prefix">
                    <span class="pfx">@@</span>
                    <input class="inp uname" id="ytUser" asp-for="Input.YouTubeUsername" maxlength="200"
                           inputmode="text" placeholder="kanalhandle veya kanal adresi" />
                </div>
                @* aria-live: onaylanacak kanal adı JS ile yazılıyor. Duyurulmazsa
                   ekran okuyucu kullanan müşteri adı hiç duymadan onay verir. *@
                <div class="yt-status" id="ytStatus" aria-live="polite">
                    @if (!string.IsNullOrEmpty(Model.YouTubeChannelTitle))
                    {
                        @* Hatalı gönderimden sonra kart tekrar çizilsin; JS de aynısını üretiyor. *@
                        @if (!string.IsNullOrEmpty(Model.YouTubeChannelThumbnail))
                        {
                            <img src="@Model.YouTubeChannelThumbnail" alt="" />
                        }
                        <span class="yt-ok">✓ @Model.YouTubeChannelTitle</span>
                    }
                </div>
                <label class="yt-confirm" id="ytConfirmWrap"
                       hidden="@(string.IsNullOrEmpty(Model.YouTubeChannelTitle))">
                    <input type="checkbox" id="ytConfirm" asp-for="Input.YouTubeConfirmed" />
                    <span>Bu kanal bana ait.</span>
                </label>
                @* Sıra önemli: showError() alandaki İLK .err kutusunu buluyor ve
                   JS'in yazdığı her mesaj kullanıcı adına ait. Onay kutusunun
                   hatasını yalnız sunucu yazıyor, JS de gizlerken temizliyor. *@
                <span class="err" asp-validation-for="Input.YouTubeUsername"></span>
                <span class="err" id="ytConfirmErr" asp-validation-for="Input.YouTubeConfirmed"></span>
            </div>

            <div class="field">
                <label class="lbl" asp-for="Input.FacebookUsername"><span class="platform-ico">👥</span>Facebook</label>
                <input class="inp uname" asp-for="Input.FacebookUsername" maxlength="64" placeholder="kullanıcı adı" />
                <span class="err" asp-validation-for="Input.FacebookUsername"></span>
            </div>

            <div class="field">
                <label class="lbl" asp-for="Input.TikTokUsername"><span class="platform-ico">🎵</span>TikTok</label>
                <div class="with-prefix">
                    <span class="pfx">@@</span>
                    <input class="inp uname" asp-for="Input.TikTokUsername" maxlength="200" placeholder="kullaniciadi veya profil adresi" />
                </div>
                <span class="err" asp-validation-for="Input.TikTokUsername"></span>
            </div>
            <div class="err" id="unameErr"></div>

            <hr class="div" />
            <div class="section-label">İletişim & teslimat</div>

            <div class="field">
                <label class="lbl" asp-for="Input.FullName">Ad Soyad <span class="req">*</span></label>
                <input class="inp" asp-for="Input.FullName" maxlength="200" required placeholder="Adınız Soyadınız" />
                <span class="err" asp-validation-for="Input.FullName"></span>
            </div>

            <div class="field">
                <label class="lbl" asp-for="Input.Email">E-posta <span class="req">*</span></label>
                <input class="inp" asp-for="Input.Email" type="email" maxlength="200" required placeholder="ornek@@eposta.com" />
                <span class="err" asp-validation-for="Input.Email"></span>
            </div>

            <div class="row2">
                <div class="field">
                    <label class="lbl" asp-for="Input.City">İl <span class="req">*</span></label>
                    <select class="inp" asp-for="Input.City" id="citySel" required>
                        <option value="">Seçin</option>
                        @foreach (var c in TurkeyRegions.Cities)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                    <span class="err" asp-validation-for="Input.City"></span>
                </div>

                <div class="field">
                    <label class="lbl" asp-for="Input.District">İlçe <span class="req">*</span></label>
                    @* Tüm ilçeler ile göre optgroup'lanmış olarak basılır: JS bunu
                       okuyup seçilen ile göre daraltıyor, JS kapalıysa liste uzun
                       ama form yine çalışıyor. Ayrı bir JSON isteği/gömmesi yok. *@
                    <select class="inp" asp-for="Input.District" id="districtSel" required>
                        <option value="">Seçin</option>
                        @foreach (var c in TurkeyRegions.Cities)
                        {
                            <optgroup label="@c">
                                @foreach (var d in TurkeyRegions.Districts[c])
                                {
                                    <option value="@d">@d</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <span class="err" asp-validation-for="Input.District"></span>
                </div>
            </div>

            <div class="field">
                <label class="lbl" asp-for="Input.Address">Kargo Adresi <span class="req">*</span></label>
                <textarea class="inp" asp-for="Input.Address" rows="3" maxlength="500" required
                          placeholder="Mahalle, cadde, sokak, bina/daire no"></textarea>
                <div class="hint">İl ve ilçeyi yukarıdan seçtin — buraya sadece kalanını yaz.</div>
                <span class="err" asp-validation-for="Input.Address"></span>
            </div>

            <div class="field">
                <label class="lbl" asp-for="Input.Phone">WhatsApp Numarası <span class="req">*</span></label>
                <input class="inp" asp-for="Input.Phone" type="tel" maxlength="20" required
                       placeholder="555 123 45 67" inputmode="tel" />
                <div class="hint">Başında +90 otomatik eklenecek. 10 haneli mobil numaranı gir.</div>
                <span class="err" asp-validation-for="Input.Phone"></span>
            </div>

            <div class="field">
                <label class="lbl" asp-for="Input.Tckn">TC Kimlik No <span class="opt">(opsiyonel — fatura için)</span></label>
                <input class="inp" asp-for="Input.Tckn" type="text" inputmode="numeric" maxlength="11" placeholder="11 haneli" />
                <span class="err" asp-validation-for="Input.Tckn"></span>
            </div>

            <label class="check">
                <input asp-for="Input.WhatsAppConsent" type="checkbox" />
                <span>WhatsApp üzerinden bilgilendirme/kampanya mesajı almayı kabul ediyorum.</span>
            </label>
            <label class="check">
                <input asp-for="Input.SmsConsent" type="checkbox" />
                <span>SMS üzerinden bilgilendirme/kampanya mesajı almayı kabul ediyorum.</span>
            </label>

            <p class="kvkk">
                Gönderdiğin bilgiler yalnızca sipariş, kargo ve fatura işlemlerin için yayıncı tarafından
                kullanılır. Üçüncü kişilerle pazarlama amacıyla paylaşılmaz. İzin verdiğin kanallardan iletişim kurulabilir.
            </p>

            <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden-hp" />

            <div class="err" id="formErr"></div>
            <button type="submit" class="btn">Tamamla ve WhatsApp'tan Gönder</button>
        </form>
}
    </div>
</div>

@if (Model.Submitted && Model.WhatsAppUrl is not null)
{
    <script>
    // WhatsApp'a geçiş bilerek burada, form gönderiminin 302'siyle değil:
    // CSP `form-action` form gönderimlerini ve onların yönlendirme zincirini
    // denetliyor, `location.href` ise hiçbir CSP direktifinin kapsamında değil.
    // Atlama başarısız olsa bile yukarıdaki "Kaydın alındı" ekranı ve buton
    // duruyor, yani müşteri hiçbir koşulda boş ekranla kalmıyor.
    (function () {
        var l = document.getElementById('waLink');
        if (l) window.location.href = l.href;
    })();
    </script>
}

<script>
(function () {
    // Onay ekranında form yok; aşağıdaki kodun tamamı form alanlarına dokunuyor.
    if (!document.getElementById('intakeForm')) return;

    // (a) Kullanici adi normalize: bastaki at-isaretini + DIS bosluklari temizle
    // (chat'teki halle eslessin, gruplama saglam olsun).
    // IC bosluk bilerek KORUNUR: "Musa Sevinc" sessizce "MusaSevinc"e donusurse
    // kullanici hatasini goremez, ustelik var olmayan ama gecerli gorunen bir
    // kullanici adi uretilir. Boslugu birakip asagidaki kural kontrolune
    // yakalatiyoruz. Sunucu tarafi ayni kurali HandleValidator ile uyguluyor.
    var AT = '\u0040'; // U+0040 at-isareti; Razor literal parse etmesin diye kod ile
    function normalizeHandle(v) {
        v = (v || '').trim();
        while (v.charAt(0) === AT) v = v.slice(1).replace(/^\s+/, '');
        return v.trim();
    }

    // Sunucudaki ProfileUrlParser'ın aynası. Yetkili kaynak SUNUCU — ama
    // "ayrışırsa sunucu yakalar" BURADA GEÇERLİ DEĞİL: applyParse alanın
    // değerini yerinde değiştiriyor, yani sunucuya giden şey artık adres değil
    // çıkarılan kullanıcı adı. İstemci "share"i geçerli sayarsa sunucu yalnız
    // "share" görür (eğik çizgi yok → dokunmadan geçer) ve HandleValidator onu
    // geçerli bir Instagram adı sanar. Kayıt sessizce yanlış adla yazılır.
    // Bu yüzden iki liste de ProfileUrlParser.cs ile BİREBİR aynı olmalı.
    var IG_POST = ['p', 'reel', 'reels', 'stories', 'tv'];
    var IG_RESERVED = ['explore', 'accounts', 'direct', 'challenge', 's', 'share'];

    function isChannelId(id) { return /^UC[A-Za-z0-9_-]{22}$/.test(id); }

    // Döner: { kind: 'handle'|'channelId'|'error', value: string, error: string }
    function parseProfileUrl(platform, raw) {
        var s = (raw || '').trim();
        if (s.length === 0 || s.indexOf('/') < 0 || platform === 'FacebookUsername')
            return { kind: 'handle', value: s, error: '' };

        var rest = s;
        var sch = rest.indexOf('://');
        if (sch >= 0) rest = rest.slice(sch + 3);
        var cut = rest.search(/[?#]/);
        if (cut >= 0) rest = rest.slice(0, cut);
        rest = rest.replace(/\/+$/, '');

        var sl = rest.indexOf('/');
        var host = (sl < 0 ? rest : rest.slice(0, sl)).toLowerCase();
        var path = sl < 0 ? '' : rest.slice(sl + 1);
        // Zincirleme DEĞİL: sunucu if/else if yapıyor (ProfileUrlParser.cs).
        // Zincirlersek "www.m.instagram.com" istemcide tanınır, sunucuda tanınmaz.
        if (host.indexOf('www.') === 0) host = host.slice(4);
        else if (host.indexOf('m.') === 0) host = host.slice(2);

        var hostPlatform =
            (host === 'youtube.com' || host === 'youtu.be') ? 'YouTubeUsername' :
            (host === 'instagram.com') ? 'InstagramUsername' :
            (host === 'tiktok.com' || host === 'vm.tiktok.com' || host === 'vt.tiktok.com')
                ? 'TikTokUsername' : null;

        // Tanımadığımız adres: mevcut "sadece kullanıcı adını yaz" mesajına düşsün.
        if (!hostPlatform) return { kind: 'handle', value: s, error: '' };

        if (hostPlatform !== platform)
            return { kind: 'error', value: '',
                     error: 'Bu bir ' + RULES[hostPlatform].name + ' adresi. '
                          + RULES[platform].name + ' kutusuna ' + RULES[platform].name
                          + ' kullan\u0131c\u0131 ad\u0131n\u0131 yaz.' };

        var seg = path.length === 0 ? [] : path.split('/');

        if (hostPlatform === 'YouTubeUsername') {
            var ytHelp = 'Kanal sayfan\u0131 a\u00e7, adres \u00e7ubu\u011fundaki '
                       + AT + ' ile ba\u015flayan adresi yap\u0131\u015ft\u0131r.';
            if (host === 'youtu.be' || seg.length === 0)
                return { kind: 'error', value: '',
                         error: 'Bu bir video adresi, kanal adresi de\u011fil. ' + ytHelp };
            if (seg[0].charAt(0) === AT) {
                var h = seg[0].slice(1);
                return h.length === 0
                    ? { kind: 'error', value: '', error: 'Adreste kanal ad\u0131 g\u00f6r\u00fcnm\u00fcyor. ' + ytHelp }
                    : { kind: 'handle', value: h, error: '' };
            }
            if (seg[0] === 'channel') {
                var id = seg[1] || '';
                return isChannelId(id)
                    ? { kind: 'channelId', value: id, error: '' }
                    : { kind: 'error', value: '',
                        error: 'Kanal adresi eksik ya da bozuk g\u00f6r\u00fcn\u00fcyor. ' + ytHelp };
            }
            return { kind: 'error', value: '', error: 'Bu adresten kanal\u0131 bulam\u0131yoruz. ' + ytHelp };
        }

        if (hostPlatform === 'InstagramUsername') {
            var igHelp = 'Profil sayfan\u0131 a\u00e7, adres \u00e7ubu\u011fundakini yap\u0131\u015ft\u0131r.';
            if (seg.length === 0)
                return { kind: 'error', value: '',
                         error: 'Adreste kullan\u0131c\u0131 ad\u0131 g\u00f6r\u00fcnm\u00fcyor. ' + igHelp };
            var igFirst = seg[0].toLowerCase();
            if (IG_POST.indexOf(igFirst) >= 0)
                return { kind: 'error', value: '',
                         error: 'Bu bir g\u00f6nderi adresi, profil adresi de\u011fil. ' + igHelp };
            if (IG_RESERVED.indexOf(igFirst) >= 0)
                return { kind: 'error', value: '',
                         error: 'Bu bir profil adresi de\u011fil. ' + igHelp };
            return { kind: 'handle', value: seg[0], error: '' };
        }

        if (host === 'vm.tiktok.com' || host === 'vt.tiktok.com')
            return { kind: 'error', value: '',
                     error: 'Bu k\u0131sa link. Linki taray\u0131c\u0131da a\u00e7, adres '
                          + '\u00e7ubu\u011fundaki uzun adresi yap\u0131\u015ft\u0131r.' };
        if (seg.length === 0 || seg[0].charAt(0) !== AT)
            return { kind: 'error', value: '',
                     error: 'Bu bir profil adresi de\u011fil. Profil sayfan\u0131 a\u00e7, '
                          + 'adres \u00e7ubu\u011fundakini yap\u0131\u015ft\u0131r.' };
        var tth = seg[0].slice(1);
        return tth.length === 0
            ? { kind: 'error', value: '', error: 'Adreste kullan\u0131c\u0131 ad\u0131 g\u00f6r\u00fcnm\u00fcyor.' }
            : { kind: 'handle', value: tth, error: '' };
    }

    function platformOf(el) {
        return (el.getAttribute('name') || '').split('.').pop();
    }

    // Alanı yerinde ayrıştırır; parse sonucunu döner.
    //
    // channelId dalında alana DOKUNULMAZ — bilerek. Alanı çıplak "UCabc…"ye
    // çevirirsek sunucuya giden şey artık adres olmaz; ProfileUrlParser girdide
    // "/" yoksa dokunmadan geçirdiği için o değer HANDLE sanılır, forHandle=ucabc…
    // sorulur, kanal bulunamaz ve geçerli kanal adresini yapıştıran müşteri
    // engellenir. (YouTube API'ye ulaşılamadığı anda daha kötüsü: kayıt
    // Username="UCabc…" ile açılır, kimliksiz, sohbetle asla eşleşmez.)
    // Adresi olduğu gibi bırakıp kanal kimliğini sunucunun kendisine çıkarttırmak
    // "sunucu yetkilidir" kuralının da gereği. Üç çağrı yeri de bu dalda
    // el.value okumuyor, yalnız p.kind'e bakıyor.
    function applyParse(el) {
        var p = parseProfileUrl(platformOf(el), el.value);
        if (p.kind === 'handle') el.value = normalizeHandle(p.value);
        return p;
    }

    // Platform kurallari — sunucudaki HandleValidator ile ayni.
    // facebook YOK: canli yorumlarda gelen sey kullanici adi degil GORUNEN AD
    // ("Musa Sevinc"), oraya handle kurali koymak eslesmeyi kirar.
    var RULES = {
        InstagramUsername: { name: 'Instagram', min: 1, max: 30, re: /^[A-Za-z0-9._]+$/,
                             extras: 'nokta ve alt \u00e7izgi',
                             edge: '.', edgeMsg: 'nokta' },
        TikTokUsername:    { name: 'TikTok', min: 2, max: 24, re: /^[A-Za-z0-9._]+$/,
                             extras: 'nokta ve alt \u00e7izgi',
                             edge: '._', edgeMsg: 'nokta veya alt \u00e7izgi' },
        YouTubeUsername:   { name: 'YouTube', min: 3, max: 30, re: /^[A-Za-z0-9._-]+$/,
                             extras: 'nokta, tire ve alt \u00e7izgi',
                             edge: '._-', edgeMsg: 'nokta, tire veya alt \u00e7izgi' }
    };

    function ruleFor(el) {
        var n = el.getAttribute('name') || '';           // "Input.InstagramUsername"
        return RULES[n.split('.').pop()] || null;
    }

    function handleError(el, h) {
        var r = ruleFor(el);
        if (!r || h.length === 0) return '';
        if (h.indexOf(' ') >= 0)
            return 'Kullan\u0131c\u0131 ad\u0131nda bo\u015fluk olamaz. Ad soyad de\u011fil, '
                 + 'profilindeki \u0040 ile ba\u015flayan kullan\u0131c\u0131 ad\u0131n\u0131 yaz.';
        if (h.indexOf(AT) >= 0 || h.indexOf('/') >= 0 || h.indexOf(':') >= 0)
            return 'Buraya sadece kullan\u0131c\u0131 ad\u0131n\u0131 yaz \u2014 e-posta ya da '
                 + 'profil ba\u011flant\u0131s\u0131 de\u011fil.';
        if (h.length < r.min)
            return r.name + ' kullan\u0131c\u0131 ad\u0131 en az ' + r.min + ' karakter olmal\u0131.';
        if (h.length > r.max)
            return r.name + ' kullan\u0131c\u0131 ad\u0131 en fazla ' + r.max + ' karakter olabilir.';
        if (!r.re.test(h))
            return 'Kullan\u0131c\u0131 ad\u0131nda yaln\u0131zca \u0130ngilizce harf, rakam, '
                 + r.extras + ' kullan\u0131labilir (\u00e7, \u011f, \u0131, \u00f6, \u015f, '
                 + '\u00fc gibi T\u00fcrk\u00e7e harfler olmaz).';
        if (r.edge.indexOf(h.charAt(0)) >= 0 || r.edge.indexOf(h.charAt(h.length - 1)) >= 0)
            return r.name + ' kullan\u0131c\u0131 ad\u0131 ' + r.edgeMsg
                 + ' ile ba\u015flayamaz/bitemez.';
        if (r.name === 'Instagram' && h.indexOf('..') >= 0)
            return 'Instagram kullan\u0131c\u0131 ad\u0131nda art arda iki nokta olamaz.';
        return '';
    }

    function showError(el, msg) {
        var box = el.closest('.field').querySelector('.err');
        if (box) box.textContent = msg;
        return msg === '';
    }

    document.querySelectorAll('.uname').forEach(function (el) {
        el.addEventListener('blur', function () {
            var p = applyParse(el);
            if (p.kind === 'error') { showError(el, p.error); return; }
            if (p.kind === 'channelId') { showError(el, ''); return; } // handle kuralı geçerli değil
            showError(el, handleError(el, el.value));
        });
        el.addEventListener('input', function () { showError(el, ''); });
    });

    // (b) YouTube kimliği — kanal kartı + zorunlu onay.
    // channelId ARTIK POSTALANMIYOR: sunucu handle'ı kendisi çözüyor. Buradaki
    // doğrulama yalnız müşteriye "hangi kanala bağlanıyorsun" diye göstermek için.
    var yt = document.getElementById('ytUser');
    var ytStatus = document.getElementById('ytStatus');
    var ytConfirmWrap = document.getElementById('ytConfirmWrap');
    var ytConfirm = document.getElementById('ytConfirm');
    // lastResult: lastChecked'e ait son SONUÇ ({state, html, confirm}). Uçuştaki
    // istek varken null. Aynı handle'a geri dönüldüğünde ekranı yeniden kurmak için.
    var ytTimer = null, lastChecked = null, lastResult = null;
    // '' | 'checking' | 'ok' | 'missing' | 'unavailable' | 'urlid' | 'parse-error'
    var ytState = '';

    function setStatus(html) { ytStatus.innerHTML = html; }
    function esc(s) { return (s || '').replace(/[&<>"]/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

    var ytConfirmErr = document.getElementById('ytConfirmErr');

    function showConfirm(on) {
        if (!ytConfirmWrap) return;
        ytConfirmWrap.hidden = !on;
        if (!on) {
            if (ytConfirm) ytConfirm.checked = false;
            // Sunucudan gelen "onayla" hatası kutu gizlenince ekranda kalmasın.
            if (ytConfirmErr) ytConfirmErr.textContent = '';
        }
    }

    // keepConfirm: sayfa ilk yüklenirken true. O anda handle DEĞİŞMEMİŞTİR —
    // sunucunun az önce doğruladığı değerin ta kendisidir. Sıfırlamak, kayıt
    // formunda ilgisiz bir alandan (TC, telefon…) hata alan müşterinin YouTube
    // onayını sessizce kaldırır ve ikinci kez engellenmesine yol açardı.
    function verifyYouTube(keepConfirm) {
        if (!yt) return;
        var p = applyParse(yt);

        if (p.kind === 'error') {
            ytState = 'parse-error'; lastChecked = null; lastResult = null;
            setStatus(''); showConfirm(false); showError(yt, p.error);
            return;
        }
        if (p.kind === 'channelId') {
            // Kanal adresi kimliğin kendisi — varlık sorgusu ve onay gereksiz.
            ytState = 'urlid'; lastChecked = null; lastResult = null;
            setStatus('<span class="yt-ok">\u2713 Kanal adresi al\u0131nd\u0131</span>');
            showConfirm(false); showError(yt, '');
            return;
        }

        var h = yt.value;
        if (h.length === 0) {
            ytState = ''; lastChecked = null; lastResult = null;
            setStatus(''); showConfirm(false); return;
        }
        if (h === lastChecked && lastResult) {
            // Aynı handle'a geri dönüldü (a → ab → a). Ağa gitmeye gerek yok ama
            // öylece dönemeyiz: 'input' işleyicisi bu arada durumu 'checking'e
            // çekip onay kutusunu gizledi. Kalırsa durum kalıcı 'checking' olur,
            // istemci kapısı geçirir, sunucu "kanalı onayla" der ve müşteriye
            // onaylayacak kutu gösterilmez — çıkmaz. Son sonucu geri kur.
            ytState = lastResult.state;
            setStatus(lastResult.html);
            showConfirm(lastResult.confirm);
            return;
        }
        // Sonuç yoksa (istek uçuşta ya da bayat diye düşürüldü) yeniden sor.
        // Aynı handle'a ikinci istek atmak bedava sayılır: sunucu çözümü bir saat
        // önbellekte, yani kota harcanmıyor. Buradan sessizce dönmek ise durumu
        // kalıcı 'checking'te ve ekranı sonsuz spinner'da bırakırdı.

        if (!keepConfirm) showConfirm(false);   // handle değişti → önceki onay geçersiz
        lastChecked = h;
        lastResult = null;
        ytState = 'checking';
        setStatus('<span class="spinner"></span><span class="yt-checking">kontrol ediliyor\u2026</span>');
        fetch('/api/public/verify/youtube?handle=' + encodeURIComponent(h))
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (stale()) return;
                if (!d || d.available === false) {
                    // Bizim kota/ağ arızamız müşteriyi engellemesin.
                    apply('unavailable', '', false); return;
                }
                if (d.exists) {
                    var img = d.thumbnail ? '<img src="' + esc(d.thumbnail) + '" alt="">' : '';
                    apply('ok', img + '<span class="yt-ok">\u2713 ' + esc(d.title || 'Kanal bulundu') + '</span>', true);
                } else {
                    apply('missing',
                        '<span class="yt-warn">\u26a0 Bu kullan\u0131c\u0131 ad\u0131na ait kanal bulunamad\u0131</span>',
                        false);
                }
            })
            .catch(function () { if (!stale()) apply('unavailable', '', false); });

        // Bu yanıtın hâlâ geçerli olup olmadığı. İKİ koşul da şart:
        //
        //   yt.value !== h  → müşteri arada başka bir şey yazdı, ekranı ezmeyelim.
        //   h !== lastChecked → daha yeni bir doğrulama bunu geçersiz kıldı.
        //
        // İkincisi olmadan şu sessiz felaket mümkün: "a" sorgusu uçarken müşteri
        // "ab" yazıyor (lastChecked='ab'), sonra "a"ya dönüyor; "a"nın yanıtı
        // gelince yt.value uyuştuğu için geçiyor ve lastResult'a YAZILIYOR —
        // oysa lastResult 'ab'ye ait sayılıyor. Müşteri tekrar "ab" yazınca
        // önbellekten "a"nın kanal kartı açılıyor: gördüğü ad "a"nın, sunucunun
        // çözdüğü handle "ab". Yabancının kanalını onaylatmak tam olarak bu
        // özelliğin engellemek için var olduğu şey.
        function stale() { return yt.value !== h || h !== lastChecked; }

        // Sonucu hem ekrana yazar hem önbelleğe alır; ikisi ayrışamasın diye tek yerde.
        function apply(state, html, withConfirm) {
            ytState = state;
            setStatus(html);
            showConfirm(withConfirm);
            lastResult = { state: state, html: html, confirm: withConfirm };
        }
    }

    if (yt) {
        // setTimeout işleyiciye argüman geçirmiyor; keepConfirm'i yine de açıkça
        // yazıyoruz — burada onayın sıfırlanması İSTENEN davranış.
        yt.addEventListener('blur', function () {
            clearTimeout(ytTimer);
            ytTimer = setTimeout(function () { verifyYouTube(false); }, 200);
        });
        yt.addEventListener('input', function () {
            showConfirm(false);                          // yazarken eski onay geçersiz
            // Durum da geçersiz: aksi hâlde 700 ms dolmadan gönderilirse kapı
            // bayat 'ok' görüp "kanalı onayla" der, ama onay kutusu az önce
            // gizlendiği için müşteriye onaylayacak bir şey gösterilmez.
            // 'checking' kapıyı geçirir; asıl kararı sunucu zaten veriyor.
            ytState = 'checking';
            clearTimeout(ytTimer);
            ytTimer = setTimeout(function () { verifyYouTube(false); }, 700);
        });
        // Sunucu hatasıyla dönen sayfada alan dolu gelir; durum makinesini yeniden
        // kur (sunucu kartı zaten çizdi). İşaretli onay korunur — bkz. keepConfirm.
        if (yt.value) verifyYouTube(true);
    }

    // (c) E-posta — sunucudaki EmailValidator ile ayni kural.
    // Yalniz bicim yetmiyor: gercek veride asil hata "gmail.con" / "gml.com"
    // gibi alan adi yanlislari ve bunlar her regex'ten geciyor.
    var EMAIL_RE = new RegExp('^[A-Za-z0-9._%+\\-]+' + AT +
        '[A-Za-z0-9]([A-Za-z0-9\\-]*[A-Za-z0-9])?' +
        '(\\.[A-Za-z0-9]([A-Za-z0-9\\-]*[A-Za-z0-9])?)*\\.[A-Za-z]{2,}$');
    var TR_CHARS = /[\u00e7\u011f\u0131\u00f6\u015f\u00fc\u00c7\u011e\u0130\u00d6\u015e\u00dc]/;

    var POPULAR = ['gmail.com', 'googlemail.com', 'hotmail.com', 'outlook.com',
        'yahoo.com', 'icloud.com', 'yandex.com', 'windowslive.com',
        'hotmail.com.tr', 'yahoo.com.tr', 'outlook.com.tr', 'yandex.com.tr'];

    var KNOWN_GOOD = ['gmail.com', 'googlemail.com', 'hotmail.com', 'hotmail.com.tr',
        'hotmail.co.uk', 'hotmail.de', 'hotmail.fr', 'outlook.com', 'outlook.com.tr',
        'live.com', 'msn.com', 'windowslive.com', 'yahoo.com', 'yahoo.com.tr',
        'yahoo.co.uk', 'yahoo.de', 'yahoo.fr', 'ymail.com', 'rocketmail.com',
        'icloud.com', 'me.com', 'mac.com', 'yandex.com', 'yandex.com.tr',
        'yandex.ru', 'mail.ru', 'mail.com', 'email.com', 'ttmail.com', 'mynet.com',
        'superonline.com', 'turk.net', 'protonmail.com', 'proton.me', 'aol.com',
        'gmx.com', 'gmx.de', 'gmx.net', 'web.de'];

    function distance(a, b) {
        var prev = [], cur = [], i, j;
        for (j = 0; j <= b.length; j++) prev[j] = j;
        for (i = 1; i <= a.length; i++) {
            cur[0] = i;
            for (j = 1; j <= b.length; j++) {
                var cost = a.charAt(i - 1) === b.charAt(j - 1) ? 0 : 1;
                cur[j] = Math.min(cur[j - 1] + 1, prev[j] + 1, prev[j - 1] + cost);
            }
            var t = prev; prev = cur; cur = t;
        }
        return prev[b.length];
    }

    function suggestDomain(d) {
        if (KNOWN_GOOD.indexOf(d) >= 0 || d.length < 5) return null;
        for (var i = 0; i < POPULAR.length; i++) {
            var k = POPULAR[i];
            if (Math.abs(k.length - d.length) > 2) continue;
            if (distance(d, k) <= 2) return k;
        }
        return null;
    }

    function normalizeEmail(v) {
        v = (v || '').trim();
        var at = v.lastIndexOf(AT);
        return at < 0 ? v : v.slice(0, at + 1) + v.slice(at + 1).toLowerCase();
    }

    function emailError(v) {
        if (v.length === 0) return 'E-posta gerekli.';
        if (TR_CHARS.test(v))
            return 'E-posta adresinde T\u00fcrk\u00e7e karakter (\u00e7, \u011f, \u0131, '
                 + '\u00f6, \u015f, \u00fc) olamaz.';
        if (v.indexOf(' ') >= 0) return 'E-posta adresinde bo\u015fluk olamaz.';
        if (!EMAIL_RE.test(v))
            return 'Ge\u00e7erli bir e-posta adresi girin (\u00f6rnek: adiniz' + AT + 'gmail.com).';
        var d = v.slice(v.lastIndexOf(AT) + 1);
        var s = suggestDomain(d);
        return s ? 'E-posta adresindeki "' + d + '" hatal\u0131 g\u00f6r\u00fcn\u00fcyor. "'
                 + s + '" mi olacakt\u0131?' : '';
    }

    var email = document.getElementById('Input_Email');
    if (email) {
        email.addEventListener('blur', function () {
            email.value = normalizeEmail(email.value);
            if (email.value.length > 0) showError(email, emailError(email.value));
        });
        email.addEventListener('input', function () { showError(email, ''); });
    }

    // (d) TCKN — opsiyonel, ama girildiyse resmi kontrol basamagi tutmali.
    // ^\d{11}$ yetmiyor: gercek veride 162 numaranin 9'u bu kaliptan geciyor
    // ama gecersiz. Hatali numara e-Faturayi entegratorde reddettirir.
    function tcknError(v) {
        if (v.length === 0) return '';
        if (!/^[0-9]{11}$/.test(v)) return 'TC Kimlik No 11 rakamdan olu\u015fmal\u0131.';
        if (v.charAt(0) === '0') return 'TC Kimlik No 0 ile ba\u015flayamaz.';
        var d = [], i;
        for (i = 0; i < 11; i++) d[i] = v.charCodeAt(i) - 48;
        var odd = d[0] + d[2] + d[4] + d[6] + d[8];
        var even = d[1] + d[3] + d[5] + d[7];
        var bad = 'TC Kimlik No ge\u00e7ersiz. Kimli\u011findeki numaray\u0131 kontrol et.';
        if (d[9] !== ((odd * 7 - even) % 10 + 10) % 10) return bad;
        var sum = 0;
        for (i = 0; i < 10; i++) sum += d[i];
        return d[10] === sum % 10 ? '' : bad;
    }

    var tckn = document.getElementById('Input_Tckn');
    if (tckn) {
        tckn.addEventListener('blur', function () {
            tckn.value = (tckn.value || '').trim();
            showError(tckn, tcknError(tckn.value));
        });
        tckn.addEventListener('input', function () { showError(tckn, ''); });
    }

    // (e) Il/ilce bagimli liste. Ilce select'i sunucudan TUM ilcelerle
    // optgroup'lanmis geliyor; burada onu il -> ilce haritasina cevirip
    // secilen ile gore daraltiyoruz. JS kapaliysa liste uzun kalir ama
    // form calismaya devam eder (sunucu ikilinin tutarliligini dogruluyor).
    var citySel = document.getElementById('citySel');
    var districtSel = document.getElementById('districtSel');
    var ILCE = {};
    Array.prototype.forEach.call(districtSel.querySelectorAll('optgroup'), function (g) {
        ILCE[g.label] = Array.prototype.map.call(g.querySelectorAll('option'), function (o) {
            return o.value;
        });
    });

    function fillDistricts(city, keep) {
        var list = ILCE[city] || [];
        districtSel.innerHTML = '';
        var ph = document.createElement('option');
        ph.value = '';
        ph.textContent = list.length ? 'Se\u00e7in' : '\u00d6nce il se\u00e7in';
        districtSel.appendChild(ph);
        list.forEach(function (d) {
            var o = document.createElement('option');
            o.value = d;
            o.textContent = d;
            if (d === keep) o.selected = true;
            districtSel.appendChild(o);
        });
        districtSel.disabled = list.length === 0;
    }

    // Ilk yuklemede: sunucu dogrulamasi formu geri dondurduyse secimler korunur.
    fillDistricts(citySel.value, districtSel.value);
    citySel.addEventListener('change', function () {
        fillDistricts(citySel.value, '');
        showError(citySel, '');
        showError(districtSel, '');
    });
    districtSel.addEventListener('change', function () { showError(districtSel, ''); });

    // En az bir platform kullanıcı adı zorunlu (client-side ön kontrol).
    var form = document.getElementById('intakeForm');
    var unameErr = document.getElementById('unameErr');
    var formErr = document.getElementById('formErr');

    // Ozet uyarida gosterilecek alan adi — etiketten okunur ("Ad Soyad *" → "Ad Soyad").
    function labelOf(el) {
        var lbl = el.closest('.field').querySelector('.lbl');
        return lbl ? lbl.textContent.replace(/[*]/g, '').trim() : 'Alan';
    }

    form.addEventListener('submit', function (e) {
        var fields = Array.prototype.slice.call(document.querySelectorAll('.uname'));
        var anyUser = false, firstBad = null, bad = [];
        fields.forEach(function (el) {
            var p = applyParse(el);
            if (el.value.length > 0) anyUser = true;
            var msg = p.kind === 'error' ? p.error
                    : p.kind === 'channelId' ? ''
                    : handleError(el, el.value);
            showError(el, msg);
            if (msg) { bad.push(labelOf(el)); if (!firstBad) firstBad = el; }
        });

        // E-posta hatali olan kayitla iletisim kurulamaz → gonderimi durdur.
        if (email) {
            email.value = normalizeEmail(email.value);
            var eMsg = emailError(email.value);
            showError(email, eMsg);
            if (eMsg) { bad.push(labelOf(email)); if (!firstBad) firstBad = email; }
        }

        // Il/ilce faturada ayri kolon → ikisi de secilmeli.
        if (!citySel.value) {
            showError(citySel, '\u0130l se\u00e7in.');
            bad.push(labelOf(citySel));
            if (!firstBad) firstBad = citySel;
        } else if (!districtSel.value) {
            showError(districtSel, '\u0130l\u00e7e se\u00e7in.');
            bad.push(labelOf(districtSel));
            if (!firstBad) firstBad = districtSel;
        }

        // TCKN bos birakilabilir; doluysa gecerli olmali.
        if (tckn) {
            tckn.value = (tckn.value || '').trim();
            var tMsg = tcknError(tckn.value);
            showError(tckn, tMsg);
            if (tMsg) { bad.push('TC Kimlik No'); if (!firstBad) firstBad = tckn; }
        }

        if (!anyUser) {
            e.preventDefault();
            unameErr.textContent = 'En az bir platform kullanıcı adı gir (Instagram, YouTube, Facebook veya TikTok).';
            formErr.textContent = 'Formu tamamlayamadık: en az bir platform kullanıcı adı gerekli.';
            document.querySelector('.uname').focus();
            return;
        }
        unameErr.textContent = '';

        // YouTube kimlik kapısı. Sunucu aynı kararı veriyor (IntakeForm.cshtml.cs);
        // buradaki amaç müşteriyi sunucuya gidip dönmeden uyarmak.
        if (yt && yt.value && ytState !== 'urlid' && ytState !== 'unavailable') {
            if (ytState === 'missing') {
                e.preventDefault();
                showError(yt, 'Bu kullan\u0131c\u0131 ad\u0131na ait bir YouTube kanal\u0131 '
                            + 'bulunamad\u0131. Kanal sayfan\u0131 a\u00e7, adres \u00e7ubu\u011fundaki '
                            + AT + ' ile ba\u015flayan adresi yap\u0131\u015ft\u0131r.');
                formErr.textContent = 'YouTube kullan\u0131c\u0131 ad\u0131n\u0131 d\u00fczelt.';
                yt.focus();
                return;
            }
            if (ytState === 'ok' && ytConfirm && !ytConfirm.checked) {
                e.preventDefault();
                formErr.textContent = 'YouTube kanal\u0131n\u0131n sana ait oldu\u011funu onayla.';
                ytConfirm.focus();
                return;
            }
        }

        // Kurala uymayan kayıt sohbetle eşleşemez → gönderimi durdur.
        if (firstBad) {
            e.preventDefault();
            formErr.textContent = 'Şu alanlar hatalı: ' + bad.join(', ')
                                + '. Düzeltip tekrar dene.';
            firstBad.focus();
            return;
        }
        formErr.textContent = '';
    });
})();
</script>
</body>
</html>
