{
  "schemaVersion": 1,
  "publishedAt": "2026-06-22T10:00:00+00:00",
  "platforms": {
    "tiktok": {
      "isLivePage": {
        "urlPatterns": ["/live"],
        "domSelectors": [
          "[data-e2e=\"chat-list\"]",
          "[class*=\"ChatList\"]"
        ]
      },
      "comments": {
        "primaryContainers": "[data-e2e=\"chat-message\"]",
        "primaryRowItems": "[data-e2e=\"message-owner-name\"]",
        "fallbackPattern": "data-e2e",
        "secondaryContainers": [
          "[class*=\"DivCommentItemContainer\"]",
          "[class*=\"comment-item\"]",
          "[class*=\"ChatMessage\"]"
        ],
        "messageItem": "[class~=\"break-words\"][class~=\"align-middle\"]"
      },
      "observerTarget": [
        "[data-e2e=\"chat-list\"]",
        "[class*=\"ChatList\"]",
        "[role=\"main\"]"
      ],
      "validators": {
        "usernameMaxLength": 50,
        "messageMaxLength": 1000,
        "uiTextBlocklist": [
          "live", "follow", "share", "gift", "like", "comment", "send",
          "rose", "viewers", "watching", "joined", "top", "gifts", "chat", "settings"
        ],
        "timeStringRegex": null
      },
      "viewers": {
        "selectors": [
          "[data-e2e=\"live-room-stats\"]",
          "[data-e2e=\"live-viewer-count\"]",
          "[class*=\"ViewerCount\"]"
        ]
      }
    }
  }
}
