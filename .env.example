# Yerel geliştirme (kök docker-compose.yml) için gereken değerler.
# Kullanım:  cp .env.example .env   ve kendi DEV değerlerini gir.
# Gerçek .env commit'lenmez (.gitignore). Prod bu dosyayı KULLANMAZ —
# prod deploy/docker-compose.yml + VPS'teki /opt/orderdeck/.env kullanır.

# SQL Server SA parolası (SQL karmaşıklık kuralı: büyük/küçük/rakam/sembol, 8+).
# Değeri BOŞ bırakıldı; kendi dev parolanı gir (commit'lenmez).
MSSQL_SA_PASSWORD=

# JWT imza anahtarı — en az 32 karakter. Değeri BOŞ bırakıldı; kendi dev
# anahtarını gir (commit'lenmez).
JWT_SECRET=
