# ─────────────────────────────────────────────────────────────────────────────
# CANLI DOSYA BU. 2026-08-23'ten beri `license-server-deploy.yml` her deploy'da
# bu dosyayı VPS'e kopyalıyor, `caddy validate` ile doğruluyor ve reload ediyor.
# `/opt/orderdeck/Caddyfile` üzerinde yapılan elle düzenlemeler bir sonraki
# deploy'da SİLİNİR — değişiklik buraya, PR ile gelmeli.
#
# Öncesinde kopyalayan hiçbir şey yoktu: canlı dosya elle düzenleniyordu
# (VPS'teki `Caddyfile.bak-*` yığını bunun kalıntısı) ve repo'daki sürümün
# doğru kalması yalnızca dikkate bağlıydı. `deploy/docker-compose.yml` aynı
# kurulumda sessizce şablona dönüşmüştü (PR #318).
# ─────────────────────────────────────────────────────────────────────────────

{
    # Force Let's Encrypt production (avoid staging fallback after early DNS failures)
    acme_ca https://acme-v02.api.letsencrypt.org/directory
}

(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

# ─── CSP ve Permissions-Policy hakkında (denetim O-15) ───────────────────────
# Bu iki başlık BİLEREK snippet'e konmadı: dört yüzeyin dördü de farklı şey
# yüklüyor (jsdelivr, Meta SDK, R2 presigned URL, YouTube avatarı) ve ortak bir
# politika ya hepsini kıracak kadar dar ya da hiçbir şeyi engellemeyecek kadar
# geniş olurdu. Her site kendi satırını taşıyor; hangi kaynağın neden orada
# olduğu ilgili site bloğunun yorumunda yazılı.
#
# `upgrade-insecure-requests` HİÇBİR yerde yok, kasıtlı: sayfalarda karışık
# içerik zaten yok (her şey görece yol ya da https), buna karşılık aşağıdaki
# `orderdeckapp.com/facebook/callback` yönlendirmesinin hedefi
# `http://localhost:4849` — masaüstündeki OAuth dinleyicisi. Hiçbir şey
# kazandırmayan bir direktif için o adresin https'e yükseltilme ihtimalini
# göze almanın anlamı yok.
#
# `script-src` statik sitelerde ve Razor'da `'unsafe-inline'` içeriyor; tercih
# değil, ölçüm sonucu:
#   • Next statik export'ta hydration yükü satır içi <script> olarak basılıyor
#     (canlı HTML'de orderdeckapp.com'da 3, emarglobal.com'da 7 blok). Sunucu
#     yok → nonce üretilemez; hash'ler her build'de değişir.
#   • Razor'da IntakeForm'un kendi satır içi <script>'i var, ayrıca
#     Admin/Customers/Backups ve Admin/Shoppers/DeletionRequests sayfalarında
#     `onsubmit=` işleyicileri var. Satır içi olay işleyicisini ne nonce ne
#     hash açar — yalnızca `'unsafe-inline'`.
# Yani bu iki yüzeyde CSP satır içi XSS'i DURDURMAZ. Durdurdukları: dışarıdan
# script yükleme, `<object>`/`<embed>`, `<base>` enjeksiyonu, form hedefinin
# kaçırılması, çerçeveleme ve `connect-src` dışına sızdırma. Satır içi
# korumasını da kazanmak bu işleyicileri `addEventListener`'a taşımayı
# gerektirir — ayrı bir iş, buranın konusu değil.
#
# Panel tek istisna: Vite bundle'ında sıfır satır içi script var (canlı
# index.html'de sayıldı) ve 538 KB'lık üretim bundle'ında `eval`,
# `new Function` ya da `new Worker` geçmiyor. Orada `script-src` gerçekten
# sıkı — `'unsafe-inline'` yok.

license.orderdeckapp.com {
    import security_headers
    encode gzip

    # Razor yüzeyi. jsdelivr = Bootstrap 5.3.3 (CSS her sayfada, JS bundle'ı
    # yalnız _AdminLayout'ta). yt3.* = YouTube kanal avatarı; IntakeForm
    # `/api/public/verify/youtube` cevabındaki `thumbnail`ı <img> olarak
    # basıyor ve o URL `yt3.ggpht.com`'dan geliyor (canlı API'de doğrulandı).
    # `yt3.googleusercontent.com` de listede çünkü Google aynı avatarı zaman
    # zaman o alan adından servis ediyor; ikisi de yalnız görsel.
    # `connect-src 'self'` yeterli: bu sitede dışarıya giden tek fetch yok,
    # YouTube çağrısını sunucu yapıyor. Hangfire panosu (loopback'e kapalı)
    # kendi satır içi script/style'ını kullanıyor, o da 'self'+'unsafe-inline'
    # ile kapsanıyor.
    #
    # `form-action 'self'` — buraya WhatsApp adresi EKLEME.
    #
    # Kayıt formu 2026-08-23 ve 08-24'te iki kez canlı yayında sessizce öldü:
    # POST'tan sonra `wa.me`'ye 302 dönüyordu, Chrome/Safari ise `form-action`'ı
    # yönlendirme zincirinin HER adımına uyguluyor (Firefox uygulamıyor).
    # Kayıt DB'ye yazılıyor ama tarayıcı WhatsApp'a geçemiyordu, ekranda hiçbir
    # şey olmuyordu. Önce `wa.me` eklendi (#335) — yetmedi, çünkü zincir
    # `wa.me` → 302 → `api.whatsapp.com` şeklindeymiş; ikincisi de eklendi
    # (#336). O liste Meta'nın zincirine bağımlıydı: bir hop daha eklenseydi
    # form üçüncü kez ölecekti.
    #
    # #337 ile 302 tamamen kalktı. Form artık kendi yoluna dönüyor, WhatsApp'a
    # geçiş onay sayfasındaki `location.href` ile yapılıyor ve JS
    # yönlendirmesi hiçbir CSP direktifinin kapsamında DEĞİL (bunu yapacak
    # `navigate-to` direktifi 2022'de spec'ten çıkarıldı, hiçbir tarayıcıda
    # yayınlanmadı). Dolayısıyla dış adreslerin burada işi kalmadı; zincir
    # değişse bile form etkilenmiyor.
    #
    # Adresleri geri eklemek yalnız korumayı gevşetir, hiçbir şeyi düzeltmez:
    # form artık dışarıya POST etmiyor. Kayıt formu bir daha bozulursa sebep
    # burası değildir.
    header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://yt3.ggpht.com https://yt3.googleusercontent.com; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
    header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), autoplay=()"

    # Block public access to internal observability endpoints (Phase 5e).
    # /metrics (Prometheus scrape) and the Hangfire dashboard should only be
    # reachable from a tunnelled SSH session or a private monitoring host.
    # Add monitoring CIDR(s) to the allowlist when standing up Grafana/Prometheus.
    @internal_paths path /metrics* /hangfire*
    @internal_blocked {
        path /metrics* /hangfire*
        not remote_ip 127.0.0.1/32 ::1/128
    }
    respond @internal_blocked "Not Found" 404 {
        close
    }

    reverse_proxy license-server:8080
}

# ─── Marketing site (orderdeckapp.com apex + www) ────────────────────────────
# Statik export Next.js build çıktısı /srv/web altına bind-mount edilmiş.
# `npm run build` → `web/out/` üretiyor → rsync ile VPS'teki /opt/orderdeck/web-out
# klasörüne kopyalanıyor → docker-compose volume olarak Caddy container'ına
# bağlanmış. Caddy file_server klasör hash'i değişince otomatik servis ediyor;
# restart gerekmiyor.
www.orderdeckapp.com {
    import security_headers
    redir https://orderdeckapp.com{uri} permanent
}

orderdeckapp.com {
    import security_headers
    encode gzip zstd

    # Brotli'i enable etmek için xcaddy build gerekiyor — şimdilik gzip+zstd yeterli.

    # Politika site geneli: statik Next çıktısı ile aşağıda proxy'lenen Razor
    # IntakeForm'un BİRLEŞİMİ. Ayrı `handle` blokları içine ayrı `header`
    # koymak yerine tek satır, çünkü aradaki tek fark img-src'deki YouTube
    # avatarı; onu statik sayfalara da açmanın maliyeti yok, iki ayrı başlığın
    # Caddy direktif sırasıyla nasıl birleştiğini kestirmeye çalışmanın ise var.
    #
    # jsdelivr BURADA YOK ve olmamalı: IntakeForm.cshtml `Layout = null`
    # kullanıyor, yani Bootstrap'ı çeken _Layout'a hiç uğramıyor — kendi
    # satır içi <style>'ı ve `data:` SVG'siyle geliyor.
    #
    # Fontlar `/_next/static/media/*.woff2`, yani 'self'.
    # `connect-src 'self'`: formun tek fetch'i `/api/public/verify/youtube`
    # ve o da aynı origin'den (aşağıdaki proxy sayesinde).
    #
    # `form-action 'self'` — buraya WhatsApp adresi EKLEME. Kayıt formu artık
    # dışarıya POST etmiyor: #337'den beri kendi yoluna dönüyor ve WhatsApp'a
    # geçiş onay sayfasındaki `location.href` ile yapılıyor. Gerekçenin tamamı
    # license.* bloğundaki nota yazılı.
    header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://yt3.ggpht.com https://yt3.googleusercontent.com; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
    header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), autoplay=()"

    # ─── Müşteri kayıt formu ───────────────────────────────────────────────
    # Form license-server'daki Razor sayfası (DB config + submission + YouTube
    # verify API gerektirir), ama müşteriye license.* yerine güvenilir ana domain
    # gösterilsin diye buradan proxy'lenir: orderdeckapp.com/musteri-kayit/{slug}.
    # Eski /r/{slug} linkleri (WPF <0.4.3 ya da önceden paylaşılmış) de proxy'lenir
    # ki ana domainde 404 vermesin (license-server legacy route ile handle eder).
    handle /r/* {
        reverse_proxy license-server:8080
    }
    handle /musteri-kayit/* {
        reverse_proxy license-server:8080
    }
    handle /api/public/verify/* {
        reverse_proxy license-server:8080
    }

    # ─── Facebook OAuth dönüş adresi ───────────────────────────────────────
    # Meta, Live mode'daki uygulamalara localhost redirect URI'si kaydettirmiyor
    # ("http://localhost redirects are automatically allowed while in development
    # mode only"). WPF'in OAuth dinleyicisi ise localhost:4849'da. Araya HTTPS bir
    # adres koyuyoruz: Meta buraya döner, Caddy `code` + `state`'i olduğu gibi
    # masaüstündeki dinleyiciye 302'ler. Hiçbir şey saklanmıyor — bu sitede `log`
    # direktifi yok, dolayısıyla `code` erişim log'una da düşmüyor.
    handle /facebook/callback {
        redir http://localhost:4849/facebook/callback?{query} 302
    }

    # ─── Statik marketing sitesi ───────────────────────────────────────────
    handle {
        # Statik dosyalara uzun cache; HTML sayfalara kısa (deploy sonrası anında güncellensin).
        @static path *.css *.js *.svg *.png *.jpg *.jpeg *.webp *.woff2 *.ico
        header @static Cache-Control "public, max-age=31536000, immutable"

        @html path *.html /
        header @html Cache-Control "public, max-age=300, must-revalidate"

        # Trailing slash davranışı: Next.js trailingSlash:true ile her route bir
        # klasör + index.html üretiyor; file_server bunu doğal olarak handle ediyor.
        root * /srv/web
        file_server {
            precompressed gzip
        }
    }

    # 404 fallback — yoksa default Caddy 404'ü çıksın, /404/ gibi rotaları kırma.
    handle_errors {
        @404 expression {http.error.status_code} == 404
        rewrite @404 /404.html
        file_server
    }
}

# ─── OrderDeck Panel (panel.orderdeckapp.com) ───────────────────────────────
# Ayrı repo (OrderDeck-Mobile) → Vite bundle → CI rsync ile
# /opt/orderdeck/panel-out → /srv/panel bind-mount.
#
# emarglobal.com'dan ayrılıyor: orası statik sayfa kümesi, burası bir SPA.
# Kullanıcı /katalog/urun/<guid> adresini yenilediğinde diskte o yolda dosya
# yok; sunucunun index.html'i 200 ile vermesi gerekiyor ki React Router rotayı
# çözebilsin.
panel.orderdeckapp.com {
    import security_headers
    encode gzip zstd

    # Tek sıkı `script-src` burada: panelin index.html'i satır içi script
    # içermiyor, dolayısıyla `'unsafe-inline'` olmadan yaşayabiliyor.
    #
    # connect.facebook.net = Meta JS SDK, `WhatsAppBaglaScreen` açıldığında
    # talep üzerine indiriliyor (`facebookSdk.ts`, index.html'e gömülü değil).
    # `*.facebook.com` hem frame-src hem connect-src'te: Embedded Signup'ın
    # kendisi POPUP olarak açılıyor (popup'a bizim CSP'miz uygulanmaz), ama
    # SDK kendi gizli `xd_arbiter` iframe'ini kuruyor ve `autoLogAppEvents`
    # ile olay gönderiyor. Alt alan adı sabit olmadığı için (www / web /
    # staticxx / graph) joker; `*.fbcdn.net` de aynı sebeple emniyet payı.
    #
    # R2: ürün/duyuru görselleri ve videoları presigned URL ile DOĞRUDAN
    # R2'den okunuyor, yükleme de `fetch(uploadUrl, PUT)` ile doğrudan oraya
    # gidiyor — bu yüzden hem img/media-src'te hem connect-src'te.
    # Hesap kimliği alt alan adında olduğundan joker yazıldı: bu repo public,
    # kimliği buraya yazmanın gereği yok.
    # `blob:` = `URL.createObjectURL` ile üretilen yükleme önizlemesi,
    # `data:` = `@capacitor/camera`'nın DataUrl sonucu.
    #
    # license.orderdeckapp.com = API tabanı (`config.ts`).
    header Content-Security-Policy "default-src 'self'; script-src 'self' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.r2.cloudflarestorage.com https://*.fbcdn.net; media-src 'self' blob: https://*.r2.cloudflarestorage.com; font-src 'self' data:; connect-src 'self' https://license.orderdeckapp.com https://*.r2.cloudflarestorage.com https://*.facebook.com https://*.fbcdn.net; frame-src https://*.facebook.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"

    # `camera=(self)` — diğer üç yüzeyden farklı. Panel `@capacitor/camera`
    # kullanıyor (`YeniDuyuruScreen`, duyuruya fotoğraf ekleme); web'de bu
    # `getUserMedia`'ya düşüyor ve `camera=()` çekimi sessizce öldürürdü.
    header Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=(), autoplay=()"

    root * /srv/panel

    # Vite hash'li varlıkların hepsini /assets/ altına koyuyor. Burada eksik
    # bir dosya GERÇEKTEN 404 olmalı — index.html'e düşürülürse tarayıcı JS
    # beklerken HTML alır ve hata "Unexpected token '<'" diye görünür, asıl
    # sebebi (eksik/bozuk dosya) gizler.
    handle /assets/* {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server {
            precompressed gzip
        }
    }

    # SPA rotaları. `handle_errors` + `rewrite` kalıbı KULLANILMIYOR: gövdeyi
    # doğru verse de durum kodunu 404 bırakıyor, yani her derin bağlantı bozuk
    # sayfa gibi raporlanıyor. `try_files` index.html'i 200 ile döndürür.
    #
    # Cache-Control burada no-cache: index.html hash'li varlıklara işaret eden
    # tek dosya; cache'lenirse kullanıcı yeni sürüme hiç geçemez.
    handle {
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server {
            precompressed gzip
        }
    }
}

# ─── EMAR GLOBAL kurumsal sitesi (emarglobal.com apex + www) ─────────────────
# Ayrı repo (emar-web) → Next.js static export → rsync ile /opt/orderdeck/emar-out
# → /srv/emar bind-mount. orderdeckapp.com ile aynı kalıp, tek fark: burada
# license-server proxy'si yok, sadece statik dosya.
www.emarglobal.com {
    import security_headers
    redir https://emarglobal.com{uri} permanent
}

emarglobal.com {
    import security_headers
    encode gzip zstd

    # En dar politika, çünkü sitede dışarıdan yüklenen HİÇBİR kaynak yok:
    # canlı HTML'de tüm <img> `/img/...`, CSS'te @font-face yok, dışarıya
    # giden fetch yok. Görünen dış adresler (wa.me, maps, instagram, youtube)
    # sadece <a href> — CSP'nin ilgi alanı değil.
    header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
    header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), autoplay=()"

    @static path *.css *.js *.svg *.png *.jpg *.jpeg *.webp *.woff2 *.ico
    header @static Cache-Control "public, max-age=31536000, immutable"

    @html path *.html /
    header @html Cache-Control "public, max-age=300, must-revalidate"

    root * /srv/emar
    file_server {
        precompressed gzip
    }

    handle_errors {
        @404 expression {http.error.status_code} == 404
        rewrite @404 /404.html
        file_server
    }
}
