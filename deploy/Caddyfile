# ─────────────────────────────────────────────────────────────────────────────
# CANLI DOSYA BU. 2026-08-23'ten beri `license-server-deploy.yml` her deploy'da
# bu dosyayı VPS'e kopyalıyor, `caddy validate` ile doğruluyor ve reload ediyor.
# `/opt/orderdeck/Caddyfile` üzerinde yapılan elle düzenlemeler bir sonraki
# deploy'da SİLİNİR — değişiklik buraya, PR ile gelmeli.
#
# Öncesinde kopyalayan hiçbir şey yoktu: canlı dosya elle düzenleniyordu
# (VPS'teki `Caddyfile.bak-*` yığını bunun kalıntısı) ve repo'daki sürümün
# doğru kalması yalnızca dikkate bağlıydı. `deploy/docker-compose.yml` aynı
# kurulumda sessizce şablona dönüşmüştü (PR #318).
# ─────────────────────────────────────────────────────────────────────────────

{
    # Force Let's Encrypt production (avoid staging fallback after early DNS failures)
    acme_ca https://acme-v02.api.letsencrypt.org/directory
}

(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

license.orderdeckapp.com {
    import security_headers
    encode gzip

    # Block public access to internal observability endpoints (Phase 5e).
    # /metrics (Prometheus scrape) and the Hangfire dashboard should only be
    # reachable from a tunnelled SSH session or a private monitoring host.
    # Add monitoring CIDR(s) to the allowlist when standing up Grafana/Prometheus.
    @internal_paths path /metrics* /hangfire*
    @internal_blocked {
        path /metrics* /hangfire*
        not remote_ip 127.0.0.1/32 ::1/128
    }
    respond @internal_blocked "Not Found" 404 {
        close
    }

    reverse_proxy license-server:8080
}

# ─── Marketing site (orderdeckapp.com apex + www) ────────────────────────────
# Statik export Next.js build çıktısı /srv/web altına bind-mount edilmiş.
# `npm run build` → `web/out/` üretiyor → rsync ile VPS'teki /opt/orderdeck/web-out
# klasörüne kopyalanıyor → docker-compose volume olarak Caddy container'ına
# bağlanmış. Caddy file_server klasör hash'i değişince otomatik servis ediyor;
# restart gerekmiyor.
www.orderdeckapp.com {
    import security_headers
    redir https://orderdeckapp.com{uri} permanent
}

orderdeckapp.com {
    import security_headers
    encode gzip zstd

    # Brotli'i enable etmek için xcaddy build gerekiyor — şimdilik gzip+zstd yeterli.

    # ─── Müşteri kayıt formu ───────────────────────────────────────────────
    # Form license-server'daki Razor sayfası (DB config + submission + YouTube
    # verify API gerektirir), ama müşteriye license.* yerine güvenilir ana domain
    # gösterilsin diye buradan proxy'lenir: orderdeckapp.com/musteri-kayit/{slug}.
    # Eski /r/{slug} linkleri (WPF <0.4.3 ya da önceden paylaşılmış) de proxy'lenir
    # ki ana domainde 404 vermesin (license-server legacy route ile handle eder).
    handle /r/* {
        reverse_proxy license-server:8080
    }
    handle /musteri-kayit/* {
        reverse_proxy license-server:8080
    }
    handle /api/public/verify/* {
        reverse_proxy license-server:8080
    }

    # ─── Facebook OAuth dönüş adresi ───────────────────────────────────────
    # Meta, Live mode'daki uygulamalara localhost redirect URI'si kaydettirmiyor
    # ("http://localhost redirects are automatically allowed while in development
    # mode only"). WPF'in OAuth dinleyicisi ise localhost:4849'da. Araya HTTPS bir
    # adres koyuyoruz: Meta buraya döner, Caddy `code` + `state`'i olduğu gibi
    # masaüstündeki dinleyiciye 302'ler. Hiçbir şey saklanmıyor — bu sitede `log`
    # direktifi yok, dolayısıyla `code` erişim log'una da düşmüyor.
    handle /facebook/callback {
        redir http://localhost:4849/facebook/callback?{query} 302
    }

    # ─── Statik marketing sitesi ───────────────────────────────────────────
    handle {
        # Statik dosyalara uzun cache; HTML sayfalara kısa (deploy sonrası anında güncellensin).
        @static path *.css *.js *.svg *.png *.jpg *.jpeg *.webp *.woff2 *.ico
        header @static Cache-Control "public, max-age=31536000, immutable"

        @html path *.html /
        header @html Cache-Control "public, max-age=300, must-revalidate"

        # Trailing slash davranışı: Next.js trailingSlash:true ile her route bir
        # klasör + index.html üretiyor; file_server bunu doğal olarak handle ediyor.
        root * /srv/web
        file_server {
            precompressed gzip
        }
    }

    # 404 fallback — yoksa default Caddy 404'ü çıksın, /404/ gibi rotaları kırma.
    handle_errors {
        @404 expression {http.error.status_code} == 404
        rewrite @404 /404.html
        file_server
    }
}

# ─── OrderDeck Panel (panel.orderdeckapp.com) ───────────────────────────────
# Ayrı repo (OrderDeck-Mobile) → Vite bundle → CI rsync ile
# /opt/orderdeck/panel-out → /srv/panel bind-mount.
#
# emarglobal.com'dan ayrılıyor: orası statik sayfa kümesi, burası bir SPA.
# Kullanıcı /katalog/urun/<guid> adresini yenilediğinde diskte o yolda dosya
# yok; sunucunun index.html'i 200 ile vermesi gerekiyor ki React Router rotayı
# çözebilsin.
panel.orderdeckapp.com {
    import security_headers
    encode gzip zstd

    root * /srv/panel

    # Vite hash'li varlıkların hepsini /assets/ altına koyuyor. Burada eksik
    # bir dosya GERÇEKTEN 404 olmalı — index.html'e düşürülürse tarayıcı JS
    # beklerken HTML alır ve hata "Unexpected token '<'" diye görünür, asıl
    # sebebi (eksik/bozuk dosya) gizler.
    handle /assets/* {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server {
            precompressed gzip
        }
    }

    # SPA rotaları. `handle_errors` + `rewrite` kalıbı KULLANILMIYOR: gövdeyi
    # doğru verse de durum kodunu 404 bırakıyor, yani her derin bağlantı bozuk
    # sayfa gibi raporlanıyor. `try_files` index.html'i 200 ile döndürür.
    #
    # Cache-Control burada no-cache: index.html hash'li varlıklara işaret eden
    # tek dosya; cache'lenirse kullanıcı yeni sürüme hiç geçemez.
    handle {
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server {
            precompressed gzip
        }
    }
}

# ─── EMAR GLOBAL kurumsal sitesi (emarglobal.com apex + www) ─────────────────
# Ayrı repo (emar-web) → Next.js static export → rsync ile /opt/orderdeck/emar-out
# → /srv/emar bind-mount. orderdeckapp.com ile aynı kalıp, tek fark: burada
# license-server proxy'si yok, sadece statik dosya.
www.emarglobal.com {
    import security_headers
    redir https://emarglobal.com{uri} permanent
}

emarglobal.com {
    import security_headers
    encode gzip zstd

    @static path *.css *.js *.svg *.png *.jpg *.jpeg *.webp *.woff2 *.ico
    header @static Cache-Control "public, max-age=31536000, immutable"

    @html path *.html /
    header @html Cache-Control "public, max-age=300, must-revalidate"

    root * /srv/emar
    file_server {
        precompressed gzip
    }

    handle_errors {
        @404 expression {http.error.status_code} == 404
        rewrite @404 /404.html
        file_server
    }
}
