<Window x:Class="OrderDeck.App.Views.CustomerSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Müşteriler" Width="580" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#FF141414" Foreground="White">
    <Window.Resources>
        <!-- Sayaç kartı stili -->
        <Style x:Key="CountCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="118"/>
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Başlık + sayaç kartları ═══ -->
        <Border Grid.Row="0" Background="#FF1E1E1E" Padding="18,16"
                BorderBrush="#FF2A2A2A" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Müşteriler" FontSize="20" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                    <Border Style="{StaticResource CountCard}" Background="#FF262626">
                        <StackPanel>
                            <TextBlock Text="TOPLAM MÜŞTERİ" Style="{StaticResource CardLabel}" Foreground="#FF8A8A8A"/>
                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource CardValue}" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CountCard}" Background="#FF14301C">
                        <StackPanel>
                            <TextBlock Text="KAYITLI (TELEFONLU)" Style="{StaticResource CardLabel}" Foreground="#FF8FCF9F"/>
                            <TextBlock Text="{Binding RegisteredCount}" Style="{StaticResource CardValue}" Foreground="#FF79D279"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CountCard}" Background="#FF3A1414" Margin="0"
                            Visibility="{Binding HasNewThisSession, Converter={StaticResource BoolToVisibleConverter}}">
                        <StackPanel>
                            <TextBlock Text="BU YAYINDA YENİ" Style="{StaticResource CardLabel}" Foreground="#FFE39B9B"/>
                            <TextBlock Text="{Binding NewThisSessionCount}" Style="{StaticResource CardValue}" Foreground="#FFE85D5D"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ Arama + filtreler ═══ -->
        <StackPanel Grid.Row="1" Margin="18,14,18,8">
            <Grid>
                <TextBox x:Name="SearchBox"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8" FontSize="14"
                         Background="#FF222222" Foreground="White" BorderBrush="#FF333333"/>
                <TextBlock Text="🔍 İsim veya kullanıcı adı ara…" Foreground="#FF6B6B6B"
                           Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Query}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <WrapPanel Margin="0,10,0,0">
                <ComboBox ItemsSource="{Binding PlatformOptions}"
                          DisplayMemberPath="Display" SelectedValuePath="Value"
                          SelectedValue="{Binding PlatformFilter}"
                          MinWidth="150" Margin="0,0,12,0"
                          Background="#FF222222" Foreground="Black"/>
                <CheckBox Content="Sadece kayıtlı müşteriler"
                          IsChecked="{Binding RegisteredOnly}"
                          VerticalAlignment="Center" Margin="0,0,14,0"/>
                <CheckBox Content="Son yayından alışverişçiler"
                          IsChecked="{Binding LastStreamShoppersOnly}"
                          VerticalAlignment="Center"/>
            </WrapPanel>

            <TextBlock Margin="0,8,0,0" Foreground="#FF888888" FontSize="11">
                <Run Text="{Binding ResultCount, Mode=OneWay}"/>
                <Run Text="sonuç"/>
            </TextBlock>
        </StackPanel>

        <!-- ═══ Liste ═══ -->
        <Grid Grid.Row="2" Margin="10,0,10,0">
            <ListBox x:Name="ResultsList"
                     ItemsSource="{Binding Results}"
                     SelectionMode="Extended"
                     SelectionChanged="ResultsList_OnSelectionChanged"
                     MouseDoubleClick="ResultsList_OnDoubleClick"
                     Background="Transparent" Foreground="White" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="8,4"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="cardBorder" Background="#FF1F1F1F" CornerRadius="10"
                                            BorderBrush="#FF2C2C2C" BorderThickness="1" Padding="12,10">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="cardBorder" Property="Background" Value="#FF272727"/>
                                            <Setter TargetName="cardBorder" Property="BorderBrush" Value="#FF3D3D3D"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="cardBorder" Property="BorderBrush" Value="#FFE11900"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <!-- Satır 1: isim + kayıtlı rozeti + platform -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Display}" FontWeight="Bold" FontSize="14"
                                               Foreground="#FFFFD166" TextTrimming="CharacterEllipsis"/>
                                    <Border Background="#FF14301C" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding Phone, Converter={StaticResource NullToCollapsedConverter}}">
                                        <TextBlock Text="✓ Kayıtlı" Foreground="#FF79D279" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                    <!-- Platform rozetleri: grup ise birden çok -->
                                    <ItemsControl ItemsSource="{Binding Platforms}" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FF2A2A2A" CornerRadius="4" Padding="6,1" Margin="2,0,0,0">
                                                    <TextBlock Text="{Binding}" Foreground="#FFBFBFBF" FontSize="10"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Background="#FF1D2C3A" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibleConverter}}">
                                        <TextBlock Text="🔗 Birleşik" Foreground="#FF6FB4FF" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>

                                <!-- Satır 2: telefon + email (varsa) -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Foreground="#FFB0B0B0" FontSize="12" Margin="0,0,14,0"
                                               Visibility="{Binding Phone, Converter={StaticResource NullToCollapsedConverter}}">
                                        <Run Text="📱"/>
                                        <Run Text="{Binding Phone, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="#FF9A9A9A" FontSize="12"
                                               Visibility="{Binding Email, Converter={StaticResource NullToCollapsedConverter}}">
                                        <Run Text="✉"/>
                                        <Run Text="{Binding Email, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Satır 3: son görülme -->
                                <TextBlock Foreground="#FF666666" FontSize="10.5" Margin="0,3,0,0">
                                    <Run Text="Son görülme:"/>
                                    <Run Text="{Binding LastSeenAt, Converter={StaticResource UnixToDateConverter}, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="📱 Öde"
                                        ToolTip="WhatsApp'tan ödeme iste"
                                        Command="{Binding DataContext.OpenWhatsAppCommand,
                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="#FF25D366" Foreground="White"
                                        BorderThickness="0" Padding="10,6" Cursor="Hand"/>
                                <Button Content="🔗 Ayır"
                                        ToolTip="Bu birleşik müşteriyi tekil satırlara ayır"
                                        Command="{Binding DataContext.UnmergeGroupCommand,
                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="#FF2A2A2A" Foreground="#FFBFBFBF"
                                        BorderThickness="0" Padding="10,4" Margin="0,5,0,0" Cursor="Hand"
                                        Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibleConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Results.Count, Converter={StaticResource CountToCollapsedConverter}}">
                <TextBlock Text="🔍" FontSize="30" HorizontalAlignment="Center" Foreground="#FF555555"/>
                <TextBlock Text="Sonuç yok" HorizontalAlignment="Center"
                           Foreground="#FF666666" FontSize="14" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ═══ Alt ═══ -->
        <Border Grid.Row="3" Background="#FF1A1A1A" Padding="18,12"
                BorderBrush="#FF2A2A2A" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Foreground="#FF888888" FontSize="11"
                           Text="Aynı kişiyi birleştirmek için Ctrl ile 2+ kart seçin"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🔗 Seçilenleri Birleştir"
                            Command="{Binding MergeSelectedCommand}"
                            Background="#FF2F6FBF" Foreground="White"
                            BorderThickness="0" Padding="14,7" Margin="0,0,10,0" Cursor="Hand"/>
                    <Button Content="Kapat" Click="OnClose" Padding="18,7"
                            IsCancel="True" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
