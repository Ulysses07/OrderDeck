<Window x:Class="OrderDeck.App.Views.BulkSmsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toplu SMS" Height="640" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="White">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header + bakiye -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Toplu SMS" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <Border Grid.Column="1" Background="#1F2937" CornerRadius="6" Padding="10,5"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Kredi: " Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CreditsRemaining}" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- İYS bilgi şeridi -->
        <Border Grid.Row="1" Background="#3A2E12" BorderBrush="#A16207" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,10,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="#FCD34D" FontSize="12"
                       Text="Gerçek gönderim, Netgsm İYS onayına bağlıdır. Onay tamamlanana kadar kampanya oluşturulabilir fakat gönderimler başarısız olur ve krediler otomatik iade edilir."/>
        </Border>

        <!-- Mesaj -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Mesaj" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding MessageBody, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="90" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                     Background="#262626" Foreground="White" BorderBrush="#374151"
                     Padding="8" FontSize="13"/>
            <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Run Text="{Binding CharCount, Mode=OneWay}"/><Run Text=" / 2000 karakter"/>
            </TextBlock>
        </StackPanel>

        <!-- Aksiyonlar + önizleme -->
        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Önizleme özeti -->
            <StackPanel VerticalAlignment="Center"
                        Visibility="{Binding PreviewDone, Converter={StaticResource BoolToVis}}">
                <TextBlock>
                    <Run Text="{Binding RecipientCount, Mode=OneWay}"/><Run Text=" alıcı · "/>
                    <Run Text="{Binding Segments, Mode=OneWay}"/><Run Text=" segment · "/>
                    <Run Text="{Binding TotalCredits, Mode=OneWay}"/><Run Text=" kredi"/>
                </TextBlock>
            </StackPanel>

            <Button Grid.Column="1" Content="Önizle" Padding="14,6" Margin="0,0,8,0"
                    Background="#374151" Foreground="White" BorderThickness="0"
                    Command="{Binding PreviewCommand}"/>
            <Button Grid.Column="2" Content="Gönder" Padding="14,6"
                    Background="#22C55E" Foreground="White" BorderThickness="0"
                    Command="{Binding SendCommand}"/>
        </Grid>

        <!-- Durum / hata -->
        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                       TextWrapping="Wrap"
                       Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#F87171" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Geçmiş -->
        <DockPanel Grid.Row="5" Margin="0,14,0,0">
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Kampanya geçmişi" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Yenile" Padding="10,4"
                        Background="#374151" Foreground="White" BorderThickness="0"
                        Command="{Binding RefreshHistoryCommand}"/>
            </Grid>

            <TextBlock Text="Henüz kampanya yok." Style="{StaticResource MutedText}"
                       Margin="0,8,0,0" DockPanel.Dock="Top"
                       Visibility="{Binding IsHistoryEmpty, Converter={StaticResource BoolToVis}}"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding History}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#262626" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                    BorderBrush="#374151" BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding MessagePreview}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                   Style="{StaticResource MutedText}" Margin="8,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="{Binding CountsLabel}" Style="{StaticResource MutedText}"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding CreatedAtLabel}" Style="{StaticResource MutedText}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
