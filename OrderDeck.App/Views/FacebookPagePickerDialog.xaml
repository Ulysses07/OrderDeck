<!-- Arka plan/ön plan BURADA verilmek zorunda: DarkControls'taki
     `Style TargetType="{x:Type Window}"` bu pencereye UYGULANMAZ, çünkü WPF
     örtük stil aramasını nesnenin TAM tipiyle yapar. Verilmezse arka plan
     varsayılan BEYAZ kalır, metinler tema gereği açık renktir → okunmaz. -->
<Window x:Class="OrderDeck.App.Views.FacebookPagePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Facebook Page Seç"
        Background="{DynamicResource OD.Bg.Window}"
        Foreground="{DynamicResource OD.Fg.Primary}"
        Height="320" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Bu hesabın yönetebildiği birden fazla Facebook Page var. OrderDeck'in canlı yorumlarını çekeceği Page'i seç:"/>
        <ListBox x:Name="PagesList" Grid.Row="1"
                 DisplayMemberPath="Name"
                 SelectionMode="Single"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="İptal" Width="80" Margin="0,0,8,0" IsCancel="True" Click="OnCancel"/>
            <Button Content="Seç"   Width="80" IsDefault="True" Click="OnAccept"/>
        </StackPanel>
    </Grid>
</Window>
