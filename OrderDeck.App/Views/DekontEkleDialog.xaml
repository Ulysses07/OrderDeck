<Window x:Class="OrderDeck.App.Views.DekontEkleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:OrderDeck.App.Converters"
        Title="Yeni Dekont" Width="520" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource OD.Bg.Window}"
        Foreground="{StaticResource OD.Fg.Primary}">
    <Window.Resources>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsed"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: PDF dropzone -->
            <RowDefinition Height="Auto"/>  <!-- 1: Ödeyen -->
            <RowDefinition Height="Auto"/>  <!-- 2: Tutar -->
            <RowDefinition Height="Auto"/>  <!-- 3: Tarih -->
            <RowDefinition Height="Auto"/>  <!-- 4: Referans -->
            <RowDefinition Height="Auto"/>  <!-- 5: Müşteri kicker -->
            <RowDefinition Height="Auto"/>  <!-- 6: Platform -->
            <RowDefinition Height="Auto"/>  <!-- 7: Username -->
            <RowDefinition Height="Auto"/>  <!-- 8: Error -->
            <RowDefinition Height="*"/>     <!-- 9: IBAN warning / spacer -->
            <RowDefinition Height="Auto"/>  <!-- 10: Buttons -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PDF dropzone kartı: 2px dashed, accent-tonlu upload ikon kutusu.
             Tıklayınca OnPickPdf (eski buton ile aynı handler). -->
        <Button Grid.Row="0" Grid.ColumnSpan="2"
                Click="OnPickPdf"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,16"
                Background="Transparent" BorderThickness="0"
                Cursor="Hand"
                ToolTip="Banka dekontu PDF'inden ödeyen, tutar, tarih ve referans no'yu otomatik çıkarır. Yanlış çıkarsa elle düzeltebilirsin.">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Dz" CornerRadius="12"
                            Background="{StaticResource OD.Bg.Surface}"
                            BorderBrush="{StaticResource OD.Border.Hover}"
                            BorderThickness="2"
                            Padding="16">
                        <Border.Resources>
                            <Style TargetType="Border"/>
                        </Border.Resources>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="10"
                                    Background="#295B8DEF" VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                                <Viewbox Width="22" Height="22">
                                    <Path Width="24" Height="24"
                                          Stroke="{StaticResource OD.Accent}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M5,15 a4,4 0 0 1 1,-7.9 a5,5 0 0 1 9.6,-1.3 a4.5,4.5 0 0 1 1,8.9 M12,12 v7 M9,15 l3,-3 l3,3"/>
                                </Viewbox>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PDF Yükle"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource OD.Fg.Primary}"/>
                                <TextBlock Text="Ödeyen, tutar, tarih ve referans no otomatik doldurulur — 10+ banka formatı"
                                           FontSize="11.5"
                                           Foreground="{StaticResource OD.Fg.Secondary}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dz" Property="BorderBrush"
                                    Value="{StaticResource OD.Border.Focus}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ödeyen" Margin="0,8,8,8" VerticalAlignment="Center"
                   Foreground="{StaticResource OD.Fg.Secondary}"/>
        <TextBox   Grid.Row="1" Grid.Column="1"
                   Text="{Binding PayerName, UpdateSourceTrigger=PropertyChanged}"
                   Padding="6" Margin="0,4"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tutar (TL)" Margin="0,8,8,8" VerticalAlignment="Center"
                   Foreground="{StaticResource OD.Fg.Secondary}"/>
        <TextBox   Grid.Row="2" Grid.Column="1"
                   Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                   Padding="6" Margin="0,4"
                   ToolTip="Örn: 250,50 veya 250.50"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ödeme tarihi" Margin="0,8,8,8" VerticalAlignment="Center"
                   Foreground="{StaticResource OD.Fg.Secondary}"/>
        <DatePicker Grid.Row="3" Grid.Column="1"
                    SelectedDate="{Binding PaidAt}"
                    Margin="0,4"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Referans no" Margin="0,8,8,8" VerticalAlignment="Center"
                   Foreground="{StaticResource OD.Fg.Secondary}"/>
        <TextBox   Grid.Row="4" Grid.Column="1"
                   Text="{Binding ReferansNo, UpdateSourceTrigger=PropertyChanged}"
                   Padding="6" Margin="0,4"
                   ToolTip="Banka dekontundaki referans/işlem no"/>

        <TextBlock Grid.Row="5" Grid.ColumnSpan="2"
                   Text="MÜŞTERİ (OPSİYONEL — KARGO EŞLEŞTİRME İÇİN)"
                   FontSize="10.5" FontWeight="SemiBold"
                   Foreground="{StaticResource OD.Fg.Secondary}" Margin="0,18,0,6"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Platform" Margin="0,8,8,8" VerticalAlignment="Center"
                   Foreground="{StaticResource OD.Fg.Secondary}"/>
        <ComboBox  Grid.Row="6" Grid.Column="1"
                   SelectedValue="{Binding CustomerPlatform}"
                   SelectedValuePath="Content"
                   Margin="0,4"
                   ToolTip="Müşterinin yayın platformu — kargo eşleştirme için">
            <ComboBoxItem Content=""/>
            <ComboBoxItem Content="instagram"/>
            <ComboBoxItem Content="tiktok"/>
            <ComboBoxItem Content="facebook"/>
            <ComboBoxItem Content="youtube"/>
            <ComboBoxItem Content="form"/>
        </ComboBox>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Kullanıcı adı" Margin="0,8,8,8" VerticalAlignment="Center"
                   Foreground="{StaticResource OD.Fg.Secondary}"/>
        <TextBox   Grid.Row="7" Grid.Column="1"
                   Text="{Binding CustomerUsername, UpdateSourceTrigger=PropertyChanged}"
                   Padding="6" Margin="0,4"
                   ToolTip="Müşterinin platformdaki kullanıcı adı (örn: @ayse_y) — bulunursa otomatik eşleştirme yapılır"/>

        <TextBlock Grid.Row="8" Grid.ColumnSpan="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="#FFF87171"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"/>

        <!-- IBAN uyarısı: #E07B00 %40 kenarlık + warning %10 zemin. -->
        <Border Grid.Row="9" Grid.ColumnSpan="2"
                Background="#1AFBBF24" BorderBrush="#66E07B00" BorderThickness="1"
                CornerRadius="9" Padding="10,8" Margin="0,12,0,0"
                VerticalAlignment="Top"
                Visibility="{Binding IbanWarning, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding IbanWarning}"
                       Foreground="#FFFBD38D" TextWrapping="Wrap"
                       FontFamily="Consolas" FontSize="11.5"/>
        </Border>

        <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="İptal" Click="OnCancel" Padding="14,6" Margin="0,0,8,0" IsCancel="True"/>
            <Button Click="OnSave"
                    Padding="14,6"
                    IsEnabled="{Binding CanSave}"
                    IsDefault="True"
                    Background="{StaticResource OD.Accent}" Foreground="White">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="15" Height="15" Margin="0,0,7,0">
                        <Path Width="24" Height="24"
                              Stroke="White" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M4,11.5 L9.5,17 L20,6.5"/>
                    </Viewbox>
                    <TextBlock Text="Kaydet" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
