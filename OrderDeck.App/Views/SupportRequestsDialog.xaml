<Window x:Class="OrderDeck.App.Views.SupportRequestsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Destek Talepleri" Height="560" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="White">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Destek Talepleri" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ChkResolved" Content="Geçmiş dahil" Foreground="White"
                          VerticalAlignment="Center" Margin="0,0,12,0"
                          IsChecked="{Binding IncludeResolved, Mode=OneWay}"
                          Checked="OnIncludeResolvedChanged"
                          Unchecked="OnIncludeResolvedChanged"/>
                <Button Content="Yenile" Padding="10,4"
                        Command="{Binding RefreshCommand}"
                        Background="#374151" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>

        <!-- Status line -->
        <StackPanel Grid.Row="1" Margin="0,10,0,6">
            <TextBlock Text="Yükleniyor…" Style="{StaticResource MutedText}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="Bekleyen destek talebi yok." Style="{StaticResource MutedText}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#F87171"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#262626" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                BorderBrush="#374151" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ShopperName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ShopperPhone}" Style="{StaticResource MutedText}"/>
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0">
                                            <Run Text="{Binding CreatedAtLabel, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding KindLabel, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Geçici parola üret -->
                                    <Button Grid.Column="1" Content="Geçici parola üret"
                                            VerticalAlignment="Top" Padding="10,5"
                                            Background="#3B82F6" Foreground="White" BorderThickness="0"
                                            Visibility="{Binding CanIssue, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.IssueTempPasswordCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>

                                    <TextBlock Grid.Column="1" Text="Tamamlandı" Foreground="#79D279"
                                               VerticalAlignment="Top"
                                               Visibility="{Binding ShowResolvedLabel, Converter={StaticResource BoolToVis}}"/>
                                </Grid>

                                <!-- Üretilen geçici parola paneli -->
                                <Border Background="#1F2937" CornerRadius="6" Padding="10" Margin="0,10,0,0"
                                        Visibility="{Binding HasTempPassword, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="Geçici parola" Style="{StaticResource MutedText}"/>
                                        <TextBlock Text="{Binding TempPassword}" FontFamily="Consolas"
                                                   FontSize="18" FontWeight="Bold" Margin="0,2,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="WhatsApp ile gönder" Padding="10,5" Margin="0,0,8,0"
                                                    Background="#22C55E" Foreground="White" BorderThickness="0"
                                                    Command="{Binding DataContext.SendWhatsAppCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Kopyala" Padding="10,5"
                                                    Background="#374151" Foreground="White" BorderThickness="0"
                                                    Click="OnCopyPassword"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding RowError}" Foreground="#F87171"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Kapat" Padding="14,6" Click="OnClose" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
