<!-- Arka plan/ön plan BURADA verilmek zorunda: DarkControls'taki
     `Style TargetType="{x:Type Window}"` bu pencereye UYGULANMAZ, çünkü WPF
     örtük stil aramasını nesnenin TAM tipiyle yapar. Verilmezse arka plan
     varsayılan BEYAZ kalır, metinler tema gereği açık renktir → okunmaz. -->
<Window x:Class="OrderDeck.App.Views.PeriodReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dönem Raporu" Width="1000" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource OD.Bg.Window}"
        Foreground="{DynamicResource OD.Fg.Primary}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Dönem Raporu" FontSize="24" FontWeight="Bold"
                   Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Foreground="#FFAAAAAA" Margin="0,0,0,16"
                   TextWrapping="Wrap"
                   Text="Seçilen tarih aralığında basılmış (iptal edilmemiş) siparişler kişi bazında toplanır; aynı kişinin farklı platform hesapları birleştirilir. Excel iki sayfa çıkar: e-Fatura (entegratöre yüklenecek, kişi × gün — fatura günlük kesilir) ve Detay (kontrol listesi)."/>

        <!-- Filtre çubuğu -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Başlangıç:" VerticalAlignment="Center" Foreground="#FFAAAAAA"/>
            <DatePicker SelectedDate="{Binding FromDate}" Width="130" Margin="8,0,16,0"/>

            <TextBlock Text="Bitiş:" VerticalAlignment="Center" Foreground="#FFAAAAAA"/>
            <DatePicker SelectedDate="{Binding ToDate}" Width="130" Margin="8,0,16,0"/>

            <Button Content="Raporu Oluştur" Command="{Binding LoadCommand}" Padding="14,6"/>

            <CheckBox Content="Yalnızca adı bilinenler"
                      IsChecked="{Binding OnlyInvoiceReady}"
                      VerticalAlignment="Center" Margin="24,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <!-- e-Fatura şablon alanları: her satırda aynı olan sabitler +
                 numara sayacı. Değerler ayarlarda saklanır, dışa aktarımdan
                 sonra sayaç otomatik ilerler. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Fatura no öneki:" VerticalAlignment="Center" Foreground="#FFAAAAAA"/>
                <TextBox Text="{Binding NumberPrefix, UpdateSourceTrigger=PropertyChanged}"
                         Width="70" Margin="8,0,16,0"
                         ToolTip="Örn. RMK. Boş bırakılırsa fatura numarası sütunu boş gider."/>

                <TextBlock Text="Başlangıç no:" VerticalAlignment="Center" Foreground="#FFAAAAAA"/>
                <TextBox Text="{Binding NextNumberText, UpdateSourceTrigger=PropertyChanged}"
                         Width="140" Margin="8,0,16,0"
                         ToolTip="Örn. 2026000000602. Her satırda 1 artar, 12 haneye sıfırla tamamlanır."/>

                <TextBlock Text="Mal/Hizmet:" VerticalAlignment="Center" Foreground="#FFAAAAAA"/>
                <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"
                         Width="220" Margin="8,0,16,0"/>

                <TextBlock Text="KDV %:" VerticalAlignment="Center" Foreground="#FFAAAAAA"/>
                <TextBox Text="{Binding VatRate, UpdateSourceTrigger=PropertyChanged}"
                         Width="50" Margin="8,0,0,0"/>
            </StackPanel>

            <TextBlock Foreground="#FFAAAAAA" TextWrapping="Wrap">
                <Run Text="{Binding PersonCount, Mode=OneWay}" FontWeight="Bold" Foreground="White"/>
                <Run Text=" kişi · "/>
                <Run Text="{Binding CompleteCount, Mode=OneWay}" FontWeight="Bold" Foreground="#FF7ED957"/>
                <Run Text=" adı var / "/>
                <Run Text="{Binding MissingCount, Mode=OneWay}" FontWeight="Bold" Foreground="#FFFF6B6B"/>
                <Run Text=" adı yok · "/>
                <Run Text="{Binding OrderCount, Mode=OneWay}" FontWeight="Bold" Foreground="White"/>
                <Run Text=" sipariş · "/>
                <Run Text="{Binding TotalAmount, Mode=OneWay, StringFormat={}{0:N2} TL}"
                     FontWeight="Bold" Foreground="#FFFFD166"/>
                <Run Text=" · "/>
                <Run Text="{Binding InvoiceCount, Mode=OneWay}" FontWeight="Bold" Foreground="White"/>
                <Run Text=" e-Fatura satırı"/>
            </TextBlock>
        </StackPanel>

        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding People}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  Background="#FF1A1A1A"
                  Foreground="White"
                  BorderBrush="#FF333333"
                  RowBackground="#FF1A1A1A"
                  AlternatingRowBackground="#FF222222">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding DisplayLabel}" Width="1.6*"/>
                <DataGridTextColumn Header="TCKN"     Binding="{Binding Tckn}"        Width="*"/>
                <DataGridTextColumn Header="Telefon"  Binding="{Binding Phone}"       Width="*"/>
                <DataGridTextColumn Header="Adres"    Binding="{Binding Address}"     Width="2*"/>
                <DataGridTextColumn Header="Hesaplar" Binding="{Binding Accounts}"    Width="1.6*"/>
                <DataGridTextColumn Header="Gün"      Binding="{Binding DayCount}"    Width="50"/>
                <DataGridTextColumn Header="Sipariş"  Binding="{Binding OrderCount}"  Width="70"/>
                <DataGridTextColumn Header="Tutar"
                                    Binding="{Binding TotalAmount, StringFormat={}{0:N2} TL}"
                                    Width="110"/>
                <DataGridTextColumn Header="Fatura"
                                    Binding="{Binding InvoiceStatusLabel}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Excel'e Aktar" Command="{Binding ExportToExcelCommand}" Padding="14,6"/>
            <Button Content="Kapat" Click="OnClose" Padding="14,6" Margin="8,0,0,0"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
