<UserControl x:Class="OrderDeck.App.Views.MainShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Redesign D2a: sol ray buton stili. Implicit Button (padding'li) 56px
             raya sığmadığı için yerel 40×40 kare ikon-buton stili. Hover'da
             OD.Bg.InputHover; başka davranış yok. -->
        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource OD.Fg.Secondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource OD.Bg.InputHover}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource OD.Fg.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Redesign D2a: root [sol ikon rayı | içerik]. Eski 3-row grid içerik
         kolonuna taşındı; üst "⋮" menüsü ray + alt flyout'a dağıldı. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Sol ikon rayı (56px) ───────────────────────────────────────── -->
        <Border Grid.Column="0" Width="56"
                Background="{StaticResource OD.Bg.Surface}"
                BorderBrush="{StaticResource OD.Border.Subtle}"
                BorderThickness="0,0,1,0">
            <Grid Margin="0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" Width="36" Height="36" CornerRadius="11"
                        HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF5B8DEF" Offset="0"/>
                            <GradientStop Color="#FF4A77D4" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="OD" Foreground="White" FontWeight="Bold"
                               FontSize="13" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Navigasyon butonları (eski ⋮ menüsünden) -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                    <Button Style="{StaticResource RailButton}"
                            Command="{Binding OpenStreamHistoryCommand}"
                            ToolTip="Yayın Geçmişi">
                        <Viewbox Width="22" Height="22">
                            <Path Width="24" Height="24"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M3.5,12 A8.5,8.5 0 1 0 20.5,12 A8.5,8.5 0 1 0 3.5,12 M12,7.5 L12,12 L15,14"/>
                        </Viewbox>
                    </Button>

                    <Button Style="{StaticResource RailButton}"
                            Command="{Binding OpenCustomerSearchCommand}"
                            ToolTip="Müşteriler">
                        <Viewbox Width="22" Height="22">
                            <Path Width="24" Height="24"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M5.4,8 A3.6,3.6 0 1 0 12.6,8 A3.6,3.6 0 1 0 5.4,8 M2.5,20.5 v-1 a5.5,5.5 0 0 1 5.5,-5.5 h2 a5.5,5.5 0 0 1 5.5,5.5 v1 M16.5,4.8 a3.6,3.6 0 0 1 0,6.4 M19,14.4 a5.5,5.5 0 0 1 2.5,4.6 v1.5"/>
                        </Viewbox>
                    </Button>

                    <Button Style="{StaticResource RailButton}"
                            Command="{Binding OpenBlacklistCommand}"
                            ToolTip="Kara Liste">
                        <Viewbox Width="22" Height="22">
                            <Path Width="24" Height="24"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M2,12 A10,10 0 1 0 22,12 A10,10 0 1 0 2,12 M5,5 L19,19"/>
                        </Viewbox>
                    </Button>

                    <Button Style="{StaticResource RailButton}"
                            Command="{Binding OpenDekontEkleCommand}"
                            ToolTip="Yeni Dekont">
                        <Viewbox Width="22" Height="22">
                            <Path Width="24" Height="24"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M6,3 h12 v18 l-3,-1.8 l-3,1.8 l-3,-1.8 L6,21 V3 Z M9.5,8 L14.5,8 M9.5,12 L14.5,12"/>
                        </Viewbox>
                    </Button>

                    <Button Style="{StaticResource RailButton}"
                            Command="{Binding OpenBulkSmsCommand}"
                            ToolTip="Toplu SMS">
                        <Viewbox Width="22" Height="22">
                            <Path Width="24" Height="24"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M4,5 h16 a1,1 0 0 1 1,1 v9 a1,1 0 0 1 -1,1 H9 l-4,4 v-4 H4 a1,1 0 0 1 -1,-1 V6 a1,1 0 0 1 1,-1 Z M8,10 h8 M8,13 h5"/>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <!-- Alt flyout (eski ⋮ menüsünün kalan komutları). x:Name ve
                     Click handler birebir korundu → code-behind değişmez. -->
                <Button Grid.Row="2"
                        x:Name="MenuButton"
                        Click="OnMenuClick"
                        Style="{StaticResource RailButton}"
                        HorizontalAlignment="Center"
                        Content="⋯" FontSize="20" FontWeight="Bold"
                        ToolTip="Diğer">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MainMenu" Placement="Right">
                            <MenuItem Header="Dönem Raporu…"
                                      Command="{Binding OpenPeriodReportCommand}"/>
                            <Separator/>
                            <MenuItem Header="Ayarlar"
                                      Command="{Binding OpenSettingsCommand}"/>
                            <MenuItem Header="Destek Talepleri"
                                      Command="{Binding OpenSupportRequestsCommand}"/>
                            <MenuItem Header="Hesap"
                                      Command="{Binding OpenAccountCommand}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <!-- ── İçerik kolonu ──────────────────────────────────────────────── -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Yayın header'ı -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Canlı izleyici sayısı (👁 toplam) — tooltip platform kırılımı. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                Visibility="{Binding ViewerCountVisible, Converter={StaticResource BoolToVisibleConverter}}"
                                ToolTip="{Binding ViewerCountTooltip}">
                        <TextBlock Text="👁" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding ViewerCountText}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Chat ingestion health dot (binding'ler aynen). -->
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             ToolTip="{Binding ChatHealthTooltip}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#FF6B7280"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChatHealthState}" Value="ok">
                                        <Setter Property="Fill" Value="#FF22C55E"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChatHealthState}" Value="idle">
                                        <Setter Property="Fill" Value="#FFFBBF24"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding LicenseStatusText}"
                               Foreground="{Binding LicenseStatusBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Cursor="Hand"
                               Margin="0,0,12,0"
                               ToolTip="Hesap detayları için tıkla">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenAccountCommand}"/>
                        </TextBlock.InputBindings>
                    </TextBlock>

                    <!-- Zil: Button (Border.InputBindings LeftClick WPF'te güvenilir
                         tetiklenmiyordu; Button native Command + hit-test verir). -->
                    <Button Command="{Binding OpenIntakeSubmissionsCommand}"
                            Cursor="Hand" Margin="0,0,8,0" VerticalAlignment="Center"
                            Visibility="{Binding HasNewIntakeSubmissions, Converter={StaticResource BoolToVisibleConverter}}"
                            ToolTip="Yeni form başvurularını görüntülemek için tıkla">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Crimson" CornerRadius="10" Padding="8,3">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#C41230"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Foreground="White" FontSize="11" FontWeight="Bold">
                            <Run Text="🔔"/>
                            <Run Text="{Binding NewIntakeSubmissionsCount, Mode=OneWay}"/>
                            <Run Text="yeni başvuru"/>
                        </TextBlock>
                    </Button>

                    <Button Content="Yayın Başlat"
                            Command="{Binding StartStreamCommand}" Padding="14,6" Margin="0,0,8,0"/>
                    <Button Content="Yayını Bitir"
                            Command="{Binding EndStreamCommand}"   Padding="14,6" Margin="0,0,8,0"/>
                    <Button Command="{Binding StartGiveawayCommand}"
                            IsEnabled="{Binding CanStartGiveaway}"
                            Padding="14,6">
                        <!-- Vector multi-color gift icon (OD.Icon.Gift) aynen. -->
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource OD.Icon.Gift}"
                                   Width="18" Height="18"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Çekiliş" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Yayın durumu (StreamStatusLabel). Giveaway aktifken gizlenir
                     (mevcut davranış). -->
                <TextBlock Text="{Binding StreamStatusLabel}"
                           Foreground="{StaticResource OD.Fg.Secondary}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsGiveawayActive, Converter={StaticResource BoolToCollapsedConverter}}"/>
            </DockPanel>

            <!-- Hızlı ekleme satırı (Kod / Fiyat) -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Kod:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox  Grid.Column="1" Text="{Binding ActiveCode, UpdateSourceTrigger=PropertyChanged}"
                          Padding="6" FontSize="14"/>

                <TextBlock Grid.Column="3" Text="Fiyat:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox  Grid.Column="4" Text="{Binding ActivePriceText, UpdateSourceTrigger=PropertyChanged}"
                          Padding="6" FontSize="14"/>
            </Grid>

            <!-- Status/banner row: server offline / license expiry / backup mode /
                 giveaway. D3: tonlu radius-10 kartlar. Çıplak StreamStatusLabel
                 header'a taşınmıştı. ARGB tint'ler handoff README'den. -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <!-- License-server unreachable banner (heartbeat failed ≥2×
                     consecutive). warning %8 zemin + #E07B00 %40 kenarlık. -->
                <Border CornerRadius="10" Background="#14FBBF24"
                        BorderBrush="#66E07B00" BorderThickness="1"
                        Visibility="{Binding ServerOfflineBanner, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="{Binding ServerOfflineBanner}"
                               Foreground="#FFFFE0B0" FontWeight="SemiBold"
                               Margin="14,9"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- License-expiring-soon banner (≤7 days left). -->
                <Border CornerRadius="10" Background="#14FBBF24"
                        BorderBrush="#66E07B00" BorderThickness="1"
                        Visibility="{Binding LicenseExpiryBanner, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="{Binding LicenseExpiryBanner}"
                               Foreground="#FFFFE0B0" FontWeight="SemiBold"
                               Margin="14,9"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Backup-selection mode banner. Sits on top of competing banners
                     (highest z-order in the grid). Auto-hides when BackupTargetLabel
                     becomes null. accent %10 zemin + %35 kenarlık. -->
                <Border CornerRadius="10" Background="#1A5B8DEF"
                        BorderBrush="#595B8DEF" BorderThickness="1"
                        Visibility="{Binding IsInBackupSelectionMode, Converter={StaticResource BoolToVisibleConverter}}">
                    <DockPanel LastChildFill="False" Margin="14,7">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding BackupModeBanner}"
                                   Foreground="#FFE8F2FF" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right"
                                Content="İptal (ESC)"
                                Command="{Binding CancelBackupSelectionCommand}"
                                Padding="10,4" Margin="4,0"
                                Foreground="#FFCCDDFF"/>
                    </DockPanel>
                </Border>

                <!-- Giveaway active. warning %10 zemin + %30 kenarlık. -->
                <Border CornerRadius="10" Background="#1AFBBF24"
                        BorderBrush="#4CFBBF24" BorderThickness="1"
                        Visibility="{Binding IsGiveawayActive, Converter={StaticResource BoolToVisibleConverter}}">
                    <DockPanel LastChildFill="False" Margin="14,7">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,16,0">
                            <Image Source="{StaticResource OD.Icon.Gift}"
                                   Width="18" Height="18"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding Banner.Keyword}"
                                       Foreground="#FFFFD166" FontWeight="Bold" FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding Banner.ParticipantCount, StringFormat={}{0} katılımcı}"
                                   Foreground="White" Margin="0,0,16,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding Banner.CountdownText}"
                                   Foreground="White" Margin="0,0,16,0"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right"
                                Content="İptal"
                                Command="{Binding CancelGiveawayCommand}"
                                Padding="10,4" Margin="4,0"
                                Foreground="#FFFF6666"/>
                        <Button DockPanel.Dock="Right"
                                Content="Şimdi Çek"
                                Command="{Binding DrawGiveawayNowCommand}"
                                Padding="10,4" Margin="4,0"
                                FontWeight="Bold"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Two-pane: live chat | print queue (D2a'da AYNEN korundu) -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Live chat (D2b: panel kartı) -->
                <Border Grid.Column="0"
                        Background="{StaticResource OD.Bg.Surface}"
                        BorderBrush="{StaticResource OD.Border.Subtle}"
                        BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Panel başlık şeridi -->
                        <Border Grid.Row="0" Padding="14,11"
                                BorderBrush="{StaticResource OD.Border.Subtle}"
                                BorderThickness="0,0,0,1">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="Canlı Chat"
                                           FontSize="13.5" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="çift tık → kuyruğa ekle"
                                           FontSize="11"
                                           Foreground="{StaticResource OD.Fg.Secondary}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ListBox  Grid.Row="1"
                                  x:Name="ChatList"
                                  ItemsSource="{Binding ChatMessages}"
                                  MouseDoubleClick="ChatList_OnDoubleClick"
                                  PreviewKeyDown="ChatList_OnPreviewKeyDown"
                                  Background="Transparent" Foreground="White"
                                  BorderThickness="0" Padding="4"
                                  HorizontalContentAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background"
                                        Value="{Binding IsSenderBlacklisted,
                                                        Converter={StaticResource BlacklistToBrushConverter}}"/>
                                <!-- Item'ı liste genişliğine yasla ki mesaj TextBlock'u
                                     (Wrap) dar pencerede alt satıra geçsin — yoksa item
                                     içeriğe göre yatayda taşıp kırpılıyordu. -->
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Platform rozeti — her platformun RESMİ marka ikonu
                                         (youtube/instagram/tiktok/facebook lowercase id'ler;
                                         bilinmeyen → nötr metin chip). İkonlar ve kullanım
                                         gerekçeleri Themes/PlatformIcons.xaml'de.
                                         Rozet tıklanabilir değil, yalnızca kaynak atfıdır.
                                         Genişlik 32: YouTube ikonu 158:110 oranında olduğu için
                                         20 px yükseklikte ~29 px yer kaplıyor (diğerleri kare). -->
                                    <ContentControl Grid.Column="0" Content="{Binding}"
                                                    Width="32" Height="20" Margin="0,0,10,0"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate" Value="{StaticResource OD.PlatformChip.Unknown}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Platform}" Value="youtube"><Setter Property="ContentTemplate" Value="{StaticResource OD.PlatformChip.YouTube}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Platform}" Value="instagram"><Setter Property="ContentTemplate" Value="{StaticResource OD.PlatformChip.Instagram}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Platform}" Value="tiktok"><Setter Property="ContentTemplate" Value="{StaticResource OD.PlatformChip.TikTok}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Platform}" Value="facebook"><Setter Property="ContentTemplate" Value="{StaticResource OD.PlatformChip.Facebook}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                    <TextBlock Grid.Column="1" Text="{Binding Display}"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding Username}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Text}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{StaticResource OD.Fg.Primary}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Müşteri Detayı"
                                          Command="{Binding PlacementTarget.DataContext.OpenCustomerDetailFromChatCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <!--
                                  YouTube moderation menu items. OAuth audit kaydı için
                                  açıldı (Settings → "YouTube'a Bağlan" kartıyla lockstep).
                                  Kullanıcı YouTube'a bağlı değilse komutlar no-op/uyarı
                                  verir; consent + audit ile birlikte kalıcı kullanılır.
                                -->
                                <MenuItem Header="YouTube'da mesajı sil"
                                          Command="{Binding PlacementTarget.DataContext.DeleteYouTubeMessageCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Visibility="{Binding PlacementTarget.SelectedItem.IsYouTube,
                                                               RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                               Converter={StaticResource BoolToVisibleConverter},
                                                               FallbackValue=Collapsed}"/>
                                <MenuItem Header="YouTube'da kullanıcıyı banla"
                                          Command="{Binding PlacementTarget.DataContext.BanYouTubeUserCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Visibility="{Binding PlacementTarget.SelectedItem.IsYouTube,
                                                               RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                               Converter={StaticResource BoolToVisibleConverter},
                                                               FallbackValue=Collapsed}"/>
                                <MenuItem Header="YouTube'da banı kaldır"
                                          Command="{Binding PlacementTarget.DataContext.UnbanYouTubeUserCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Visibility="{Binding PlacementTarget.SelectedItem.IsYouTube,
                                                               RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                               Converter={StaticResource BoolToVisibleConverter},
                                                               FallbackValue=Collapsed}"/>
                                <!--
                                  Facebook moderation. Mirrors the YouTube pair above:
                                  ExternalId is the Graph comment id, Username is the
                                  page-scoped user id, so FacebookModerationService takes
                                  both through unchanged. Requires a connected Page
                                  (Settings → Facebook) — otherwise the commands warn.
                                -->
                                <MenuItem Header="Facebook'ta yorumu sil"
                                          Command="{Binding PlacementTarget.DataContext.DeleteFacebookCommentCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Visibility="{Binding PlacementTarget.SelectedItem.IsFacebook,
                                                               RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                               Converter={StaticResource BoolToVisibleConverter},
                                                               FallbackValue=Collapsed}"/>
                                <MenuItem Header="Facebook'ta kullanıcıyı banla"
                                          Command="{Binding PlacementTarget.DataContext.BanFacebookUserCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Visibility="{Binding PlacementTarget.SelectedItem.IsFacebook,
                                                               RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                               Converter={StaticResource BoolToVisibleConverter},
                                                               FallbackValue=Collapsed}"/>
                                <MenuItem Header="Facebook'ta banı kaldır"
                                          Command="{Binding PlacementTarget.DataContext.UnbanFacebookUserCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Visibility="{Binding PlacementTarget.SelectedItem.IsFacebook,
                                                               RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                               Converter={StaticResource BoolToVisibleConverter},
                                                               FallbackValue=Collapsed}"/>
                                <MenuItem Header="Kara Listeye Al…"
                                          Command="{Binding PlacementTarget.DataContext.AddChatSenderToBlacklistCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- RIGHT: Print queue (D2b: panel kartı) -->
                <Border Grid.Column="2"
                        Background="{StaticResource OD.Bg.Surface}"
                        BorderBrush="{StaticResource OD.Border.Subtle}"
                        BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Panel başlık şeridi + adet chip'i -->
                        <Border Grid.Row="0" Padding="14,11"
                                BorderBrush="{StaticResource OD.Border.Subtle}"
                                BorderThickness="0,0,0,1">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="Yazdırılacak Etiketler"
                                           FontSize="13.5" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <Border DockPanel.Dock="Left" CornerRadius="6" Margin="9,0,0,0"
                                        Padding="7,1" VerticalAlignment="Center"
                                        Background="#295B8DEF">
                                    <TextBlock Text="{Binding PrintQueue.Count}"
                                               FontSize="10.5" FontWeight="Bold"
                                               Foreground="{StaticResource OD.Accent}"/>
                                </Border>
                            </DockPanel>
                        </Border>
                        <ListBox Grid.Row="1"
                                 x:Name="QueueList"
                                 ItemsSource="{Binding PrintQueue}"
                                 SelectedItem="{Binding SelectedQueueItem, Mode=TwoWay}"
                                 SelectionMode="Extended"
                                 SelectionChanged="QueueList_OnSelectionChanged"
                                 Background="Transparent" Foreground="White"
                                 BorderThickness="0" Padding="4">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background"
                                        Value="{Binding IsCustomerBlacklisted,
                                                        Converter={StaticResource BlacklistToBrushConverter}}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Display}"
                                               FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Username}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding MessageText}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Margin="6,0,6,0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Price, StringFormat={}{0:N2} TL}"
                                               HorizontalAlignment="Right" FontWeight="Bold"
                                               Foreground="#FFFFD166"/>
                                    <!-- Backup chip: 0 → "Yedek+" CTA, N → "👥 N" badge.
                                         Click activates backup-selection mode for this label;
                                         subsequent chat double-click is routed to
                                         MainShellViewModel.TryAssignChatAsBackup. -->
                                    <Button Grid.Column="3"
                                            Margin="8,0,0,0"
                                            Padding="8,2"
                                            FontSize="11"
                                            MinWidth="60"
                                            Content="{Binding BackupCount, Converter={StaticResource BackupChipConverter}}"
                                            Command="{Binding DataContext.BeginAddBackupCommand,
                                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Yedek müşteri ekle: tıkla, sonra chat'ten birini seç"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Müşteri Detayı"
                                          Command="{Binding PlacementTarget.DataContext.OpenCustomerDetailFromQueueCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Kara Listeye Al…"
                                          Command="{Binding PlacementTarget.DataContext.AddQueueRowToBlacklistCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        </ListBox>

                        <!-- Alt eylem şeridi (üst kenarlıklı) -->
                        <Border Grid.Row="2" Padding="14,11"
                                BorderBrush="{StaticResource OD.Border.Subtle}"
                                BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding PrintButtonLabel}"
                                        Command="{Binding PrintCommand}"
                                        Padding="20,8" FontSize="14" FontWeight="Bold"
                                        Background="{StaticResource OD.Accent}" Foreground="White"/>
                                <Button Content="{Binding DeleteButtonLabel}"
                                        Command="{Binding RemoveSelectedFromQueueCommand}"
                                        Padding="14,8" Margin="8,0,0,0"/>
                                <Button Content="Hepsini Temizle"
                                        Command="{Binding ClearQueueCommand}"
                                        Padding="14,8" Margin="8,0,0,0"
                                        Foreground="#FFFF6666"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
