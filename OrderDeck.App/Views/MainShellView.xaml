<UserControl x:Class="OrderDeck.App.Views.MainShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:OrderDeck.App.Views.Shell"
             SizeChanged="OnSizeChanged">
    <!-- MinWidth/MinHeight BURADA DEĞİL, MainWindow'da. İçeriğe asgari ölçü
         vermek pencereyi büyütmez; yalnız içerik pencereden taşar ve sağ sütun
         ekran dışında kalır (kullanıcı raporu: yarım ekranda uygulama
         kullanılamıyordu). Asgari ölçü pencerenin işidir. -->
    <!-- Faz 1 kompozisyon kökü. Eski 664 satırlık gövde Görev 9-14'te yedi
         UserControl'e bölündü (Views/Shell/); burada yalnızca yerleşim var.
         Ana ızgara: sol kenar | içerik. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <shell:ShellSidebar Grid.Column="0"/>

        <Grid Grid.Column="1" MaxWidth="{StaticResource OD.Layout.ContentMaxWidth}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- üst bar -->
                <RowDefinition Height="Auto"/>   <!-- şeritler -->
                <RowDefinition Height="*"/>      <!-- sohbet | sağ sütun -->
            </Grid.RowDefinitions>

            <shell:ShellTopBar  Grid.Row="0"/>
            <shell:ShellBanners Grid.Row="1" Margin="{StaticResource OD.Pad.4}"/>

            <Grid Grid.Row="2" Margin="{StaticResource OD.Pad.4}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <shell:ChatPanel Grid.Column="0"/>

                <!-- Sağ sütun sabit genişlik: sohbetin genişliği ekran
                     daralınca değişmesin (spec §6 — feda edilen kuyruk).
                     Yerleşim kararı 2026-08-08: kod ve fiyat eskiden üstte
                     tam genişlikte bir şeritti; buraya indi. Sohbet hem o
                     yüksekliği kazandı hem de sütun genişleyince daraldı. -->
                <Grid Grid.Column="1" Width="{StaticResource OD.Layout.RightWidth}"
                      Margin="{StaticResource OD.Pad.4}">
                    <Grid.RowDefinitions>
                        <!-- Çekmecenin örttüğü alan. Üst satırın "*" olması
                             şart: yuva Auto olduğu için artan yer buraya
                             gider, yani çekmece boyu ekranla birlikte
                             büyür. -->
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>   <!-- yazdır yuvası -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- kod + fiyat -->
                            <RowDefinition Height="Auto"/>   <!-- ürün kartı -->
                            <RowDefinition Height="*"/>      <!-- yazdırılacak etiketler -->
                        </Grid.RowDefinitions>
                        <shell:ActiveProductBar Grid.Row="0" x:Name="ProductBar"/>
                        <shell:ProductCard      Grid.Row="1"
                                                Margin="{StaticResource OD.Pad.Top5}"/>
                        <shell:PrintQueuePanel  Grid.Row="2"
                                                Margin="{StaticResource OD.Pad.Top5}"/>
                    </Grid>

                    <!-- Çekmece katmanı YALNIZ üst satırı örter. Yazdır yuvası
                         alt satırda kalıyor, yani çekmece açıkken de etiket
                         basılabiliyor — spec §6.2'nin açık maddesi buydu.
                         Kardeşinden SONRA yazılı olması z-düzenini veriyor.
                         Sohbet (sütun 0) hiç etkilenmez. -->
                    <shell:DrawerHost Grid.Row="0"/>

                    <shell:PrintSlot Grid.Row="1"
                                     Margin="{StaticResource OD.Pad.Top5}"/>
                </Grid>
            </Grid>

            <!-- Sayfa katmanı (Faz 3): satır 1-2'yi örter, ÜST BAR AÇIKTA
                 KALIR. Sayfadayken de yayın başlatılıp bitirilebilsin diye —
                 bugünkü modal pencerenin kaybettirdiği şey buydu.
                 Kardeşlerinden SONRA yazılı olması z-düzenini veriyor
                 (DrawerHost'ta da kullanılan kalıp). -->
            <shell:PageHost Grid.Row="1" Grid.RowSpan="2"/>
        </Grid>
    </Grid>
</UserControl>
