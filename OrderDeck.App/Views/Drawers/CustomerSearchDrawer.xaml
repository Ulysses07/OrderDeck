<UserControl x:Class="OrderDeck.App.Views.Drawers.CustomerSearchDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- CustomerSearchDialog'un (580x640 Window) çekmece karşılığı — spec §6.2.
         Yayın sırasında açılıyor, o yüzden sayfa değil çekmece: sohbet solda
         görünür kalmalı.

         Pencereden farklar:
         · Başlık ve "Kapat" düğmesi DÜŞTÜ — ikisini de DrawerHost'un şeridi
           veriyor (ESC de oradan).
         · Sayaç kartlarının etiketleri kısaldı (TOPLAM / KAYITLI / YENİ).
           Uzun hâlleri 400px'e üç yan yana sığmıyordu; tam anlamları
           ToolTip'te.
         · Emoji ikonlar kalktı (spec §10 "emoji ikon 0"). Yerlerine metin
           rozet: "Kayıtlı", "Birleşik". Telefon/e-posta satırındaki 📱 ✉
           yerine biçim ayırıyor — numara mono, e-posta soluk. -->
    <UserControl.Resources>
        <!-- Sayaç kartı. Üç tanesi tek satırda: genişlik "*" ile paylaşılıyor,
             MinWidth YOK — 400px'lik çekmecede sabit genişlik taşırdı. -->
        <Style x:Key="CountCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource OD.Radius.Md}"/>
            <Setter Property="Padding"      Value="{StaticResource OD.Pad.3}"/>
            <Setter Property="Background"   Value="{StaticResource OD.Brush.Surface2}"/>
            <Setter Property="BorderBrush"  Value="{StaticResource OD.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock"
               BasedOn="{StaticResource OD.Text.Mono}">
            <Setter Property="FontSize"   Value="{StaticResource OD.Font.F3}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="{StaticResource OD.Pad.Top3}"/>
        </Style>
        <!-- Kart içi metin rozeti: "Kayıtlı" / "Birleşik" / platform adı. -->
        <Style x:Key="RowChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource OD.Radius.Xs}"/>
            <Setter Property="Padding"      Value="{StaticResource OD.Pad.1}"/>
            <Setter Property="Margin"       Value="{StaticResource OD.Pad.X2}"/>
            <Setter Property="Background"   Value="{StaticResource OD.Brush.Surface2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource OD.Pad.5}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Sayaçlar ═══ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CountCard}"
                    ToolTip="Kayıtlı olsun olmasın, sistemde görülmüş tüm müşteriler">
                <StackPanel>
                    <TextBlock Text="TOPLAM" Style="{StaticResource OD.Text.Micro}"/>
                    <TextBlock Text="{Binding TotalCount}" Style="{StaticResource CardValue}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CountCard}"
                    Margin="{StaticResource OD.Pad.X2}"
                    ToolTip="Telefon numarası kayıtlı müşteriler">
                <StackPanel>
                    <TextBlock Text="KAYITLI" Style="{StaticResource OD.Text.Micro}"/>
                    <TextBlock Text="{Binding RegisteredCount}" Style="{StaticResource CardValue}"
                               Foreground="{StaticResource OD.Brush.Success}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CountCard}"
                    ToolTip="Bu yayında ilk kez görülen müşteriler"
                    Visibility="{Binding HasNewThisSession, Converter={StaticResource BoolToVisibleConverter}}">
                <StackPanel>
                    <TextBlock Text="YENİ" Style="{StaticResource OD.Text.Micro}"/>
                    <TextBlock Text="{Binding NewThisSessionCount}" Style="{StaticResource CardValue}"
                               Foreground="{StaticResource OD.Brush.Accent}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ Arama + filtreler ═══ -->
        <StackPanel Grid.Row="1" Margin="{StaticResource OD.Pad.Top5}">
            <Grid>
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource OD.TextBox}"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"/>
                <!-- Yer tutucu: WPF'te TextBox'ın PlaceholderText'i yok, üstüne
                     çizilen ve tıklamayı yutmayan bir TextBlock kalıbı. -->
                <TextBlock Text="İsim veya kullanıcı adı ara…"
                           Margin="{StaticResource OD.Pad.X5}"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource OD.Text.Label}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Query}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ComboBox Style="{StaticResource OD.ComboBox}"
                      Margin="{StaticResource OD.Pad.Top4}"
                      ItemsSource="{Binding PlatformOptions}"
                      DisplayMemberPath="Display" SelectedValuePath="Value"
                      SelectedValue="{Binding PlatformFilter}"/>

            <CheckBox Style="{StaticResource OD.Toggle}"
                      Margin="{StaticResource OD.Pad.Top4}"
                      Content="Sadece kayıtlı müşteriler"
                      IsChecked="{Binding RegisteredOnly}"/>
            <CheckBox Style="{StaticResource OD.Toggle}"
                      Margin="{StaticResource OD.Pad.Top3}"
                      Content="Son yayından alışverişçiler"
                      IsChecked="{Binding LastStreamShoppersOnly}"/>

            <TextBlock Style="{StaticResource OD.Text.Hint}">
                <Run Text="{Binding ResultCount, Mode=OneWay}"/>
                <Run Text="sonuç"/>
            </TextBlock>
        </StackPanel>

        <!-- ═══ Liste ═══ -->
        <Grid Grid.Row="2" Margin="{StaticResource OD.Pad.Top4}">
            <ListBox x:Name="ResultsList"
                     Style="{StaticResource OD.ListBox}"
                     ItemsSource="{Binding Results}"
                     SelectionMode="Extended"
                     SelectionChanged="ResultsList_OnSelectionChanged"
                     MouseDoubleClick="ResultsList_OnDoubleClick"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin"  Value="{StaticResource OD.Pad.1}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="cardBorder"
                                            Background="{StaticResource OD.Brush.Surface2}"
                                            CornerRadius="{StaticResource OD.Radius.Md}"
                                            BorderBrush="{StaticResource OD.Brush.Border}"
                                            BorderThickness="1"
                                            Padding="{StaticResource OD.Pad.3}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="cardBorder" Property="BorderBrush"
                                                    Value="{StaticResource OD.Brush.BorderStrong}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="cardBorder" Property="BorderBrush"
                                                    Value="{StaticResource OD.Brush.Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <!-- Satır 1: isim + rozetler. WrapPanel, çünkü
                                     birleşik müşteride rozet sayısı belirsiz ve
                                     çekmece dar. -->
                                <WrapPanel>
                                    <TextBlock Text="{Binding Display}"
                                               FontFamily="{StaticResource OD.Font.Sans}"
                                               FontSize="{StaticResource OD.Font.F2}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource OD.Brush.Text}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Style="{StaticResource RowChip}"
                                            Visibility="{Binding Phone, Converter={StaticResource NullToCollapsedConverter}}">
                                        <TextBlock Text="Kayıtlı" Style="{StaticResource OD.Text.Micro}"
                                                   Foreground="{StaticResource OD.Brush.Success}"/>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Platforms}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowChip}">
                                                    <TextBlock Text="{Binding}" Style="{StaticResource OD.Text.Micro}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Style="{StaticResource RowChip}"
                                            Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibleConverter}}">
                                        <TextBlock Text="Birleşik" Style="{StaticResource OD.Text.Micro}"
                                                   Foreground="{StaticResource OD.Brush.Info}"/>
                                    </Border>
                                </WrapPanel>

                                <!-- Satır 2: telefon (mono) + e-posta -->
                                <TextBlock Style="{StaticResource OD.Text.Suffix}"
                                           HorizontalAlignment="Left"
                                           Margin="{StaticResource OD.Pad.Top3}"
                                           Text="{Binding Phone, Mode=OneWay}"
                                           Visibility="{Binding Phone, Converter={StaticResource NullToCollapsedConverter}}"/>
                                <TextBlock Style="{StaticResource OD.Text.Hint}"
                                           Text="{Binding Email, Mode=OneWay}"
                                           Visibility="{Binding Email, Converter={StaticResource NullToCollapsedConverter}}"/>

                                <!-- Satır 3: son görülme -->
                                <TextBlock Style="{StaticResource OD.Text.Hint}">
                                    <Run Text="Son görülme:"/>
                                    <Run Text="{Binding LastSeenAt, Converter={StaticResource UnixToDateConverter}, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <!-- Komutlar kartta değil ViewModel'de: ListBox
                                     üzerinden bağlanıyor (çekmecenin kendi
                                     DataContext'i zaten o). -->
                                <Button Content="Öde"
                                        Style="{StaticResource OD.Button.Secondary}"
                                        Padding="{StaticResource OD.Pad.3}"
                                        ToolTip="WhatsApp'tan ödeme iste"
                                        Command="{Binding DataContext.OpenWhatsAppCommand,
                                                 RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Ayır"
                                        Style="{StaticResource OD.Button.Ghost}"
                                        HorizontalContentAlignment="Center"
                                        Margin="{StaticResource OD.Pad.Top3}"
                                        ToolTip="Bu birleşik müşteriyi tekil satırlara ayır"
                                        Command="{Binding DataContext.UnmergeGroupCommand,
                                                 RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibleConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Sonuç yok"
                       Style="{StaticResource OD.Text.Label}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Results.Count, Converter={StaticResource CountToCollapsedConverter}}"/>
        </Grid>

        <!-- ═══ Alt ═══ -->
        <StackPanel Grid.Row="3" Margin="{StaticResource OD.Pad.Top4}">
            <Button Content="Seçilenleri Birleştir"
                    Style="{StaticResource OD.Button.Primary}"
                    Command="{Binding MergeSelectedCommand}"/>
            <TextBlock Text="Aynı kişiyi birleştirmek için Ctrl ile 2+ kart seçin"
                       Style="{StaticResource OD.Text.Hint}"/>
        </StackPanel>
    </Grid>
</UserControl>
