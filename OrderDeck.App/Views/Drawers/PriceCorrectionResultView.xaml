<UserControl x:Class="OrderDeck.App.Views.Drawers.PriceCorrectionResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fiyat düzeltmesinin SONUÇ görünümü (sahip kararları K5, F2): "yeniden
         basılsın mı?" (varsayılan Evet), eski tutarla istek gitmiş kişiler
         ("düzeltilmiş isteği gönder"), ödemesi alınmışlar. İki yerde aynı
         görünüm: "Fiyatı düzelt" çekmecesi ve kuyruğun üstündeki satır içi
         sonuç (kutuda etiketi olan kodun fiyatı değiştirilip şeritte "Evet"
         denince — çekmece açılmaz, kod/fiyat kutusu ve kuyruk örtülmez;
         Shell/CodePriceResultPanel).
         DataContext: PriceCorrectionViewModel. -->
    <StackPanel>
        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap"
                   FontSize="{StaticResource OD.Font.F2}"
                   Foreground="{StaticResource OD.Brush.Text}"/>

        <!-- Yeniden baskı sorusu: varsayılan EVET — soru açılınca odak Evet'e geçer, Enter Evet
             demek. IsDefault KULLANILMAZ: çekmece modal değil, IsDefault Enter'ı bütün pencereye
             kaydeder; sohbet aramasında basılan Enter etiketleri yeniden basardı (kod arkada). -->
        <Border Margin="{StaticResource OD.Pad.Top4}"
                Padding="{StaticResource OD.Pad.3}"
                Background="{StaticResource OD.Brush.InfoTint}"
                BorderBrush="{StaticResource OD.Brush.InfoTintBorder}"
                BorderThickness="1"
                CornerRadius="{StaticResource OD.Radius.Md}"
                Visibility="{Binding IsReprintAsked, Converter={StaticResource BoolToVisibleConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding ReprintQuestion}" TextWrapping="Wrap"
                           Foreground="{StaticResource OD.Brush.Text}"/>
                <TextBlock Text="Yeni kâğıtta küçük &quot;DÜZELTME&quot; işareti olur; ciro ikinci kez artmaz."
                           Style="{StaticResource OD.Text.Hint}"/>
                <StackPanel Orientation="Horizontal" Margin="{StaticResource OD.Pad.Top3}">
                    <Button x:Name="ReprintYesButton"
                            Content="Evet, yeniden bas"
                            Style="{StaticResource OD.Button.Primary}"
                            Command="{Binding ReprintCommand}"/>
                    <Button Content="Hayır"
                            Style="{StaticResource OD.Button.Ghost}"
                            Margin="{StaticResource OD.Pad.X2}"
                            Command="{Binding SkipReprintCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding ReprintResult}" TextWrapping="Wrap"
                   Style="{StaticResource OD.Text.Hint}"
                   Visibility="{Binding ReprintResult, Converter={StaticResource NullToCollapsedConverter}}"/>

        <!-- Eski tutarla istek gitmiş kişiler -->
        <StackPanel Margin="{StaticResource OD.Pad.Top5}"
                    Visibility="{Binding HasResendRows, Converter={StaticResource BoolToVisibleConverter}}">
            <TextBlock Text="ESKİ TUTARLA ÖDEME İSTEĞİ GİTMİŞ" Style="{StaticResource OD.Text.Micro}"/>
            <ItemsControl ItemsSource="{Binding ResendRows}" Margin="{StaticResource OD.Pad.Top3}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="{StaticResource OD.Pad.Bottom3}">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                       Foreground="{StaticResource OD.Brush.Text}"/>
                            <TextBlock Text="{Binding OutcomeText}" TextWrapping="Wrap"
                                       Visibility="{Binding OutcomeText, Converter={StaticResource NullToCollapsedConverter}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource OD.Text.Hint}">
                                        <Setter Property="Foreground" Value="{StaticResource OD.Brush.Success}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NeedsManual}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource OD.Brush.Amber}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding ResendNote}" TextWrapping="Wrap"
                       Style="{StaticResource OD.Text.Hint}"
                       Visibility="{Binding ResendNote, Converter={StaticResource NullToCollapsedConverter}}"/>
            <TextBlock Text="Ek soru gerektirenler (birleştirme, telefon, bakiye doğrulanamadı) gönderilmez, &quot;elle bakılmalı&quot; olarak kalır."
                       Style="{StaticResource OD.Text.Hint}"
                       Visibility="{Binding IsResendAvailable, Converter={StaticResource BoolToVisibleConverter}}"/>
            <Button Content="{Binding ResendButtonText}"
                    Style="{StaticResource OD.Button.Secondary}"
                    Margin="{StaticResource OD.Pad.Top3}"
                    Command="{Binding ResendCommand}"
                    Visibility="{Binding IsResendAvailable, Converter={StaticResource BoolToVisibleConverter}}"/>
        </StackPanel>

        <!-- Ödemesi alınmışlar: otomatik bir şey gitmez, fark gösterilir. -->
        <StackPanel Margin="{StaticResource OD.Pad.Top5}"
                    Visibility="{Binding HasPaidRows, Converter={StaticResource BoolToVisibleConverter}}">
            <TextBlock Text="ÖDEMESİ ALINMIŞ — OTOMATİK BİR ŞEY GİTMEDİ" Style="{StaticResource OD.Text.Micro}"/>
            <ItemsControl ItemsSource="{Binding PaidRows}" Margin="{StaticResource OD.Pad.Top3}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                   Foreground="{StaticResource OD.Brush.Text}"
                                   Margin="{StaticResource OD.Pad.Bottom2}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Dekonta ve bakiyeye dokunulmadı; farkı müşteriyle sen çöz."
                       Style="{StaticResource OD.Text.Hint}"/>
        </StackPanel>

        <!-- FİYAT değişikliğinin satır içi sonucunda gizli (ShowsDoneButton=False): orada "Kapat" kaydırılan
             alanın dışında, başlık satırında (Shell/CodePriceResultPanel). -->
        <Button x:Name="DoneButton"
                Content="Kapat"
                Style="{StaticResource OD.Button.Ghost}"
                HorizontalContentAlignment="Center"
                Margin="{StaticResource OD.Pad.Top5}"
                Command="{Binding DoneCommand}"/>
    </StackPanel>
</UserControl>
