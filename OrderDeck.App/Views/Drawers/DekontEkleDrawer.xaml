<UserControl x:Class="OrderDeck.App.Views.Drawers.DekontEkleDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DekontEkleDialog'un (520x560 Window) çekmece karşılığı — spec §6.
         Zincirin kökü: buradan KargoYönergesi, oradan KargoEşiği açılabilir,
         yani çekmece yığınının üç seviyesini gerçekten kullanan tek akış.

         520px iki sütundan (120px etiket + alan) 400px tek sütuna inerken
         etiketler alanların ÜSTÜNE alındı — 400px'te 120px'i etikete ayırmak
         "Kullanıcı adı" gibi alanlara 220px bırakıyordu. Aynı kalıp
         GiveawayDrawer'da da var, iki çekmece tutarlı okunuyor.

         Sabit hex'ler paletten tokenlara çevrildi (spec §10); IBAN uyarısının
         tonlu zemini zaten Colors.xaml'de token olarak duruyordu
         (AmberTintStrong / AmberTintBorder — MainShellView şeritlerinden).

         Kaydet düğmesindeki onay işareti ve PDF kartındaki bulut ikonu
         DÜŞTÜ: ikisi de kendi ControlTemplate'ini gerektiriyordu, oysa
         OD.Button.Primary ve düz kart aynı işi yapıyor. Metin zaten
         "PDF Yükle" / "Kaydet" diyor. -->
    <Grid Margin="{StaticResource OD.Pad.5}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- PDF yükleme kartı. Formun ana giriş yolu: dört alanı birden
                     doldurduğu için en üstte. Kesikli değil düz kenarlık —
                     çekmecede sürükle-bırak yok, tıklanacak bir kart. -->
                <Button Click="OnPickPdf"
                        HorizontalAlignment="Stretch"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Banka dekontu PDF'inden ödeyen, tutar, tarih ve referans no'yu otomatik çıkarır. Yanlış çıkarsa elle düzeltebilirsin.">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Dz"
                                    CornerRadius="{StaticResource OD.Radius.Lg}"
                                    Background="{StaticResource OD.Brush.Surface2}"
                                    BorderBrush="{StaticResource OD.Brush.Border}"
                                    BorderThickness="1"
                                    Padding="{StaticResource OD.Pad.4}">
                                <StackPanel>
                                    <TextBlock Text="PDF Yükle"
                                               FontFamily="{StaticResource OD.Font.Sans}"
                                               FontSize="{StaticResource OD.Font.F2}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource OD.Brush.Text}"/>
                                    <TextBlock Text="Ödeyen, tutar, tarih ve referans no otomatik doldurulur — 10+ banka formatı"
                                               Style="{StaticResource OD.Text.Micro}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Dz" Property="BorderBrush"
                                            Value="{StaticResource OD.Brush.BorderStrong}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- IBAN/alıcı adı uyarısı. Pencerede düğmelerin hemen
                     üstündeydi; burada onu ÜRETEN PDF kartının altına alındı —
                     "para başka hesaba gitmiş olabilir" uyarısının kaydırma
                     çizgisinin altında kalması kabul edilemez. -->
                <Border Background="{StaticResource OD.Brush.AmberTintStrong}"
                        BorderBrush="{StaticResource OD.Brush.AmberTintBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OD.Radius.Md}"
                        Padding="{StaticResource OD.Pad.3}"
                        Margin="{StaticResource OD.Pad.Top5}"
                        Visibility="{Binding IbanWarning, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="{Binding IbanWarning}" TextWrapping="Wrap"
                               FontFamily="{StaticResource OD.Font.Mono}"
                               FontSize="{StaticResource OD.Font.F0}"
                               Foreground="{StaticResource OD.Brush.Amber}"/>
                </Border>

                <TextBlock Text="ÖDEYEN" Style="{StaticResource OD.Text.Micro}"
                           Margin="{StaticResource OD.Pad.Top5}"/>
                <TextBox Text="{Binding PayerName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource OD.TextBox}"/>

                <TextBlock Text="TUTAR (TL)" Style="{StaticResource OD.Text.Micro}"
                           Margin="{StaticResource OD.Pad.Top5}"/>
                <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource OD.TextBox}"
                         FontFamily="{StaticResource OD.Font.Mono}"
                         ToolTip="Örn: 250,50 veya 250.50"/>

                <TextBlock Text="ÖDEME TARİHİ" Style="{StaticResource OD.Text.Micro}"
                           Margin="{StaticResource OD.Pad.Top5}"/>
                <DatePicker SelectedDate="{Binding PaidAt}"/>

                <TextBlock Text="REFERANS NO" Style="{StaticResource OD.Text.Micro}"
                           Margin="{StaticResource OD.Pad.Top5}"/>
                <TextBox Text="{Binding ReferansNo, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource OD.TextBox}"
                         FontFamily="{StaticResource OD.Font.Mono}"
                         ToolTip="Banka dekontundaki referans/işlem no"/>

                <!-- Ayırıcı: buradan aşağısı opsiyonel. Pencerede bunu yalnız
                     bir başlık metni söylüyordu; tek sütunda alanlar alt alta
                     dizilince sınır görünmüyordu. -->
                <Border Height="1" Margin="{StaticResource OD.Pad.Top6}"
                        Background="{StaticResource OD.Brush.Border}"/>
                <TextBlock Text="MÜŞTERİ (OPSİYONEL — KARGO EŞLEŞTİRME İÇİN)"
                           Style="{StaticResource OD.Text.Micro}"
                           TextWrapping="Wrap"
                           Margin="{StaticResource OD.Pad.Top5}"/>

                <TextBlock Text="PLATFORM" Style="{StaticResource OD.Text.Micro}"
                           Margin="{StaticResource OD.Pad.Top5}"/>
                <ComboBox SelectedValue="{Binding CustomerPlatform}"
                          SelectedValuePath="Content"
                          ToolTip="Müşterinin yayın platformu — kargo eşleştirme için">
                    <ComboBoxItem Content=""/>
                    <ComboBoxItem Content="instagram"/>
                    <ComboBoxItem Content="tiktok"/>
                    <ComboBoxItem Content="facebook"/>
                    <ComboBoxItem Content="youtube"/>
                    <ComboBoxItem Content="form"/>
                </ComboBox>

                <TextBlock Text="KULLANICI ADI" Style="{StaticResource OD.Text.Micro}"
                           Margin="{StaticResource OD.Pad.Top5}"/>
                <TextBox Text="{Binding CustomerUsername, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource OD.TextBox}"
                         ToolTip="Müşterinin platformdaki kullanıcı adı (örn: @ayse_y) — bulunursa otomatik eşleştirme yapılır"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Hata ve eylemler kaydırma DIŞINDA: kaydetme hatası formun neresinde
             olursan ol görünmeli (GiveawayDrawer ile aynı kalıp). -->
        <StackPanel Grid.Row="1" Margin="{StaticResource OD.Pad.Top5}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       FontFamily="{StaticResource OD.Font.Sans}"
                       FontSize="{StaticResource OD.Font.F1}"
                       Foreground="{StaticResource OD.Brush.Accent}"
                       Visibility="{Binding ErrorMessage,
                                    Converter={StaticResource NullToCollapsedConverter}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="{StaticResource OD.Pad.Top5}">
                <Button Content="İptal" Style="{StaticResource OD.Button.Ghost}"
                        Margin="{StaticResource OD.Pad.X2}" Click="OnCancel"/>
                <Button Content="Kaydet" Style="{StaticResource OD.Button.Primary}"
                        Margin="{StaticResource OD.Pad.X2}"
                        IsEnabled="{Binding CanSave}" Click="OnSave"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
