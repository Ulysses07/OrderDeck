<UserControl x:Class="OrderDeck.App.Views.Drawers.BackupTransferDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- BackupTransferDialog'un (640x500 Window) çekmece karşılığı — Faz 3'ün
         son dönüşümü.

         NEDEN SAYFA DEĞİL ÇEKMECE (spec §6.1 vs §6.2 kararı burada verildi):
         bu ekran müşteri detay ÇEKMECESİNİN içinden, etiket iptalinin hemen
         ardından açılıyor. Sayfa yapılsaydı çekmeceyi örterdi ve sayfanın
         "geri"si sayfa yığınına gittiği için operatör geri dediğinde
         müşteri detayına değil altta duran sayfaya düşerdi. Çekmece olarak
         yığının üstüne biniyor, kapanınca detay olduğu yerde duruyor.

         640 → 400px: 5 kolonlu GridView kart listesine döndü (PR-4/2'de
         etiket/bakiye listelerinde kullanılan aynı kalıp). Kolon başlığı
         yok, her kart kendi alanlarını taşıyor.

         Ayrıca:
         · Başlık satırı DÜŞTÜ — DrawerHost'un şeridi veriyor, çağıran taraf
           başlığa yedek sayısını yazıyor.
         · "Kapat" düğmesi DÜŞTÜ — şeritteki çarpı (ve ESC) aynı işi görüyor.
         · Platform emojileri (📷 🎵 👥 ▶️) resmi marka ikonlarına döndü
           (spec §10: emoji ikon 0). -->
    <UserControl.Resources>
        <!-- Kart kabı: ItemsControl kullanıyoruz çünkü burada SEÇİM yok —
             eylem her kartın kendi düğmesinde. -->
        <Style x:Key="BackupCard" TargetType="Border"
               BasedOn="{StaticResource OD.Panel}">
            <Setter Property="Background" Value="{StaticResource OD.Brush.Surface2}"/>
            <Setter Property="Padding"    Value="{StaticResource OD.Pad.4}"/>
            <Setter Property="Margin"     Value="{StaticResource OD.Pad.Bottom3}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource OD.Pad.5}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="Subtitle"
                   Style="{StaticResource OD.Text.Label}"
                   TextWrapping="Wrap"/>

        <Grid Grid.Row="1" Margin="{StaticResource OD.Pad.Top4}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="BackupsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource BackupCard}">
                                <StackPanel>
                                    <!-- Kimlik: resmi platform ikonu + kullanıcı adı -->
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl VerticalAlignment="Center">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate"
                                                            Value="{StaticResource OD.PlatformChip.Unknown}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Platform}" Value="youtube">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource OD.PlatformChip.YouTube}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Platform}" Value="instagram">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource OD.PlatformChip.Instagram}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Platform}" Value="tiktok">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource OD.PlatformChip.TikTok}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Platform}" Value="facebook">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource OD.PlatformChip.Facebook}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>

                                        <TextBlock Text="{Binding DisplayName}"
                                                   Margin="{StaticResource OD.Pad.Left4}"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource OD.Font.Sans}"
                                                   FontSize="{StaticResource OD.Font.F2}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource OD.Brush.Text}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding MessageText}"
                                               Style="{StaticResource OD.Text.Hint}"
                                               TextWrapping="Wrap"
                                               Margin="{StaticResource OD.Pad.Top3}"/>

                                    <!-- Fiyat + onay: fiyat kutusu satırın
                                         kalanını alıyor, düğme kendi boyunda. -->
                                    <Grid Margin="{StaticResource OD.Pad.Top4}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 Style="{StaticResource OD.TextBox}"
                                                 Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsActionable}"
                                                 HorizontalContentAlignment="Right"
                                                 ToolTip="Yeni satış fiyatı"/>

                                        <!-- Birim soneki: pencerede "Fiyat" kolon
                                             başlığı vardı, kart listesinde başlık
                                             yok — kutunun ne olduğu buradan
                                             anlaşılıyor. -->
                                        <TextBlock Grid.Column="1" Text="TL"
                                                   Style="{StaticResource OD.Text.Suffix}"/>

                                        <Button Grid.Column="2"
                                                Content="{Binding ActionButtonText}"
                                                Style="{StaticResource OD.Button.Primary}"
                                                Margin="{StaticResource OD.Pad.Left4}"
                                                IsEnabled="{Binding IsActionable}"
                                                Click="OnPromote"/>
                                    </Grid>

                                    <TextBlock Text="{Binding ErrorText}"
                                               Style="{StaticResource OD.Text.Hint}"
                                               Foreground="{StaticResource OD.Brush.Accent}"
                                               TextWrapping="Wrap"
                                               Margin="{StaticResource OD.Pad.Top3}"
                                               Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="Yedek yok"
                       Style="{StaticResource OD.Text.Label}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Rows.Count, RelativeSource={RelativeSource AncestorType=UserControl},
                                            Converter={StaticResource CountToCollapsedConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
