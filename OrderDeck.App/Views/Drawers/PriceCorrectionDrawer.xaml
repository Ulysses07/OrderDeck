<UserControl x:Class="OrderDeck.App.Views.Drawers.PriceCorrectionDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- "Fiyatı düzelt" (sahip kararları K4/K5, 2026-10-12). Pop-up YOK: form
         bu çekmecede, onaylar satır içi. İki görünüm aynı çekmecede:
         · düzenleme — fiyat grupları, yeni fiyat, özet, onay;
         · sonuç — "yeniden basılsın mı?" (varsayılan Evet), eski tutarla istek
           gitmiş kişiler ("düzeltilmiş isteği gönder"), ödemesi alınmışlar.
         Başlık ve kapat çarpısı DrawerHost'un şeridinde. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource OD.Pad.5}">

            <!-- ══ Düzenleme ══════════════════════════════════════════ -->
            <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToCollapsedConverter}}">
                <TextBlock Text="SEÇİMDEKİ FİYATLAR" Style="{StaticResource OD.Text.Micro}"/>
                <ItemsControl ItemsSource="{Binding PriceGroups}" Margin="{StaticResource OD.Pad.Top3}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource OD.CheckBox}"
                                      Margin="{StaticResource OD.Pad.Bottom2}"
                                      IsChecked="{Binding IsChecked}">
                                <TextBlock Text="{Binding Text}" Style="{StaticResource OD.Text.Mono}"/>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Seçimde birden çok fiyat var — yalnız işaretli fiyatlar düzelir."
                           Style="{StaticResource OD.Text.Hint}"
                           Foreground="{StaticResource OD.Brush.Amber}"
                           Visibility="{Binding HasMultiplePrices, Converter={StaticResource BoolToVisibleConverter}}"/>
                <TextBlock Text="Seçimde düzeltilebilir etiket yok (iptal edilmiş, kargo ücreti ya da kargoya verilmiş)."
                           Style="{StaticResource OD.Text.Hint}"
                           Visibility="{Binding HasCorrectable, Converter={StaticResource BoolToCollapsedConverter}}"/>

                <TextBlock Text="YENİ FİYAT" Style="{StaticResource OD.Text.Micro}"
                           Margin="{StaticResource OD.Pad.Top5}"/>
                <Grid Margin="{StaticResource OD.Pad.Top3}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewPriceBox" Grid.Column="0"
                             Style="{StaticResource OD.TextBox}"
                             FontFamily="{StaticResource OD.Font.Mono}"
                             FontSize="{StaticResource OD.Font.F3}"
                             Text="{Binding NewPriceText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="örn: 205 veya 99,50"/>
                    <TextBlock Grid.Column="1" Text="TL" Style="{StaticResource OD.Text.Suffix}"/>
                </Grid>
                <TextBlock Text="{Binding NewPriceError}"
                           Style="{StaticResource OD.Text.Hint}"
                           Foreground="{StaticResource OD.Brush.Accent}"
                           Visibility="{Binding NewPriceError, Converter={StaticResource NullToCollapsedConverter}}"/>

                <TextBlock Text="ÖZET" Style="{StaticResource OD.Text.Micro}"
                           Margin="{StaticResource OD.Pad.Top5}"/>
                <ItemsControl ItemsSource="{Binding Summary}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource OD.Text.Hint}"
                                       Foreground="{StaticResource OD.Brush.Text}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Stok değişmez. Müşteriye &quot;fiyat düzeltildi&quot; bildirimi gitmez; Shopper'daki sipariş yeni fiyatı gösterir."
                           Style="{StaticResource OD.Text.Hint}"/>

                <Border Margin="{StaticResource OD.Pad.Top4}"
                        Padding="{StaticResource OD.Pad.3}"
                        Background="{StaticResource OD.Brush.AmberTint}"
                        BorderBrush="{StaticResource OD.Brush.AmberTintBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OD.Radius.Md}"
                        Visibility="{Binding BlockingMessage, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="{Binding BlockingMessage}" TextWrapping="Wrap"
                               Style="{StaticResource OD.Text.Hint}"
                               Foreground="{StaticResource OD.Brush.Text}"
                               Margin="0"/>
                </Border>

                <Button Content="{Binding ConfirmButtonText}"
                        Style="{StaticResource OD.Button.Primary}"
                        Margin="{StaticResource OD.Pad.Top5}"
                        IsEnabled="{Binding HasCorrectable}"
                        Command="{Binding ConfirmCommand}"/>
            </StackPanel>

            <!-- ══ Sonuç ══════════════════════════════════════════════ -->
            <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibleConverter}}">
                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap"
                           FontSize="{StaticResource OD.Font.F2}"
                           Foreground="{StaticResource OD.Brush.Text}"/>

                <!-- Yeniden baskı sorusu: varsayılan EVET — soru açılınca odak Evet'e geçer, Enter Evet
                     demek. IsDefault KULLANILMAZ: çekmece modal değil, IsDefault Enter'ı bütün pencereye
                     kaydeder; sohbet aramasında basılan Enter etiketleri yeniden basardı (kod arkada). -->
                <Border Margin="{StaticResource OD.Pad.Top4}"
                        Padding="{StaticResource OD.Pad.3}"
                        Background="{StaticResource OD.Brush.InfoTint}"
                        BorderBrush="{StaticResource OD.Brush.InfoTintBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OD.Radius.Md}"
                        Visibility="{Binding IsReprintAsked, Converter={StaticResource BoolToVisibleConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ReprintQuestion}" TextWrapping="Wrap"
                                   Foreground="{StaticResource OD.Brush.Text}"/>
                        <TextBlock Text="Yeni kâğıtta küçük &quot;DÜZELTME&quot; işareti olur; ciro ikinci kez artmaz."
                                   Style="{StaticResource OD.Text.Hint}"/>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource OD.Pad.Top3}">
                            <Button x:Name="ReprintYesButton"
                                    Content="Evet, yeniden bas"
                                    Style="{StaticResource OD.Button.Primary}"
                                    Command="{Binding ReprintCommand}"/>
                            <Button Content="Hayır"
                                    Style="{StaticResource OD.Button.Ghost}"
                                    Margin="{StaticResource OD.Pad.X2}"
                                    Command="{Binding SkipReprintCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding ReprintResult}" TextWrapping="Wrap"
                           Style="{StaticResource OD.Text.Hint}"
                           Visibility="{Binding ReprintResult, Converter={StaticResource NullToCollapsedConverter}}"/>

                <!-- Eski tutarla istek gitmiş kişiler -->
                <StackPanel Margin="{StaticResource OD.Pad.Top5}"
                            Visibility="{Binding HasResendRows, Converter={StaticResource BoolToVisibleConverter}}">
                    <TextBlock Text="ESKİ TUTARLA ÖDEME İSTEĞİ GİTMİŞ" Style="{StaticResource OD.Text.Micro}"/>
                    <ItemsControl ItemsSource="{Binding ResendRows}" Margin="{StaticResource OD.Pad.Top3}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="{StaticResource OD.Pad.Bottom3}">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                               Foreground="{StaticResource OD.Brush.Text}"/>
                                    <TextBlock Text="{Binding OutcomeText}" TextWrapping="Wrap"
                                               Visibility="{Binding OutcomeText, Converter={StaticResource NullToCollapsedConverter}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource OD.Text.Hint}">
                                                <Setter Property="Foreground" Value="{StaticResource OD.Brush.Success}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NeedsManual}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource OD.Brush.Amber}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ResendNote}" TextWrapping="Wrap"
                               Style="{StaticResource OD.Text.Hint}"
                               Visibility="{Binding ResendNote, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <TextBlock Text="Ek soru gerektirenler (birleştirme, telefon, bakiye doğrulanamadı) gönderilmez, &quot;elle bakılmalı&quot; olarak kalır."
                               Style="{StaticResource OD.Text.Hint}"
                               Visibility="{Binding IsResendAvailable, Converter={StaticResource BoolToVisibleConverter}}"/>
                    <Button Content="{Binding ResendButtonText}"
                            Style="{StaticResource OD.Button.Secondary}"
                            Margin="{StaticResource OD.Pad.Top3}"
                            Command="{Binding ResendCommand}"
                            Visibility="{Binding IsResendAvailable, Converter={StaticResource BoolToVisibleConverter}}"/>
                </StackPanel>

                <!-- Ödemesi alınmışlar: otomatik bir şey gitmez, fark gösterilir. -->
                <StackPanel Margin="{StaticResource OD.Pad.Top5}"
                            Visibility="{Binding HasPaidRows, Converter={StaticResource BoolToVisibleConverter}}">
                    <TextBlock Text="ÖDEMESİ ALINMIŞ — OTOMATİK BİR ŞEY GİTMEDİ" Style="{StaticResource OD.Text.Micro}"/>
                    <ItemsControl ItemsSource="{Binding PaidRows}" Margin="{StaticResource OD.Pad.Top3}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                           Foreground="{StaticResource OD.Brush.Text}"
                                           Margin="{StaticResource OD.Pad.Bottom2}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Dekonta ve bakiyeye dokunulmadı; farkı müşteriyle sen çöz."
                               Style="{StaticResource OD.Text.Hint}"/>
                </StackPanel>

                <Button Content="Kapat"
                        Style="{StaticResource OD.Button.Ghost}"
                        HorizontalContentAlignment="Center"
                        Margin="{StaticResource OD.Pad.Top5}"
                        Command="{Binding DoneCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
