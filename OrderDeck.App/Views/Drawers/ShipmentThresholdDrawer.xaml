<UserControl x:Class="OrderDeck.App.Views.Drawers.ShipmentThresholdDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ShipmentThresholdDialog'un (500x320 Window) çekmece karşılığı — spec §6.
         Dekont zincirinin üçüncü ve en derin basamağı: kayıt başarılı olduktan
         sonra kümülatif toplam ücretsiz kargo eşiğini aştıysa açılır.

         Başlıktaki 🎁 emojisi KALDIRILDI (spec §10 "emoji ikon 0"). Yerine
         geometri konmadı: müjdeyi zaten metin ve Success rengi söylüyor,
         üçüncü bir tekrar olurdu.

         Düğmeler alt alta — kardeş çekmeceyle aynı gerekçe, "Beklemeye Devam"
         ile "Evet, Kargolansın" 400px'e yan yana sığmıyor. -->
    <Grid Margin="{StaticResource OD.Pad.5}" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ücretsiz kargo kazanıldı"
                   TextWrapping="Wrap"
                   FontFamily="{StaticResource OD.Font.Sans}"
                   FontSize="{StaticResource OD.Font.F3}"
                   FontWeight="Bold"
                   Foreground="{StaticResource OD.Brush.Success}"/>

        <TextBlock Grid.Row="1" TextWrapping="Wrap"
                   Margin="{StaticResource OD.Pad.Top5}"
                   FontFamily="{StaticResource OD.Font.Sans}"
                   FontSize="{StaticResource OD.Font.F1}"
                   Foreground="{StaticResource OD.Brush.TextDim}">
            <Run Text="Müşteri "/>
            <Run Text="{Binding CustomerDisplay, Mode=OneWay}" FontWeight="Bold"
                 Foreground="{StaticResource OD.Brush.Text}"/>
            <Run Text=" toplam alımı ile ücretsiz kargo eşiğini aştı. Bekleyen tüm etiketleri tek koliyle kargolansın mı?"/>
        </TextBlock>

        <Border Grid.Row="2"
                Margin="{StaticResource OD.Pad.Top5}"
                Padding="{StaticResource OD.Pad.4}"
                Background="{StaticResource OD.Brush.Surface2}"
                BorderBrush="{StaticResource OD.Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource OD.Radius.Md}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource OD.Font.Sans}"/>
                        <Setter Property="FontSize" Value="{StaticResource OD.Font.F1}"/>
                        <Setter Property="Foreground" Value="{StaticResource OD.Brush.TextDim}"/>
                        <Setter Property="Margin" Value="{StaticResource OD.Pad.1}"/>
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Kümülatif toplam"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           HorizontalAlignment="Right" FontWeight="Bold"
                           FontFamily="{StaticResource OD.Font.Mono}"
                           Foreground="{StaticResource OD.Brush.Success}"
                           Text="{Binding CumulativeAmountText}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ücretsiz kargo eşiği"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           HorizontalAlignment="Right"
                           FontFamily="{StaticResource OD.Font.Mono}"
                           Foreground="{StaticResource OD.Brush.Text}"
                           Text="{Binding ThresholdText}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="{StaticResource OD.Pad.Top5}">
            <Button Content="Evet, Kargolansın"
                    Style="{StaticResource OD.Button.Primary}"
                    Click="OnShipNow"
                    ToolTip="Bekleyen tüm etiketler tek kargoda çıksın; müşteriye 'kazandınız' bildirimi gönderilir."/>
            <Button Content="Beklemeye Devam"
                    Style="{StaticResource OD.Button.Secondary}"
                    Margin="{StaticResource OD.Pad.Top5}"
                    Click="OnHold"
                    ToolTip="Kargo bekleyen siparişler arasında kalmaya devam etsin; sonraki dekontta tekrar sorulur."/>
        </StackPanel>
    </Grid>
</UserControl>
