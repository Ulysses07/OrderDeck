<UserControl x:Class="OrderDeck.App.Views.Drawers.InstagramAccountAddDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ig="clr-namespace:OrderDeck.App.Services.Instagram">
    <!-- "Instagram hesabı ekle" (çoklu hesap tasarımı §8.6.1). Başlığı şerit verir.
         Tek seçimli kart listesi; zaten bağlı Sayfalar listede yok, Instagram hesabı
         olmayan Sayfa pasif ve soluk. Kart kalıbı FacebookPagePickerDrawer'ınkiyle aynı. -->
    <UserControl.Resources>
        <Style x:Key="AccountItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="{StaticResource OD.Pad.4}"/>
            <Setter Property="Margin"  Value="{StaticResource OD.Pad.Bottom3}"/>
            <Setter Property="IsEnabled" Value="{Binding CanSelect}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{StaticResource OD.Brush.Surface2}"
                                BorderBrush="{StaticResource OD.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource OD.Radius.Sm}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{StaticResource OD.Brush.BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{StaticResource OD.Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="{StaticResource OD.Pad.5}" VerticalAlignment="Top">
        <TextBlock TextWrapping="Wrap"
                   Style="{StaticResource OD.Text.Label}"
                   Text="{x:Static ig:InstagramSettingsTexts.AddDrawerPrompt}"/>

        <ListBox Style="{StaticResource OD.ListBox}"
                 Background="Transparent"
                 BorderThickness="0"
                 Margin="{StaticResource OD.Pad.Top4}"
                 MaxHeight="360"
                 HorizontalContentAlignment="Stretch"
                 ItemContainerStyle="{StaticResource AccountItem}"
                 ItemsSource="{Binding Options}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap"
                               Foreground="{StaticResource OD.Brush.Text}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Content="{x:Static ig:InstagramSettingsTexts.AddDrawerConfirm}"
                Style="{StaticResource OD.Button.Primary}"
                Margin="{StaticResource OD.Pad.Top5}"
                IsDefault="True"
                Click="OnAccept"/>

        <Button Content="{x:Static ig:InstagramSettingsTexts.AddDrawerCancel}"
                Style="{StaticResource OD.Button.Ghost}"
                HorizontalContentAlignment="Center"
                Margin="{StaticResource OD.Pad.Top4}"
                Click="OnCancel"/>

        <TextBlock Style="{StaticResource OD.Text.Hint}"
                   TextWrapping="Wrap"
                   Margin="{StaticResource OD.Pad.Top5}"
                   Text="{x:Static ig:InstagramSettingsTexts.AddDrawerHelpNotListed}"/>
        <TextBlock Style="{StaticResource OD.Text.Hint}"
                   TextWrapping="Wrap"
                   Text="{x:Static ig:InstagramSettingsTexts.AddDrawerHelpReauthorize}"/>
    </StackPanel>
</UserControl>
