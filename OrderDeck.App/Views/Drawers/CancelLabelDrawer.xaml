<UserControl x:Class="OrderDeck.App.Views.Drawers.CancelLabelDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- CancelLabelDialog'un (380x360 Window) çekmece karşılığı — spec §6.2.
         Müşteri detayının üstüne ikinci seviye olarak açılıyor.

         Pencereden farklar:
         · Başlık ("İptal Sebebi") DÜŞTÜ — DrawerHost'un şeridi veriyor.
         · Sebepler RadioButton olarak KALDI ama görünüm OD.Chip'e geçti;
           kutucuk yerine tam genişlik seçilebilir satır. RadioButton'a
           ToggleButton stili uygulanabiliyor (WPF stil TargetType'ı taban
           tipe izin verir), böylece tek-seçim davranışı bedava geliyor.
         · "Vazgeç" KALDI: bu bir onay çekmecesi, ESC ile aynı işi yapan
           görünür bir çıkış lazım (ShipmentDirectiveDrawer ile aynı kalıp). -->
    <Grid Margin="{StaticResource OD.Pad.5}" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style x:Key="Reason" TargetType="RadioButton"
                   BasedOn="{StaticResource OD.Chip}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Margin" Value="{StaticResource OD.Pad.Top3}"/>
            </Style>
        </Grid.Resources>

        <TextBlock Grid.Row="0"
                   Text="Bu etiketleri neden iptal ediyorsun?"
                   TextWrapping="Wrap"
                   Style="{StaticResource OD.Text.Label}"/>

        <StackPanel Grid.Row="1" Margin="{StaticResource OD.Pad.Top4}">
            <RadioButton x:Name="ReasonCustomer"     GroupName="Reason"
                         Style="{StaticResource Reason}"
                         Content="Müşteri vazgeçti" IsChecked="True"/>
            <RadioButton x:Name="ReasonWrongProduct" GroupName="Reason"
                         Style="{StaticResource Reason}"
                         Content="Yanlış ürün / fiyat"/>
            <RadioButton x:Name="ReasonDuplicate"    GroupName="Reason"
                         Style="{StaticResource Reason}"
                         Content="Mükerrer kayıt"/>
            <RadioButton x:Name="ReasonOutOfStock"   GroupName="Reason"
                         Style="{StaticResource Reason}"
                         Content="Stok kalmadı"/>
            <RadioButton x:Name="ReasonCustom"       GroupName="Reason"
                         Style="{StaticResource Reason}"
                         Content="Özel sebep"/>
        </StackPanel>

        <TextBox Grid.Row="2" x:Name="CustomReasonText"
                 Style="{StaticResource OD.TextBox}"
                 Margin="{StaticResource OD.Pad.Top3}"
                 IsEnabled="{Binding IsChecked, ElementName=ReasonCustom}"
                 MaxLength="120"
                 Tag="Özel sebebi yaz…"
                 ToolTip="Özel sebebi yaz"/>

        <TextBlock Grid.Row="3" x:Name="WarningText"
                   Style="{StaticResource OD.Text.Hint}"
                   Foreground="{StaticResource OD.Brush.Accent}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="{StaticResource OD.Pad.Top3}"/>

        <StackPanel Grid.Row="4" Margin="{StaticResource OD.Pad.Top5}">
            <Button Content="İptal Et"
                    Style="{StaticResource OD.Button.Primary}"
                    Click="OnConfirm"/>
            <Button Content="Vazgeç"
                    Style="{StaticResource OD.Button.Ghost}"
                    HorizontalContentAlignment="Center"
                    Margin="{StaticResource OD.Pad.Top4}"
                    Click="OnCancel"/>
        </StackPanel>
    </Grid>
</UserControl>
