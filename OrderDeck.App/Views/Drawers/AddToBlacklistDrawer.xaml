<UserControl x:Class="OrderDeck.App.Views.Drawers.AddToBlacklistDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- AddToBlacklistDialog'un (420x300 Window) çekmece karşılığı — spec §6.2.
         Üç yerden açılıyor: sohbet satırı, kuyruk satırı (ikisi de Prefilled)
         ve kara liste sayfasının "Elle ekle" düğmesi (Manual).

         Pencereden farklar:
         · Başlık ("Kara Listeye Al") DÜŞTÜ — şerit veriyor.
         · #FF1A1A1A hardcoded arka plan DÜŞTÜ (spec §10: hex 0).
         · Etiketler sola ayrılmış 100px sütundan çıkıp alanların ÜSTÜNE
           taşındı: 400px'te iki sütun kutulara yer bırakmıyor.
         · Boş kullanıcı adı uyarısı MessageBox değil, satır içi metin —
           çekmecenin üstüne pop-up açmak spec §6'ya aykırı. -->
    <StackPanel Margin="{StaticResource OD.Pad.5}" VerticalAlignment="Top">
        <TextBlock Text="PLATFORM" Style="{StaticResource OD.Text.Micro}"/>
        <ComboBox x:Name="PlatformBox"
                  Style="{StaticResource OD.ComboBox}"
                  ItemContainerStyle="{StaticResource OD.ComboBoxItem}"
                  Margin="{StaticResource OD.Pad.Top3}">
            <ComboBoxItem Content="instagram"/>
            <ComboBoxItem Content="tiktok"/>
            <ComboBoxItem Content="facebook"/>
            <ComboBoxItem Content="youtube"/>
        </ComboBox>

        <TextBlock Text="KULLANICI ADI" Style="{StaticResource OD.Text.Micro}"
                   Margin="{StaticResource OD.Pad.Top5}"/>
        <TextBox x:Name="UsernameBox"
                 Style="{StaticResource OD.TextBox}"
                 Margin="{StaticResource OD.Pad.Top3}"/>

        <TextBlock Text="SEBEP (OPSİYONEL)" Style="{StaticResource OD.Text.Micro}"
                   Margin="{StaticResource OD.Pad.Top5}"/>
        <TextBox x:Name="ReasonBox"
                 Style="{StaticResource OD.TextBox}"
                 Margin="{StaticResource OD.Pad.Top3}"
                 Tag="ör. sürekli sipariş iptali"/>

        <TextBlock x:Name="WarningText"
                   Style="{StaticResource OD.Text.Hint}"
                   Foreground="{StaticResource OD.Brush.Accent}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="{StaticResource OD.Pad.Top3}"/>

        <Button Content="Kara Listeye Al"
                Style="{StaticResource OD.Button.Primary}"
                Margin="{StaticResource OD.Pad.Top5}"
                IsDefault="True"
                Click="OnSave"/>

        <Button Content="İptal"
                Style="{StaticResource OD.Button.Ghost}"
                HorizontalContentAlignment="Center"
                Margin="{StaticResource OD.Pad.Top4}"
                Click="OnCancel"/>
    </StackPanel>
</UserControl>
