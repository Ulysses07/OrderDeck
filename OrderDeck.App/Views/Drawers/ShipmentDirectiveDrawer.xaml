<UserControl x:Class="OrderDeck.App.Views.Drawers.ShipmentDirectiveDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ShipmentDirectiveDialog'un (480x380 Window) çekmece karşılığı — spec §6.
         Dekont zincirinin ikinci basamağı: matcher kargo ücretinin eksik
         olduğunu görünce açılır. Bağlanan ViewModel değişmedi.

         Üste yaslı, MessageDrawer ile aynı gerekçe: çekmece tam boy, satır "*"
         yapılsaydı düğmeler metinden yüzlerce piksel aşağıda kalırdı.

         Düğmeler ALT ALTA. Pencerede üçü yan yanaydı; "Kargo Beklesin" ve
         "Alıcı Ödemeli" 400px'e yan yana sığmıyor. Dikey dizilim ayrıca
         okuma sırasını da düzeltiyor: iki gerçek seçenek önce, vazgeç en
         altta. -->
    <Grid Margin="{StaticResource OD.Pad.5}" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Müşteri kargo ücretini iletmemiş"
                   TextWrapping="Wrap"
                   FontFamily="{StaticResource OD.Font.Sans}"
                   FontSize="{StaticResource OD.Font.F2}"
                   FontWeight="Bold"
                   Foreground="{StaticResource OD.Brush.Amber}"/>

        <TextBlock Grid.Row="1" TextWrapping="Wrap"
                   Margin="{StaticResource OD.Pad.Top5}"
                   FontFamily="{StaticResource OD.Font.Sans}"
                   FontSize="{StaticResource OD.Font.F1}"
                   Foreground="{StaticResource OD.Brush.TextDim}"
                   Text="Dekont tutarı sadece ürün toplamı kadar; kargo ücreti dekonta dahil değil. Kargo nasıl yönlendirilsin?"/>

        <!-- Tutar dökümü. İki sütun: etiket solda, rakam sağda ve mono —
             rakamlar alt alta hizalansın. -->
        <Border Grid.Row="2"
                Margin="{StaticResource OD.Pad.Top5}"
                Padding="{StaticResource OD.Pad.4}"
                Background="{StaticResource OD.Brush.Surface2}"
                BorderBrush="{StaticResource OD.Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource OD.Radius.Md}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource OD.Font.Sans}"/>
                        <Setter Property="FontSize" Value="{StaticResource OD.Font.F1}"/>
                        <Setter Property="Foreground" Value="{StaticResource OD.Brush.TextDim}"/>
                        <Setter Property="Margin" Value="{StaticResource OD.Pad.1}"/>
                    </Style>
                    <Style x:Key="Num" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="FontFamily" Value="{StaticResource OD.Font.Mono}"/>
                        <Setter Property="Foreground" Value="{StaticResource OD.Brush.Text}"/>
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ürün toplamı"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Num}"
                           Text="{Binding ProductTotalText}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Kargo ücreti"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Num}"
                           Text="{Binding ShippingFeeText}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Beklenen toplam"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Num}"
                           FontWeight="Bold" Text="{Binding ExpectedAmountText}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Dekontta görülen"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Num}"
                           Text="{Binding DekontAmountText}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="{StaticResource OD.Pad.Top5}">
            <Button Content="Alıcı Ödemeli"
                    Style="{StaticResource OD.Button.Primary}"
                    Click="OnRecipientPays"
                    ToolTip="Kargo şirketi alıcıdan tahsil edecek; etikette belirgin işaret olur."/>
            <Button Content="Kargo Beklesin"
                    Style="{StaticResource OD.Button.Secondary}"
                    Margin="{StaticResource OD.Pad.Top5}"
                    Click="OnHold"
                    ToolTip="Kargosu depoda bekler; sonraki yayında toplam eşiği geçince kargolanır."/>
            <!-- Vazgeç iki gerçek seçeneğin ağırlığını taşımamalı, o yüzden
                 Ghost kaldı; ama üstündeki ikisi ortalıyken sola yaslı durması
                 hizayı bozuyordu (Ghost'un kendi kalıbı nav öğesi). -->
            <Button Content="Vazgeç"
                    Style="{StaticResource OD.Button.Ghost}"
                    HorizontalContentAlignment="Center"
                    Margin="{StaticResource OD.Pad.Top5}"
                    Click="OnCancel"/>
        </StackPanel>
    </Grid>
</UserControl>
