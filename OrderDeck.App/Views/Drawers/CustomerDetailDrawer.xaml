<UserControl x:Class="OrderDeck.App.Views.Drawers.CustomerDetailDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- CustomerDetailDialog'un (720x600 Window) çekmece karşılığı — spec §6.2.
         Yayın sırasında sohbetten/kuyruktan açılıyor, o yüzden sayfa değil
         çekmece: sohbet solda görünür kalmalı.

         720 → 400px iki yapısal değişiklik zorladı:
         · Yatay TabControl 5 sekmeyi tek satıra sığdıramıyor → başlıklar
           WrapPanel'e alındı ve OD.Chip görünümüne çevrildi. OD.Nav.Tabs
           kullanılamadı: o 224px'lik SOL RAY, SettingsPage için yazıldı.
         · Etiket / çekiliş / bakiye DataGrid'leri (4-6 kolon) kart listesine
           döndü. Kolon başlığı yok, her satır kendi etiketini taşıyor.
           Çok seçim DataGrid'den ListBox'a taşındı (SelectionMode=Extended),
           iptal/geri-al akışı aynen çalışıyor.

         Ayrıca: başlık ve "Kapat" düğmesi DÜŞTÜ (DrawerHost'un şeridi
         veriyor), emoji ikonlar (📦 💰 🚫) metin etiketlere çevrildi
         (spec §10). -->
    <UserControl.Resources>
        <!-- Dar sekme: OD.Chip'in TabItem karşılığı. Yerel, çünkü tek burada
             tüketiliyor (spec §9: stiller tüketildikleri fazda yazılır). -->
        <Style x:Key="NarrowTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource OD.Brush.TextDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource OD.Font.Sans}"/>
            <Setter Property="FontSize"   Value="{StaticResource OD.Font.F0}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding"    Value="{StaticResource OD.Pad.3}"/>
            <Setter Property="Margin"     Value="{StaticResource OD.Pad.1}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{StaticResource OD.Brush.Surface2}"
                                BorderBrush="{StaticResource OD.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource OD.Radius.Sm}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground"
                                        Value="{StaticResource OD.Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{StaticResource OD.Brush.Accent}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource OD.Brush.AccentHot}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sekme başlıkları WrapPanel'de: 5 başlık 400px'e iki satırda
             yerleşiyor. TabControl'ün gövdesi çerçevesiz. -->
        <Style x:Key="NarrowTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource NarrowTab}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" IsItemsHost="True"/>
                            <ContentPresenter Grid.Row="1"
                                              x:Name="PART_SelectedContentHost"
                                              Margin="{StaticResource OD.Pad.Top4}"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kart listesi kabı: DataGrid'in yerini alan ListBox'ların ortak
             görünümü. Satır = Surface2 kart. -->
        <Style x:Key="CardList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin"  Value="{StaticResource OD.Pad.1}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{StaticResource OD.Brush.Surface2}"
                                BorderBrush="{StaticResource OD.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource OD.Radius.Md}"
                                Padding="{StaticResource OD.Pad.3}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{StaticResource OD.Brush.BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{StaticResource OD.Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kart içi metin rozeti (kod / durum / platform). -->
        <Style x:Key="RowChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource OD.Radius.Xs}"/>
            <Setter Property="Padding"      Value="{StaticResource OD.Pad.1}"/>
            <Setter Property="Margin"       Value="{StaticResource OD.Pad.X2}"/>
            <Setter Property="Background"   Value="{StaticResource OD.Brush.Surface}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Salt okunur iletişim alanı. TextBlock seçilemediği için TextBox. -->
        <Style x:Key="ReadField" TargetType="TextBox"
               BasedOn="{StaticResource OD.TextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="{StaticResource OD.Pad.Top3}"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Command="ApplicationCommands.Copy"      Header="Kopyala"/>
                        <MenuItem Command="ApplicationCommands.SelectAll" Header="Tümünü Seç"/>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock"
               BasedOn="{StaticResource OD.Text.Micro}">
            <Setter Property="Margin" Value="{StaticResource OD.Pad.Top4}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource OD.Pad.5}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Özet kartı ═══ -->
        <Border Grid.Row="0" Style="{StaticResource OD.Card}">
            <StackPanel>
                <TextBlock Text="{Binding HeaderName}"
                           Style="{StaticResource OD.Text.Title}"
                           TextWrapping="Wrap"/>

                <!-- Bağlı tüm platform kimlikleri (birleşik müşteride birden çok) -->
                <ItemsControl ItemsSource="{Binding Identities}"
                              Margin="{StaticResource OD.Pad.Top3}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RowChip}"
                                    Background="{StaticResource OD.Brush.Surface2}">
                                <TextBlock Text="{Binding}" Style="{StaticResource OD.Text.Micro}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Sayaçlar: emoji yerine etiket + mono rakam, iki sütun. -->
                <Grid Margin="{StaticResource OD.Pad.Top4}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ETİKET" Style="{StaticResource OD.Text.Micro}"/>
                        <TextBlock Text="{Binding TotalLabelsPrinted, Mode=OneWay}"
                                   Style="{StaticResource OD.Text.Mono}"
                                   HorizontalAlignment="Left"
                                   FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="CİRO" Style="{StaticResource OD.Text.Micro}"/>
                        <TextBlock Text="{Binding TotalAmount, Mode=OneWay, StringFormat={}{0:N2} TL}"
                                   Style="{StaticResource OD.Text.Mono}"
                                   HorizontalAlignment="Left"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource OD.Brush.Amber}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource OD.Text.Hint}"
                           Margin="{StaticResource OD.Pad.Top3}">
                    <Run Text="İlk görülme:"/>
                    <Run Text="{Binding FirstSeenLabel, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Style="{StaticResource OD.Text.Hint}">
                    <Run Text="Son görülme:"/>
                    <Run Text="{Binding LastSeenLabel, Mode=OneWay}"/>
                </TextBlock>

                <StackPanel Margin="{StaticResource OD.Pad.Top4}"
                            Visibility="{Binding IsBlacklisted, Converter={StaticResource BoolToVisibleConverter}}">
                    <TextBlock Text="KARA LİSTEDE"
                               Style="{StaticResource OD.Text.Micro}"
                               Foreground="{StaticResource OD.Brush.Accent}"/>
                    <TextBlock Text="{Binding BlacklistReason}"
                               Style="{StaticResource OD.Text.Hint}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding BlacklistedAtLabel}"
                               Style="{StaticResource OD.Text.Hint}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ Bölümler ═══ -->
        <TabControl Grid.Row="1" Style="{StaticResource NarrowTabs}"
                    Margin="{StaticResource OD.Pad.Top5}">

            <!-- ── İletişim (kayıt formundan) ── -->
            <TabItem Header="İletişim"
                     Visibility="{Binding HasContactInfo, Converter={StaticResource BoolToVisibleConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="AD SOYAD" Style="{StaticResource FieldLabel}"
                                   Visibility="{Binding FullName, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <TextBox Text="{Binding FullName, Mode=OneWay}"
                                 Style="{StaticResource ReadField}"
                                 Visibility="{Binding FullName, Converter={StaticResource NullToCollapsedConverter}}"/>

                        <TextBlock Text="TELEFON (WHATSAPP)" Style="{StaticResource FieldLabel}"
                                   Visibility="{Binding Phone, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <TextBox Text="{Binding Phone, Mode=OneWay}"
                                 Style="{StaticResource ReadField}"
                                 Visibility="{Binding Phone, Converter={StaticResource NullToCollapsedConverter}}"/>

                        <TextBlock Text="E-POSTA" Style="{StaticResource FieldLabel}"
                                   Visibility="{Binding Email, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <TextBox Text="{Binding Email, Mode=OneWay}"
                                 Style="{StaticResource ReadField}"
                                 Visibility="{Binding Email, Converter={StaticResource NullToCollapsedConverter}}"/>

                        <TextBlock Text="ADRES" Style="{StaticResource FieldLabel}"
                                   Visibility="{Binding Address, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <TextBox Text="{Binding Address, Mode=OneWay}"
                                 Style="{StaticResource ReadField}"
                                 MinHeight="60" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding Address, Converter={StaticResource NullToCollapsedConverter}}"/>

                        <TextBlock Text="TC KİMLİK NO" Style="{StaticResource FieldLabel}"
                                   Visibility="{Binding Tckn, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <TextBox Text="{Binding Tckn, Mode=OneWay}"
                                 Style="{StaticResource ReadField}"
                                 Visibility="{Binding Tckn, Converter={StaticResource NullToCollapsedConverter}}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Etiket geçmişi ── -->
            <TabItem Header="Etiketler">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Başlık, yayın açıkken "Bu yayındaki etiketler",
                         yayınlar arasında "Tüm etiketler" olur. -->
                    <TextBlock Grid.Row="0" Text="{Binding LabelsSectionTitle}"
                               Style="{StaticResource OD.Text.Micro}"/>

                    <Grid Grid.Row="1" Margin="{StaticResource OD.Pad.Top3}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Seçilenleri İptal Et"
                                Style="{StaticResource OD.Button.Secondary}"
                                Margin="{StaticResource OD.Pad.X2}"
                                Command="{Binding CancelSelectedCommand}"/>
                        <Button Grid.Column="1" Content="İptali Geri Al"
                                Style="{StaticResource OD.Button.Secondary}"
                                Margin="{StaticResource OD.Pad.X2}"
                                Command="{Binding UncancelSelectedCommand}"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="{StaticResource OD.Pad.Top3}">
                        <ListBox x:Name="LabelsList"
                                 Style="{StaticResource CardList}"
                                 ItemContainerStyle="{StaticResource CardItem}"
                                 ItemsSource="{Binding Labels}"
                                 SelectionMode="Extended"
                                 SelectionChanged="OnLabelsSelectionChanged"
                                 ToolTip="Birden fazla seçmek için Ctrl ile tıkla">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Style="{StaticResource OD.Text.Hint}"
                                                       Text="{Binding AddedAt, Converter={StaticResource UnixToDateConverter}, Mode=OneWay}"/>
                                            <TextBlock Grid.Column="1"
                                                       Style="{StaticResource OD.Text.Mono}"
                                                       FontWeight="Bold"
                                                       Text="{Binding Price, Mode=OneWay, StringFormat={}{0:N2} TL}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding MessageText}"
                                                   TextWrapping="Wrap"
                                                   Margin="{StaticResource OD.Pad.Top3}"
                                                   FontFamily="{StaticResource OD.Font.Sans}"
                                                   FontSize="{StaticResource OD.Font.F1}"
                                                   Foreground="{StaticResource OD.Brush.Text}"/>

                                        <WrapPanel Margin="{StaticResource OD.Pad.Top3}">
                                            <Border Style="{StaticResource RowChip}"
                                                    Visibility="{Binding Code, Converter={StaticResource NullToCollapsedConverter}}">
                                                <TextBlock Text="{Binding Code}"
                                                           Style="{StaticResource OD.Text.Micro}"/>
                                            </Border>
                                            <Border Style="{StaticResource RowChip}"
                                                    Visibility="{Binding IsPrinted, Converter={StaticResource BoolToVisibleConverter}}">
                                                <TextBlock Text="Yazdırıldı"
                                                           Style="{StaticResource OD.Text.Micro}"
                                                           Foreground="{StaticResource OD.Brush.Success}"/>
                                            </Border>
                                            <Border Style="{StaticResource RowChip}"
                                                    ToolTip="{Binding CancelReason}"
                                                    Visibility="{Binding IsCancelled, Converter={StaticResource BoolToVisibleConverter}}">
                                                <TextBlock Style="{StaticResource OD.Text.Micro}"
                                                           Foreground="{StaticResource OD.Brush.Accent}">
                                                    <Run Text="İPTAL"/>
                                                    <Run Text="·"/>
                                                    <Run Text="{Binding CancelReason, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Henüz etiket yok"
                                   Style="{StaticResource OD.Text.Label}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Labels.Count, Converter={StaticResource CountToCollapsedConverter}}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── Çekiliş geçmişi ── -->
            <TabItem Header="Çekiliş">
                <Grid>
                    <ListBox Style="{StaticResource CardList}"
                             ItemContainerStyle="{StaticResource CardItem}"
                             ItemsSource="{Binding Giveaways}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Keyword}"
                                               FontFamily="{StaticResource OD.Font.Sans}"
                                               FontSize="{StaticResource OD.Font.F2}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource OD.Brush.Text}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource OD.Text.Hint}"
                                               Text="{Binding EnteredAt, Converter={StaticResource UnixToDateConverter}, Mode=OneWay}"/>
                                    <TextBlock Style="{StaticResource OD.Text.Hint}"
                                               Text="{Binding ., Converter={StaticResource GiveawayParticipationStatusConverter}, Mode=OneWay}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Henüz çekilişe katılmadı"
                               Style="{StaticResource OD.Text.Label}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Giveaways.Count, Converter={StaticResource CountToCollapsedConverter}}"/>
                </Grid>
            </TabItem>

            <!-- ── Bakiye ── -->
            <TabItem Header="Bakiye">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource OD.Card}">
                        <StackPanel>
                            <TextBlock Text="MEVCUT BAKİYE" Style="{StaticResource OD.Text.Micro}"/>
                            <TextBlock Text="{Binding BalanceLabel}"
                                       Style="{StaticResource OD.Text.Mono}"
                                       HorizontalAlignment="Left"
                                       FontSize="{StaticResource OD.Font.F3}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource OD.Brush.Success}"/>
                            <Button Content="Bakiye Ekle"
                                    Style="{StaticResource OD.Button.Primary}"
                                    Margin="{StaticResource OD.Pad.Top4}"
                                    Command="{Binding AddBalanceCommand}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1" Text="{Binding BalanceError}"
                               Style="{StaticResource OD.Text.Hint}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource OD.Pad.Top3}"/>

                    <ListBox Grid.Row="2"
                             Style="{StaticResource CardList}"
                             ItemContainerStyle="{StaticResource CardItem}"
                             ItemsSource="{Binding BalanceTransactions}"
                             Margin="{StaticResource OD.Pad.Top3}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding KindLabel}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="{StaticResource OD.Font.Sans}"
                                                   FontSize="{StaticResource OD.Font.F1}"
                                                   Foreground="{StaticResource OD.Brush.Text}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AmountLabel}"
                                                   FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource OD.Text.Mono}">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource OD.Brush.TextDim}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPositive}" Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource OD.Brush.Success}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Style="{StaticResource OD.Text.Hint}"
                                               Text="{Binding CreatedAtLabel}"/>
                                    <TextBlock Style="{StaticResource OD.Text.Hint}"
                                               TextWrapping="Wrap"
                                               Text="{Binding Reason}"
                                               Visibility="{Binding Reason, Converter={StaticResource NullToCollapsedConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- ── Notlar ── -->
            <TabItem Header="Not">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0"
                             Style="{StaticResource OD.TextBox}"
                             Text="{Binding NotesEdit, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"/>
                    <Button Grid.Row="1" Content="Kaydet"
                            Style="{StaticResource OD.Button.Primary}"
                            Margin="{StaticResource OD.Pad.Top4}"
                            Command="{Binding SaveNotesCommand}"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
