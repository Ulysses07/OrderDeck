<Window x:Class="OrderDeck.App.Views.NewGiveawayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni Çekiliş" Width="760" Height="600" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="#101219" Foreground="#F1F0EC" FontFamily="Segoe UI">
    <!-- Görünüm GiveawayTheme'den (SettingsTheme + amber aksan). Pencere-scope'lu;
         tüm {Binding}/handler'lar eski dialog ile birebir aynı. ÖNEMLİ: root
         attribute'ları literal (StaticResource root-parse tuzağından kaçınmak için). -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/GiveawayTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#101219"
                BorderBrush="{StaticResource S.Line}" BorderThickness="0,0,0,1" Padding="26,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="OrderDeck" FontFamily="{StaticResource S.Font.Display}"
                           FontSize="19" FontWeight="Bold" Foreground="{StaticResource S.Text}"/>
                <Ellipse Width="7" Height="7" Fill="{StaticResource S.Amber}" Margin="12,2,12,0"
                         VerticalAlignment="Center"/>
                <TextBlock Text="Yeni Çekiliş" FontSize="14" Foreground="{StaticResource S.Dim}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="#101219"
                BorderBrush="{StaticResource S.Line}" BorderThickness="0,1,0,0" Padding="26,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding ValidationError}"
                           Foreground="{StaticResource S.Red}" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="300"
                           Visibility="{Binding ValidationError, Converter={StaticResource NullToCollapsedConverter}}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="İptal" Click="OnCancel" IsCancel="True" Margin="0,0,8,0"/>
                    <Button Content="Çekilişi Başlat" Click="OnStart" IsDefault="True"
                            Style="{StaticResource S.PrimaryButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Gövde: form + önizleme -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="282"/>
            </Grid.ColumnDefinitions>

            <!-- Sol form -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="26,24">
                <StackPanel>
                    <!-- Anahtar kelime -->
                    <TextBlock Style="{StaticResource S.FieldLabel}" Text="Anahtar kelime"/>
                    <Grid Margin="0,0,0,16">
                        <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource S.Font.Mono}" Padding="30,8,10,8"/>
                        <TextBlock Text="#" Foreground="{StaticResource S.Amber}"
                                   FontFamily="{StaticResource S.Font.Mono}" FontSize="15"
                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                   HorizontalAlignment="Left" IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Süre -->
                    <TextBlock Style="{StaticResource S.FieldLabel}" Text="Süre"/>
                    <ListBox Style="{StaticResource S.ChipList}" Margin="0,0,0,16"
                             ItemsSource="{Binding DurationOptions}"
                             SelectedItem="{Binding SelectedDuration}">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Kazanan sayısı -->
                    <TextBlock Style="{StaticResource S.FieldLabel}" Text="Kazanan sayısı"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="−" Style="{StaticResource S.StepperBtn}" Click="OnWinnerDec"/>
                        <TextBox Text="{Binding WinnerCount, UpdateSourceTrigger=PropertyChanged}"
                                 Width="72" Margin="8,0" HorizontalContentAlignment="Center"
                                 FontFamily="{StaticResource S.Font.Mono}"/>
                        <Button Content="+" Style="{StaticResource S.StepperBtn}" Click="OnWinnerInc"/>
                    </StackPanel>

                    <!-- Animasyon -->
                    <TextBlock Style="{StaticResource S.FieldLabel}" Text="Animasyon"/>
                    <ComboBox x:Name="AnimCombo" Margin="0,0,16,16" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding AvailableAnimations}"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedAnimationId, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Platform filtresi -->
                    <TextBlock Style="{StaticResource S.FieldLabel}" Text="Platform filtresi"/>
                    <ListBox Style="{StaticResource S.ChipList}" Margin="0,0,0,16"
                             ItemsSource="{Binding PlatformOptions}"
                             SelectedItem="{Binding SelectedPlatform}">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Önceki kazananlar -->
                    <Border Background="{StaticResource S.Panel}" BorderBrush="{StaticResource S.Line}"
                            BorderThickness="1" CornerRadius="11" Padding="14,12">
                        <StackPanel>
                            <CheckBox Content="Önceki kazananları dahil etme"
                                      IsChecked="{Binding PreventRewinning}"/>
                            <TextBlock Style="{StaticResource S.Hint}" Margin="54,4,0,0"
                                       Text="Açıkken, bu yayında daha önce kazananlar tekrar çekilişe girmez."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Sağ canlı önizleme -->
            <Border Grid.Column="1" Background="{StaticResource S.Rail}"
                    BorderBrush="{StaticResource S.Line}" BorderThickness="1,0,0,0">
                <StackPanel Margin="22,24">
                    <Border CornerRadius="999" Padding="9,3" HorizontalAlignment="Left"
                            Background="{DynamicResource S.AccentSoft}">
                        <TextBlock Text="CANLI ÖNİZLEME" FontFamily="{StaticResource S.Font.Mono}"
                                   FontSize="10.5" Foreground="{StaticResource S.Amber}"/>
                    </Border>

                    <!-- Dekoratif çark -->
                    <Grid Width="200" Height="208" Margin="0,18,0,8" HorizontalAlignment="Center">
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="wheelRot"
                                                         Storyboard.TargetProperty="Angle"
                                                         By="1080" Duration="0:0:3" DecelerationRatio="0.75"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                        <Grid Width="200" Height="200" VerticalAlignment="Bottom">
                            <!-- dönen dilimler -->
                            <Canvas Width="200" Height="200">
                                <Canvas.RenderTransform>
                                    <RotateTransform x:Name="wheelRot" CenterX="100" CenterY="100"/>
                                </Canvas.RenderTransform>
                                <Path Fill="#FFB23E" Data="M100,100 L100,12 A88,88 0 0 1 162.2,37.8 Z"/>
                                <Path Fill="#191C27" Data="M100,100 L162.2,37.8 A88,88 0 0 1 188,100 Z"/>
                                <Path Fill="#FF4A38" Data="M100,100 L188,100 A88,88 0 0 1 162.2,162.2 Z"/>
                                <Path Fill="#191C27" Data="M100,100 L162.2,162.2 A88,88 0 0 1 100,188 Z"/>
                                <Path Fill="#FFB23E" Data="M100,100 L100,188 A88,88 0 0 1 37.8,162.2 Z"/>
                                <Path Fill="#191C27" Data="M100,100 L37.8,162.2 A88,88 0 0 1 12,100 Z"/>
                                <Path Fill="#FF4A38" Data="M100,100 L12,100 A88,88 0 0 1 37.8,37.8 Z"/>
                                <Path Fill="#191C27" Data="M100,100 L37.8,37.8 A88,88 0 0 1 100,12 Z"/>
                                <Ellipse Width="180" Height="180" Canvas.Left="10" Canvas.Top="10"
                                         Stroke="#1FFFFFFF" StrokeThickness="1"/>
                            </Canvas>
                            <!-- sabit hub -->
                            <Ellipse Width="58" Height="58" Fill="#0D0E14" Stroke="{StaticResource S.Amber}"
                                     StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="ÇEVİR" FontFamily="{StaticResource S.Font.Mono}" FontSize="12"
                                       FontWeight="Bold" Foreground="{StaticResource S.Amber}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- sabit işaretçi (üstte) -->
                        <Path Fill="{StaticResource S.Amber}" VerticalAlignment="Top" HorizontalAlignment="Center"
                              Data="M0,0 L16,0 L8,16 Z"/>
                    </Grid>

                    <!-- Özet -->
                    <Border Background="{StaticResource S.Panel}" BorderBrush="{StaticResource S.Line}"
                            BorderThickness="1" CornerRadius="11" Padding="14,12" Margin="0,8,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Anahtar" Foreground="{StaticResource S.Dim}" FontSize="12.5"/>
                                <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource S.Font.Mono}"
                                           Foreground="{StaticResource S.Amber}" FontSize="12.5">
                                    <Run Text="#"/><Run Text="{Binding Keyword, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Süre" Foreground="{StaticResource S.Dim}" FontSize="12.5"/>
                                <TextBlock Text="{Binding SelectedDuration.Label}" HorizontalAlignment="Right" FontSize="12.5"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Kazanan" Foreground="{StaticResource S.Dim}" FontSize="12.5"/>
                                <TextBlock Text="{Binding WinnerCount}" HorizontalAlignment="Right"
                                           FontFamily="{StaticResource S.Font.Mono}" FontSize="12.5"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Platform" Foreground="{StaticResource S.Dim}" FontSize="12.5"/>
                                <TextBlock Text="{Binding SelectedPlatform.Label}" HorizontalAlignment="Right" FontSize="12.5"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Animasyon" Foreground="{StaticResource S.Dim}" FontSize="12.5"/>
                                <TextBlock Text="{Binding SelectedItem.Name, ElementName=AnimCombo}"
                                           HorizontalAlignment="Right" FontSize="12.5"
                                           TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource S.Hint}" Margin="0,12,0,0"
                               Text="Çarka tıklayıp önizleyebilirsin. Gerçek çekiliş, seçtiğin animasyonla OBS yayın katmanında döner."/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
