<UserControl x:Class="OrderDeck.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OrderDeck.App.Controls">
    <!-- Ayarlar (eski AyarlarDialog penceresi, 561 satır).

         Pencere sürümünden üç şey DÜŞTÜ:

         1. Başlık şeridi ("OrderDeck | Ayarlar") — PageHost'un şeridi
            zaten "Ayarlar" yazıyor, ikinci başlık tekrar olurdu.
         2. "İptal" düğmesi — geri oku (ve ESC) zaten kaydetmeden çıkıyor.
            Aynı işi yapan iki çıkış, ikisinin farklı şey yaptığını
            sandırır. "Kaydet" duruyor: o AYRI bir eylem, çıkış değil.
         3. SettingsTheme.xaml — 434 satırlık, yalnız bu pencereye
            scope'lu ikinci bir renk/stil sözlüğü. Sayfa kabuğun içinde
            yaşadığı için scope numarası anlamsızlaştı; stiller tek
            palete bağlanıp Controls.xaml'e taşındı.

         DataContext SettingsViewModel; PageStack DEĞİL. -->
    <DockPanel>
        <!-- Alt şerit: sayfanın kendi eylem çubuğu. Sabit, kaydırılmıyor —
             on bölmenin hangisinde olursa olsun "Kaydet" aynı yerde. -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource OD.Brush.Surface}"
                BorderBrush="{StaticResource OD.Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="{StaticResource OD.Pad.5}">
            <DockPanel>
                <Button DockPanel.Dock="Left"
                        Content="Logları Aç"
                        Style="{StaticResource OD.Button.Secondary}"
                        Click="OnOpenLogs"
                        ToolTip="Serilog log dosyalarının olduğu klasörü Explorer'da açar"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <!-- Doğrulama hatası kaydetme düğmesinin YANINDA: hata
                         yukarıdaki bir bölmede olsa bile operatör neden
                         kapanmadığını burada görüyor. -->
                    <TextBlock Text="{Binding ValidationError}"
                               Style="{StaticResource OD.Text.Label}"
                               Foreground="{StaticResource OD.Brush.AccentHot}"
                               VerticalAlignment="Center" MaxWidth="360"
                               Margin="{StaticResource OD.Pad.X5}"
                               Visibility="{Binding ValidationError,
                                            Converter={StaticResource NullToCollapsedConverter}}"/>
                    <Button Content="Kaydet"
                            Style="{StaticResource OD.Button.Primary}"
                            Click="OnSave" IsDefault="True"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Style="{StaticResource OD.Nav.Tabs}">
            <!-- ═══ Yazıcı ═══ -->
            <TabItem Header="Yazıcı" Style="{StaticResource OD.Nav.Tab}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OD.Text.Title}" Text="Yazıcı &amp; Çıktı"/>
                    <TextBlock Style="{StaticResource OD.Text.Label}"
                               Margin="{StaticResource OD.Pad.Bottom5}"
                               Text="Termal etiket yazıcısı ve etiket ölçüleri."/>

                    <Border Style="{StaticResource OD.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OD.Text.Section}" Text="Etiket Yazıcısı"/>
                            <TextBlock Style="{StaticResource OD.Text.Label}" Text="Yazıcı"/>
                            <ComboBox Style="{StaticResource OD.ComboBox}"
                                      Margin="{StaticResource OD.Pad.Bottom5}"
                                      ItemsSource="{Binding AvailablePrinters}"
                                      SelectedItem="{Binding SelectedPrinter, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource OD.Text.Label}" Text="Yazı tipi"/>
                            <ComboBox Style="{StaticResource OD.ComboBox}"
                                      ItemsSource="{Binding AvailableFonts}"
                                      SelectedItem="{Binding LabelFontFamily, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OD.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OD.Text.Section}" Text="Etiket Ölçüleri"/>
                            <!-- Beş sayı + birim eki. UniformGrid Columns=2:
                                 alanlar kısa, tek sütunda alt alta dizmek
                                 kartı gereksiz uzatıyordu. -->
                            <UniformGrid Columns="2">
                                <StackPanel Margin="{StaticResource OD.Pad.Bottom5}">
                                    <TextBlock Style="{StaticResource OD.Text.Label}" Text="Etiket genişliği"/>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="mm"
                                                   Style="{StaticResource OD.Text.Suffix}"/>
                                        <TextBox Style="{StaticResource OD.TextBox}"
                                                 Text="{Binding LabelWidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Margin="{StaticResource OD.Pad.Bottom5}">
                                    <TextBlock Style="{StaticResource OD.Text.Label}" Text="Etiket yüksekliği"/>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="mm"
                                                   Style="{StaticResource OD.Text.Suffix}"/>
                                        <TextBox Style="{StaticResource OD.TextBox}"
                                                 Text="{Binding LabelHeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Margin="{StaticResource OD.Pad.Bottom5}">
                                    <TextBlock Style="{StaticResource OD.Text.Label}" Text="Etiket aralığı"/>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="mm"
                                                   Style="{StaticResource OD.Text.Suffix}"/>
                                        <TextBox Style="{StaticResource OD.TextBox}"
                                                 Text="{Binding LabelGapMm, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                </StackPanel>
                                <!-- Boş hücre: aralık tek başına kalsın,
                                     font ölçüleri alt satırda başlasın. -->
                                <StackPanel/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource OD.Text.Label}" Text="Kullanıcı font"/>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="pt"
                                                   Style="{StaticResource OD.Text.Suffix}"/>
                                        <TextBox Style="{StaticResource OD.TextBox}"
                                                 Text="{Binding LabelUserFontSize, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource OD.Text.Label}" Text="Mesaj font"/>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="pt"
                                                   Style="{StaticResource OD.Text.Suffix}"/>
                                        <TextBox Style="{StaticResource OD.TextBox}"
                                                 Text="{Binding LabelMessageFontSize, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                </StackPanel>
                            </UniformGrid>
                            <Button Content="Test Etiketi Bas"
                                    Style="{StaticResource OD.Button.Secondary}"
                                    Command="{Binding TestPrintCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="{StaticResource OD.Pad.Top5}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ OBS Overlay ═══ -->
            <TabItem Header="OBS Overlay" Style="{StaticResource OD.Nav.Tab}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OD.Text.Title}" Text="OBS Overlay"/>
                    <TextBlock Style="{StaticResource OD.Text.Label}"
                               Margin="{StaticResource OD.Pad.Bottom5}"
                               Text="OBS Browser Source için chat overlay ayarları."/>
                    <Border Style="{StaticResource OD.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OD.Text.Label}" Text="Overlay portu"/>
                            <TextBox Style="{StaticResource OD.TextBox}"
                                     FontFamily="{StaticResource OD.Font.Mono}"
                                     MaxWidth="200" HorizontalAlignment="Left"
                                     Text="{Binding OverlayPort, UpdateSourceTrigger=PropertyChanged}"/>
                            <Border Background="{StaticResource OD.Brush.AmberTint}"
                                    BorderBrush="{StaticResource OD.Brush.AmberTintBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource OD.Radius.Md}"
                                    Padding="{StaticResource OD.Pad.4}"
                                    Margin="{StaticResource OD.Pad.Top4}"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="Port değişikliği için uygulamayı yeniden başlatman gerekir."
                                           Style="{StaticResource OD.Text.Label}"
                                           Foreground="{StaticResource OD.Brush.Amber}"
                                           Margin="0"/>
                            </Border>

                            <TextBlock Style="{StaticResource OD.Text.Label}"
                                       Margin="{StaticResource OD.Pad.Top5}" Text="Chat teması"/>
                            <ComboBox Style="{StaticResource OD.ComboBox}"
                                      MaxWidth="280" HorizontalAlignment="Left"
                                      ItemsSource="{Binding AvailableThemes}"
                                      SelectedItem="{Binding ChatTheme, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ YouTube ═══ -->
            <TabItem Header="YouTube" Style="{StaticResource OD.Nav.Tab}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OD.Text.Title}" Text="YouTube"/>
                    <TextBlock Style="{StaticResource OD.Text.Label}"
                               Margin="{StaticResource OD.Pad.Bottom5}"
                               Text="YouTube canlı yayın sohbetini OrderDeck'e bağla."/>
                    <Border Style="{StaticResource OD.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OD.Text.Section}" Text="YouTube Live Chat"/>
                            <TextBlock Style="{StaticResource OD.Text.Label}"
                                       Text="Kanal Handle (örn. @kullaniciadi)"/>
                            <TextBox Style="{StaticResource OD.TextBox}"
                                     Text="{Binding YouTubeChannelHandle, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource OD.Text.Hint}">
                                Kanal handle'ını yaz (@ ile veya @'sız), ya da tam YouTube Live URL'si yapıştır.
                                OrderDeck yayına başladığında otomatik bağlanır; tarayıcı açık tutmaya gerek yok.
                                Boş bırakırsan YouTube chat takibi devre dışı kalır.
                            </TextBlock>
                            <TextBlock Style="{StaticResource OD.Text.Hint}">
                                Handle yazarsan aktif yayını bulmak için aşağıdan YouTube hesabını bağlaman gerekir.
                                Tam yayın URL'si yapıştırırsan bağlantı gerekmez. Sohbet resmi YouTube API'sinden gelir.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Moderasyon UI: OAuth audit demo kaydı için açıldı (chat sağ-tık
                         menüsündeki YT sil/banla öğeleriyle lockstep). YouTubeOAuthService/
                         YouTubeModerationService uçtan uca çalışır; consent + audit ile
                         kalıcı kullanılır. -->
                    <Border Style="{StaticResource OD.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OD.Text.Section}"
                                       Text="YouTube Moderasyon (mesaj sil / kullanıcı banla)"/>
                            <TextBlock Text="{Binding YouTubeConnectionStatus}"
                                       Style="{StaticResource OD.Text.Label}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OD.Brush.Text}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="YouTube'a Bağlan"
                                        Style="{StaticResource OD.Button.Secondary}"
                                        Command="{Binding ConnectYouTubeCommand}"
                                        IsEnabled="{Binding IsYouTubeIdle}"
                                        Margin="{StaticResource OD.Pad.X2}"/>
                                <Button Content="Bağlantıyı Kaldır"
                                        Style="{StaticResource OD.Button.Secondary}"
                                        Command="{Binding DisconnectYouTubeCommand}"
                                        IsEnabled="{Binding IsYouTubeConnected}"
                                        Margin="{StaticResource OD.Pad.X2}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource OD.Text.Hint}">
                                Bağlandıktan sonra yayın anında chat'te bir mesaja sağ tıklayıp
                                "YouTube'da mesajı sil" veya "YouTube'da kullanıcıyı banla" diyebilirsin.
                                Refresh token bilgisayarında DPAPI ile şifreli saklanır.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ Facebook ═══ -->
            <TabItem Header="Facebook" Style="{StaticResource OD.Nav.Tab}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OD.Text.Title}" Text="Facebook"/>
                    <TextBlock Style="{StaticResource OD.Text.Label}"
                               Margin="{StaticResource OD.Pad.Bottom5}"
                               Text="Facebook Page'ini bağla — canlı yayın yorumları gerçek zamanlı çekilir, moderasyon (sil/banla) menüsü açılır."/>
                    <Border Style="{StaticResource OD.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OD.Text.Section}"
                                       Text="Facebook Live (Page bağla)"/>
                            <TextBlock Text="{Binding FacebookConnectionStatus}"
                                       Style="{StaticResource OD.Text.Label}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OD.Brush.Text}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Facebook'a Bağlan"
                                        Style="{StaticResource OD.Button.Secondary}"
                                        Command="{Binding ConnectFacebookCommand}"
                                        IsEnabled="{Binding IsFacebookIdle}"
                                        Margin="{StaticResource OD.Pad.X2}"/>
                                <Button Content="Bağlantıyı Kaldır"
                                        Style="{StaticResource OD.Button.Secondary}"
                                        Command="{Binding DisconnectFacebookCommand}"
                                        IsEnabled="{Binding IsFacebookConnected}"
                                        Margin="{StaticResource OD.Pad.X2}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource OD.Text.Hint}">
                                Bağlandıktan sonra Page canlı yayın açtığında yorumlar otomatik olarak akmaya başlar — polling yok, anlık push.
                                Page access token bilgisayarında DPAPI ile şifreli saklanır. Birden fazla Page'in varsa bağlanırken seçim sorulur.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OD.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OD.Text.Section}"
                                       Text="Instagram canlı yorumlar"/>
                            <TextBlock Text="{Binding InstagramAccountStatus}"
                                       Style="{StaticResource OD.Text.Label}"
                                       Foreground="{StaticResource OD.Brush.Text}"/>
                            <TextBlock Style="{StaticResource OD.Text.Label}"
                                       Foreground="{StaticResource OD.Brush.Amber}"
                                       Visibility="{Binding InstagramNeedsReconnect,
                                                    Converter={StaticResource BoolToVisibleConverter}}"
                                       Text="Instagram yorumları için Facebook bağlantını yenilemen gerekiyor — yukarıdaki 'Bağlantıyı Kaldır' + 'Facebook'a Bağlan' adımını uygula."/>
                            <CheckBox Content="Instagram yorumlarını resmi API'den al (deneysel)"
                                      Style="{StaticResource OD.Toggle}"
                                      IsChecked="{Binding UseOfficialInstagramApi}"/>
                            <TextBlock Style="{StaticResource OD.Text.Hint}">
                                Kapalıyken yorumlar tarayıcı eklentisinden gelir; yayın sayfasının bir sekmede açık
                                kalması gerekir. Açtığında yorumlar doğrudan Instagram'ın resmi API'sinden okunur,
                                tarayıcı sekmesi gerekmez. Instagram canlı yayında yorum silme/gizleme desteklemediği
                                için resmi yolda sağ-tık moderasyon menüsü çıkmaz.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ Çekiliş Animasyonu ═══ -->
            <TabItem Header="Çekiliş Animasyonu" Style="{StaticResource OD.Nav.Tab}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OD.Text.Title}" Text="Çekiliş Animasyonu"/>
                    <TextBlock Style="{StaticResource OD.Text.Label}"
                               Margin="{StaticResource OD.Pad.Bottom5}"
                               Text="Çekiliş çarkı/animasyonu ve ses ayarları."/>
                    <Border Style="{StaticResource OD.Card}">
                        <controls:AnimationPickerControl DataContext="{Binding AnimationPicker}"/>
                    </Border>
                    <Border Style="{StaticResource OD.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OD.Text.Section}" Text="Ses"/>
                            <StackPanel Orientation="Horizontal"
                                        Margin="{StaticResource OD.Pad.Bottom5}">
                                <TextBlock Text="Ses seviyesi"
                                           Style="{StaticResource OD.Text.Label}"
                                           VerticalAlignment="Center" Margin="0"/>
                                <Slider Style="{StaticResource OD.Slider}"
                                        Minimum="0" Maximum="1" Width="240"
                                        VerticalAlignment="Center"
                                        Margin="{StaticResource OD.Pad.X5}"
                                        Value="{Binding AnimationVolume, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{Binding AnimationVolume, StringFormat={}{0:P0}}"
                                           Style="{StaticResource OD.Text.Suffix}"/>
                            </StackPanel>
                            <CheckBox Content="Sessiz mod (tüm animasyonlar sessiz)"
                                      Style="{StaticResource OD.Toggle}"
                                      IsChecked="{Binding AnimationMuted}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ Ödeme & Kargo ═══ -->
            <TabItem Header="Ödeme &amp; Kargo" Style="{StaticResource OD.Nav.Tab}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OD.Text.Title}" Text="Ödeme &amp; Kargo"/>
                    <TextBlock Style="{StaticResource OD.Text.Label}"
                               Margin="{StaticResource OD.Pad.Bottom5}"
                               Text="WhatsApp ödeme mesajı, banka bilgileri ve kargo eşiği."/>

                    <Border Style="{StaticResource OD.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OD.Text.Section}" Text="WhatsApp Ödeme İsteme"/>
                            <TextBlock Style="{StaticResource OD.Text.Label}" Text="Mesaj Şablonu"/>
                            <TextBox Style="{StaticResource OD.TextBox}"
                                     Text="{Binding PaymentTemplate, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="120" MaxHeight="200"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="{StaticResource OD.Font.Mono}"
                                     FontSize="{StaticResource OD.Font.F1}"/>
                            <TextBlock Style="{StaticResource OD.Text.Hint}">
                                Placeholder: {ad} {tutar} {tarih} {iban} {hesap_sahibi} {papara}
                                <LineBreak/>
                                Kargo: {urun_toplami} · {kargo_ucreti} · {kargo}
                                <LineBreak/>
                                Bakiye: {toplam_oncesi} · {bakiye} · {net_tutar}
                            </TextBlock>

                            <TextBlock Style="{StaticResource OD.Text.Label}"
                                       Margin="{StaticResource OD.Pad.Top5}" Text="IBAN"/>
                            <TextBox Style="{StaticResource OD.TextBox}"
                                     FontFamily="{StaticResource OD.Font.Mono}"
                                     Text="{Binding Iban, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Style="{StaticResource OD.Text.Label}"
                                       Margin="{StaticResource OD.Pad.Top4}" Text="Hesap Sahibi"/>
                            <TextBox Style="{StaticResource OD.TextBox}"
                                     Text="{Binding AccountHolder, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Style="{StaticResource OD.Text.Label}"
                                       Margin="{StaticResource OD.Pad.Top4}"
                                       Text="Papara/Ziraat Numarası (opsiyonel)"/>
                            <TextBox Style="{StaticResource OD.TextBox}"
                                     FontFamily="{StaticResource OD.Font.Mono}"
                                     Text="{Binding Papara, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OD.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OD.Text.Section}" Text="Kargo"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="{StaticResource OD.Pad.X2}">
                                    <TextBlock Style="{StaticResource OD.Text.Label}" Text="Ücretsiz Kargo Eşiği"/>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="₺"
                                                   Style="{StaticResource OD.Text.Suffix}"/>
                                        <TextBox Style="{StaticResource OD.TextBox}"
                                                 Text="{Binding FreeShippingThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Bu tutar ve üzeri siparişlerde kargo ücretsiz. Boş bırak veya 0 yaz = kargo özelliği kapalı."/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Margin="{StaticResource OD.Pad.X2}">
                                    <TextBlock Style="{StaticResource OD.Text.Label}" Text="Sabit Kargo Ücreti"/>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="₺"
                                                   Style="{StaticResource OD.Text.Suffix}"/>
                                        <TextBox Style="{StaticResource OD.TextBox}"
                                                 Text="{Binding ShippingFeeText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Eşik altında otomatik eklenecek kargo ücreti. Desi fark etmez."/>
                                    </DockPanel>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource OD.Text.Hint}">
                                Örnek: 5000 ₺ eşik + 150 ₺ kargo. Müşteri 4.000 ₺ alırsa sipariş kuyruğuna
                                otomatik 150 ₺ kargo satırı eklenir; 5.000 ₺ ve üzeri alırsa kargo ücretsiz.
                                İki alan da boş/0 ise kargo özelliği devre dışıdır.
                            </TextBlock>

                            <TextBlock Style="{StaticResource OD.Text.Label}"
                                       Margin="{StaticResource OD.Pad.Top5}"
                                       Text="Ücretsiz Kargo Kazandın Mesajı"/>
                            <TextBox Style="{StaticResource OD.TextBox}"
                                     Text="{Binding ShippingWonTemplate, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="80" MaxHeight="140"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="{StaticResource OD.Font.Mono}"
                                     FontSize="{StaticResource OD.Font.F1}"
                                     ToolTip="Müşteri kümülatif eşiği aştıktan sonra ShipNow seçildiğinde gönderilen WhatsApp mesajı."/>
                            <TextBlock Style="{StaticResource OD.Text.Hint}"
                                       Text="Placeholder: {ad} {kumulatif_tutar} {tarih}. Boş bırakılırsa mesaj atılmaz."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ Spam Filtresi ═══ -->
            <TabItem Header="Spam Filtresi" Style="{StaticResource OD.Nav.Tab}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OD.Text.Title}" Text="Spam Filtresi"/>
                    <TextBlock Style="{StaticResource OD.Text.Label}"
                               Margin="{StaticResource OD.Pad.Bottom5}"
                               Text="Sohbete düşmeden önce uygulanan kurallar. Sadece açık kurallar uygulanır."/>

                    <Border Style="{StaticResource OD.Card}">
                        <CheckBox Content="Spam filtresi açık"
                                  Style="{StaticResource OD.Toggle}"
                                  FontWeight="SemiBold"
                                  IsChecked="{Binding SpamFilterEnabled}"/>
                    </Border>

                    <Border Style="{StaticResource OD.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OD.Text.Section}" Text="Kurallar"/>
                            <CheckBox Content="Çift mesajları engelle (30 sn içinde aynı yazı)"
                                      Style="{StaticResource OD.Toggle}"
                                      Margin="{StaticResource OD.Pad.Bottom3}"
                                      IsChecked="{Binding SpamDropDuplicates}"/>
                            <CheckBox Content="Link içeren mesajları engelle"
                                      Style="{StaticResource OD.Toggle}"
                                      Margin="{StaticResource OD.Pad.Bottom3}"
                                      IsChecked="{Binding SpamDropLinks}"/>
                            <CheckBox Content="Tamamen büyük harfli (BAĞIRMA) mesajları engelle"
                                      Style="{StaticResource OD.Toggle}"
                                      Margin="{StaticResource OD.Pad.Bottom3}"
                                      IsChecked="{Binding SpamDropAllCaps}"/>
                            <CheckBox Content="Çok kısa mesajları engelle"
                                      Style="{StaticResource OD.Toggle}"
                                      IsChecked="{Binding SpamDropShortMessages}"/>
                            <!-- Alt alan kuralın altında ve ONA bağlı: kural
                                 kapalıyken kutu da kapanıyor, böylece hangi
                                 sayının hangi kurala ait olduğu belli. -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="{StaticResource OD.Pad.Top3}">
                                <TextBlock Text="Minimum karakter"
                                           Style="{StaticResource OD.Text.Label}"
                                           VerticalAlignment="Center" Margin="0"/>
                                <TextBox Width="80"
                                         Style="{StaticResource OD.TextBox}"
                                         Margin="{StaticResource OD.Pad.X5}"
                                         Text="{Binding SpamMinMessageLength, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding SpamDropShortMessages}"/>
                            </StackPanel>
                            <CheckBox Content="Yasaklı kelime içeren mesajları engelle"
                                      Style="{StaticResource OD.Toggle}"
                                      Margin="{StaticResource OD.Pad.Top5}"
                                      IsChecked="{Binding SpamDropProfanity}"/>
                            <TextBlock Style="{StaticResource OD.Text.Label}"
                                       Margin="{StaticResource OD.Pad.Top3}"
                                       Text="Yasaklı kelimeler (virgül ile ayır)"/>
                            <TextBox Style="{StaticResource OD.TextBox}"
                                     IsEnabled="{Binding SpamDropProfanity}"
                                     Text="{Binding SpamBlockedWordsText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="60" MaxHeight="120"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ Form Linki ═══ -->
            <TabItem Header="Form Linki" Style="{StaticResource OD.Nav.Tab}"
                     DataContext="{Binding IntakeForm}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OD.Text.Title}" Text="Müşteri Bilgi Formu"/>
                    <TextBlock Style="{StaticResource OD.Text.Label}"
                               Margin="{StaticResource OD.Pad.Bottom5}"
                               Text="Müşterilerin form doldurup WhatsApp'tan sana mesaj göndermesi için kalıcı bir link."/>
                    <Border Style="{StaticResource OD.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OD.Text.Label}" Text="Slug (URL'in son parçası)"/>
                            <TextBox Style="{StaticResource OD.TextBox}"
                                     FontFamily="{StaticResource OD.Font.Mono}"
                                     Text="{Binding Slug, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Sadece küçük harf, rakam, tire. 3-32 karakter."/>
                            <TextBlock Style="{StaticResource OD.Text.Hint}"
                                       Text="Örnek: 'burakstreamer' → https://orderdeckapp.com/musteri-kayit/burakstreamer"/>

                            <TextBlock Style="{StaticResource OD.Text.Label}"
                                       Margin="{StaticResource OD.Pad.Top5}"
                                       Text="WhatsApp telefon (E.164 formatı)"/>
                            <TextBox Style="{StaticResource OD.TextBox}"
                                     FontFamily="{StaticResource OD.Font.Mono}"
                                     Text="{Binding WhatsAppPhone, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource OD.Text.Hint}"
                                       Text="Örnek: +905551234567 (başında + ve ülke kodu olmalı)"/>

                            <TextBlock Style="{StaticResource OD.Text.Label}"
                                       Margin="{StaticResource OD.Pad.Top5}"
                                       Text="Form başlığı (opsiyonel)"/>
                            <TextBox Style="{StaticResource OD.TextBox}"
                                     Text="{Binding CustomTitle, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Form sayfasının üstünde görünür. Boş bırakılırsa 'Bilgi Gönder'."/>

                            <CheckBox Content="Form aktif (kapatırsan link 410 Gone döner)"
                                      Style="{StaticResource OD.Toggle}"
                                      Margin="{StaticResource OD.Pad.Top5}"
                                      IsChecked="{Binding IsActive}"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="{StaticResource OD.Pad.Top5}">
                                <Button Content="Kaydet" MinWidth="100"
                                        Style="{StaticResource OD.Button.Primary}"
                                        Command="{Binding SaveCommand}"
                                        Margin="{StaticResource OD.Pad.X2}"/>
                                <Button Content="Linki Kopyala" MinWidth="120"
                                        Style="{StaticResource OD.Button.Secondary}"
                                        Command="{Binding CopyLinkCommand}"
                                        Margin="{StaticResource OD.Pad.X2}"/>
                            </StackPanel>

                            <Border Background="{StaticResource OD.Brush.Surface2}"
                                    BorderBrush="{StaticResource OD.Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource OD.Radius.Md}"
                                    Padding="{StaticResource OD.Pad.4}"
                                    Margin="{StaticResource OD.Pad.Top5}"
                                    Visibility="{Binding HasFormUrl,
                                                 Converter={StaticResource BoolToVisibleConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Linkin" Style="{StaticResource OD.Text.Label}"/>
                                    <TextBlock Text="{Binding FormUrl}"
                                               Style="{StaticResource OD.Text.Mono}"
                                               FontSize="{StaticResource OD.Font.F1}"
                                               Foreground="{StaticResource OD.Brush.Amber}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding StatusMessage}"
                                       Style="{StaticResource OD.Text.Label}"
                                       Foreground="{Binding StatusBrush}"
                                       Margin="{StaticResource OD.Pad.Top4}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ Müşteri App ═══ -->
            <TabItem Header="Müşteri App" Style="{StaticResource OD.Nav.Tab}"
                     DataContext="{Binding ShopperApp}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OD.Text.Title}" Text="Müşteri Uygulaması"/>
                    <TextBlock Style="{StaticResource OD.Text.Label}"
                               Margin="{StaticResource OD.Pad.Bottom5}"
                               Text="Müşterilerine paylaşacağın yayıncı kodu. Müşteri app'ten bu kodu girip seni takip eder."/>
                    <Border Style="{StaticResource OD.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OD.Text.Label}" Text="Yayıncı kodu"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Kaydet"
                                        Style="{StaticResource OD.Button.Primary}"
                                        Margin="{StaticResource OD.Pad.Left4}"
                                        IsEnabled="{Binding CanEditCode}"
                                        Command="{Binding SaveCommand}"/>
                                <TextBox Style="{StaticResource OD.TextBox}"
                                         Text="{Binding CodeInput, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="20" IsEnabled="{Binding CanEditCode}"
                                         CharacterCasing="Lower"
                                         FontFamily="{StaticResource OD.Font.Mono}"
                                         ToolTip="3-20 karakter, küçük harf ve rakam (örn. royal, mezat42)"/>
                            </DockPanel>

                            <TextBlock Style="{StaticResource OD.Text.Label}"
                                       Margin="{StaticResource OD.Pad.Top4}"
                                       Foreground="{StaticResource OD.Brush.AccentHot}"
                                       Text="{Binding ErrorMessage}"
                                       Visibility="{Binding ErrorMessage,
                                                    Converter={StaticResource NullToCollapsedConverter}}"/>
                            <TextBlock Style="{StaticResource OD.Text.Label}"
                                       Margin="{StaticResource OD.Pad.Top4}"
                                       Foreground="{StaticResource OD.Brush.Success}"
                                       Text="{Binding StatusMessage}"
                                       Visibility="{Binding StatusMessage,
                                                    Converter={StaticResource NullToCollapsedConverter}}"/>
                            <TextBlock Style="{StaticResource OD.Text.Label}"
                                       Margin="{StaticResource OD.Pad.Top4}"
                                       Text="{Binding CooldownMessage}"
                                       Visibility="{Binding CooldownMessage,
                                                    Converter={StaticResource NullToCollapsedConverter}}"/>

                            <TextBlock Style="{StaticResource OD.Text.Section}"
                                       Margin="{StaticResource OD.Pad.Top6}" Text="Kurallar"/>
                            <TextBlock Style="{StaticResource OD.Text.Hint}" Margin="0"
                                       Text="• 3-20 karakter, sadece a-z ve 0-9"/>
                            <TextBlock Style="{StaticResource OD.Text.Hint}"
                                       Text="• Bir kere belirlenince 7 gün boyunca değiştirilemez"/>
                            <TextBlock Style="{StaticResource OD.Text.Hint}"
                                       Text="• Bu kod sistemde tektir — başka yayıncı kullanıyorsa farklı bir kod seç"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ Kısayollar ═══ -->
            <TabItem Header="Kısayollar" Style="{StaticResource OD.Nav.Tab}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OD.Text.Title}" Text="Kısayollar"/>
                    <TextBlock Style="{StaticResource OD.Text.Label}"
                               Margin="{StaticResource OD.Pad.Bottom5}"
                               Text="Klavye kısayollarını özelleştir."/>
                    <Border Style="{StaticResource OD.Card}">
                        <StackPanel>
                            <CheckBox Content="Özel kısayolları kullan"
                                      Style="{StaticResource OD.Toggle}"
                                      Margin="{StaticResource OD.Pad.Bottom5}"
                                      IsChecked="{Binding ShortcutsTab.UseCustom}"/>
                            <ItemsControl ItemsSource="{Binding ShortcutsTab.Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="{StaticResource OD.Pad.1}">
                                            <!-- Ata sayfa üzerinden bağlanıyor: satırın
                                                 DataContext'i kısayolun kendisi, "özel
                                                 kısayollar açık mı" bilgisi sayfada.
                                                 Pencere sürümünde AncestorType=Window
                                                 yazıyordu — sayfada Window yok, o zincir
                                                 sessizce kopardı ve düğmeler hep açık
                                                 kalırdı. -->
                                            <controls:ShortcutCaptureButton
                                                DockPanel.Dock="Right" Width="220"
                                                Chord="{Binding Chord, Mode=TwoWay}"
                                                IsEnabled="{Binding DataContext.ShortcutsTab.UseCustom,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Style="{StaticResource OD.Text.Label}"
                                                       VerticalAlignment="Center" Margin="0"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal"
                                        Margin="{StaticResource OD.Pad.Top5}">
                                <Button Content="Kaydet"
                                        Style="{StaticResource OD.Button.Primary}"
                                        Command="{Binding ShortcutsTab.SaveCommand}"
                                        Margin="{StaticResource OD.Pad.X2}"/>
                                <!-- Yıkıcı eylem: ayrı bir stil değil, ikincil
                                     düğme + sıcak aksan yazı. Kara Liste
                                     sayfasındaki "Çıkar" ile aynı kalıp. -->
                                <Button Content="Varsayılana Sıfırla"
                                        Style="{StaticResource OD.Button.Secondary}"
                                        Foreground="{StaticResource OD.Brush.AccentHot}"
                                        Command="{Binding ShortcutsTab.ResetToDefaultsCommand}"
                                        Margin="{StaticResource OD.Pad.X2}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
