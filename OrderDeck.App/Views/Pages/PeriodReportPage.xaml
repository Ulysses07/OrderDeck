<UserControl x:Class="OrderDeck.App.Views.Pages.PeriodReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- PeriodReportDialog'un (1000x700 Window) sayfa karşılığı — spec §6.1.
         Pencere sürümündeki "arka planı BURADA vermek zorundayız" notu düştü:
         sayfanın zemini PageHost'un, örtük Window stili sorunu ortadan kalktı.

         Faz 2b'de yazılan OD.DatePicker stilinin İLK tüketicisi burası
         (spec §9: stil tüketildiği fazda değerini kanıtlar). -->
    <Grid Margin="{StaticResource OD.Pad.7}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap"
                   Foreground="{StaticResource OD.Brush.TextDim}"
                   FontSize="{StaticResource OD.Font.F1}"
                   Text="Seçilen tarih aralığında basılmış (iptal edilmemiş) siparişler kişi bazında toplanır; aynı kişinin farklı platform hesapları birleştirilir. Excel iki sayfa çıkar: e-Fatura (entegratöre yüklenecek, kişi × gün — fatura günlük kesilir) ve Detay (kontrol listesi)."/>

        <!-- Filtre çubuğu -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    Margin="{StaticResource OD.Pad.Top5}">
            <TextBlock Text="BAŞLANGIÇ" Style="{StaticResource OD.Text.Micro}"
                       VerticalAlignment="Center"/>
            <DatePicker SelectedDate="{Binding FromDate}"
                        Style="{StaticResource OD.DatePicker}"
                        Width="140" Margin="{StaticResource OD.Pad.X2}"/>

            <TextBlock Text="BİTİŞ" Style="{StaticResource OD.Text.Micro}"
                       VerticalAlignment="Center"
                       Margin="{StaticResource OD.Pad.X5}"/>
            <DatePicker SelectedDate="{Binding ToDate}"
                        Style="{StaticResource OD.DatePicker}"
                        Width="140" Margin="{StaticResource OD.Pad.X2}"/>

            <Button Content="Raporu Oluştur"
                    Style="{StaticResource OD.Button.Primary}"
                    Margin="{StaticResource OD.Pad.X5}"
                    Command="{Binding LoadCommand}"/>

            <CheckBox Content="Yalnızca adı bilinenler"
                      Style="{StaticResource OD.CheckBox}"
                      IsChecked="{Binding OnlyInvoiceReady}"
                      VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="{StaticResource OD.Pad.Top5}">
            <!-- e-Fatura şablon alanları: her satırda aynı olan sabitler +
                 numara sayacı. Değerler ayarlarda saklanır, dışa aktarımdan
                 sonra sayaç otomatik ilerler. -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="FATURA NO ÖNEKİ" Style="{StaticResource OD.Text.Micro}"
                           VerticalAlignment="Center"/>
                <TextBox Text="{Binding NumberPrefix, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource OD.TextBox}"
                         Width="80" Margin="{StaticResource OD.Pad.X2}"
                         ToolTip="Örn. RMK. Boş bırakılırsa fatura numarası sütunu boş gider."/>

                <TextBlock Text="BAŞLANGIÇ NO" Style="{StaticResource OD.Text.Micro}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource OD.Pad.X5}"/>
                <TextBox Text="{Binding NextNumberText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource OD.TextBox}"
                         FontFamily="{StaticResource OD.Font.Mono}"
                         Width="160" Margin="{StaticResource OD.Pad.X2}"
                         ToolTip="Örn. 2026000000602. Her satırda 1 artar, 12 haneye sıfırla tamamlanır."/>

                <TextBlock Text="MAL/HİZMET" Style="{StaticResource OD.Text.Micro}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource OD.Pad.X5}"/>
                <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource OD.TextBox}"
                         Width="220" Margin="{StaticResource OD.Pad.X2}"/>

                <TextBlock Text="KDV %" Style="{StaticResource OD.Text.Micro}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource OD.Pad.X5}"/>
                <TextBox Text="{Binding VatRate, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource OD.TextBox}"
                         Width="60" Margin="{StaticResource OD.Pad.X2}"/>
            </StackPanel>

            <TextBlock TextWrapping="Wrap"
                       Margin="{StaticResource OD.Pad.Top3}"
                       Foreground="{StaticResource OD.Brush.TextDim}">
                <Run Text="{Binding PersonCount, Mode=OneWay}" FontWeight="Bold"
                     Foreground="{StaticResource OD.Brush.Text}"/>
                <Run Text=" kişi · "/>
                <Run Text="{Binding CompleteCount, Mode=OneWay}" FontWeight="Bold"
                     Foreground="{StaticResource OD.Brush.Success}"/>
                <Run Text=" adı var / "/>
                <Run Text="{Binding MissingCount, Mode=OneWay}" FontWeight="Bold"
                     Foreground="{StaticResource OD.Brush.AccentHot}"/>
                <Run Text=" adı yok · "/>
                <Run Text="{Binding OrderCount, Mode=OneWay}" FontWeight="Bold"
                     Foreground="{StaticResource OD.Brush.Text}"/>
                <Run Text=" sipariş · "/>
                <Run Text="{Binding TotalAmount, Mode=OneWay, StringFormat={}{0:N2} TL}"
                     FontWeight="Bold" Foreground="{StaticResource OD.Brush.Amber}"/>
                <Run Text=" · "/>
                <Run Text="{Binding InvoiceCount, Mode=OneWay}" FontWeight="Bold"
                     Foreground="{StaticResource OD.Brush.Text}"/>
                <Run Text=" e-Fatura satırı"/>
            </TextBlock>
        </StackPanel>

        <DataGrid Grid.Row="3"
                  Style="{StaticResource OD.DataGrid}"
                  Margin="{StaticResource OD.Pad.Top5}"
                  ItemsSource="{Binding People}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding DisplayLabel}" Width="1.6*"/>
                <DataGridTextColumn Header="TCKN"     Binding="{Binding Tckn}"        Width="*"/>
                <DataGridTextColumn Header="Telefon"  Binding="{Binding Phone}"       Width="*"/>
                <DataGridTextColumn Header="Adres"    Binding="{Binding AddressLine}" Width="2*"/>
                <DataGridTextColumn Header="Hesaplar" Binding="{Binding Accounts}"    Width="1.6*"/>
                <DataGridTextColumn Header="Gün"      Binding="{Binding DayCount}"    Width="50"/>
                <DataGridTextColumn Header="Sipariş"  Binding="{Binding OrderCount}"  Width="70"/>
                <DataGridTextColumn Header="Tutar"
                                    Binding="{Binding TotalAmount, StringFormat={}{0:N2} TL}"
                                    Width="110"/>
                <DataGridTextColumn Header="Fatura"
                                    Binding="{Binding InvoiceStatusLabel}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="{StaticResource OD.Pad.Top5}">
            <Button Content="Excel'e Aktar"
                    Style="{StaticResource OD.Button.Primary}"
                    Command="{Binding ExportToExcelCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
