<UserControl x:Class="OrderDeck.App.Views.Shell.CodePriceResultPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:drawers="clr-namespace:OrderDeck.App.Views.Drawers">
    <!-- FİYAT kutusundaki fiyat değişikliğinin (sahip kararı F2) şeritte "Evet"
         denince gelen sonucu: "Fiyatı düzelt" çekmecesindekiyle aynı görünüm
         (yeniden baskı sorusu, düzeltilmiş istek listesi, ödenmişler). Çekmece
         AÇILMAZ — yayında kod/fiyat kutusu ve kuyruk örtülmesin.

         Kuyrukla aynı hücrede, kuyruğun ÜSTÜNDE (MainShellView). Boyu sınırlı:
         kuyruğun vazgeçilmez payına (sekme başlığı + en az QueueMinHeight liste)
         girmez; sığmayan içerik gövdede kaydırılır. "Kapat" kaydırılan alanın
         DIŞINDA, başlık satırında — her boyutta erişilebilir. Eskiden kod/fiyat
         kutusunun altında, Auto satırda ve sınırsızdı: birkaç kişilik liste
         kuyruğu 0 piksele indiriyor, "Kapat"ı pencerenin dışına itiyordu.
         "Kapat"la kalkar; yeniden baskı/gönderim sürerken de kapatılabilir,
         sonucu "Basılanlar"daki şeride düşer. -->
    <Border x:Name="Frame"
            Style="{StaticResource OD.Panel}"
            Margin="{StaticResource OD.Pad.Bottom3}"
            Visibility="{Binding CodePriceCorrection, Converter={StaticResource NullToCollapsedConverter}}">
        <DockPanel LastChildFill="True">
            <DockPanel x:Name="Header" DockPanel.Dock="Top" LastChildFill="True"
                       Margin="{StaticResource OD.Pad.X5}">
                <Button x:Name="CloseButton"
                        DockPanel.Dock="Right"
                        Content="Kapat"
                        Style="{StaticResource OD.Button.Ghost}"
                        FontSize="{StaticResource OD.Font.F0}"
                        Padding="{StaticResource OD.Pad.2}"
                        Command="{Binding CodePriceCorrection.DoneCommand}"/>
                <TextBlock Text="FİYAT DEĞİŞİKLİĞİ"
                           Style="{StaticResource OD.Text.Micro}"
                           VerticalAlignment="Center"/>
            </DockPanel>
            <ScrollViewer x:Name="Body"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="{StaticResource OD.Pad.X5}">
                <drawers:PriceCorrectionResultView x:Name="Result"
                                                   DataContext="{Binding CodePriceCorrection}"
                                                   ShowsDoneButton="False"
                                                   Margin="{StaticResource OD.Pad.Bottom3}"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
