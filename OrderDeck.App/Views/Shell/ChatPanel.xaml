<UserControl x:Class="OrderDeck.App.Views.Shell.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OrderDeck.App.Controls">
    <Border Style="{StaticResource OD.Panel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Başlık şeridi: ad + arama + "Sadece {kod}" çipi ───────── -->
            <Border Grid.Row="0" Padding="{StaticResource OD.Pad.4}"
                    BorderBrush="{StaticResource OD.Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Canlı Sohbet"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource OD.Font.Display}"
                               FontSize="{StaticResource OD.Font.F2}"
                               Foreground="{StaticResource OD.Brush.Text}"/>

                    <TextBox Grid.Column="1"
                             Style="{StaticResource OD.TextBox}"
                             Margin="{StaticResource OD.Pad.3}"
                             Text="{Binding ChatSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Kullanıcı veya mesaj ara…"
                             ToolTip="Kullanıcı adı veya mesaj içinde ara"/>

                    <!-- Çip yalnız aktif kod varken anlamlı; kod yokken
                         gizlenir ki operatör etkisiz bir düğmeye basmasın.
                         ActiveCode boşken null değil "" — NullToCollapsedConverter
                         boş/whitespace dizgiyi de Collapsed'a çeviriyor. -->
                    <ToggleButton Grid.Column="2"
                                  Style="{StaticResource OD.Chip}"
                                  IsChecked="{Binding OnlyActiveCode}"
                                  Visibility="{Binding ActiveCode,
                                               Converter={StaticResource NullToCollapsedConverter}}"
                                  Content="{Binding ActiveCode}"
                                  ContentStringFormat="Sadece {0}"/>
                </Grid>
            </Border>

            <!-- ── Sohbet durum şeridi + "Sohbeti yenile" (tasarım 2026-11-24 §5.4, §5.5) ─
                 Bütün sohbet kaynakları: YouTube, TikTok, Facebook, sonra
                 Instagram hesapları. Satır = 8 px nokta + metin; sağlıklı kaynak
                 yalnız adını yazar. Durum rengi yalnız noktadadır, platform
                 ikonu yok (marka ikonlarının kullanım koşulu sohbet satırı için).
                 ShellBanners'a değil buraya: sohbet paneli dar kipte de görünür
                 ve durum dakikalarca sürebilir. Yayın oturumu açıkken hep
                 görünür (yenile düğmesinin yeri burası), oturum yokken kalkar. -->
            <Border Grid.Row="1" Padding="{StaticResource OD.Pad.3}"
                    BorderBrush="{StaticResource OD.Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding ShowChatStatus,
                                 Converter={StaticResource BoolToVisibleConverter}}">
                <DockPanel>
                    <!-- Sağ uçta, İLK satırın hizasında (şerit alt satıra inse de
                         ortalanmaz). 24 px'lik düğme satırdan yüksek; eksi dikey
                         boşluk şeridi şişirmesini önler: düğme satırın ortasına
                         oturur, taşan kısmı şeridin dolgusuna biner.
                         Meşgulken ikonun yerinde halka döner (ButtonState.IsBusy);
                         sorunsuz bitince ikon kısa süre onay işareti olur. -->
                    <Button x:Name="RefreshChatButton"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Top"
                            Width="24" Height="24" Margin="0,-4" Padding="0"
                            HorizontalContentAlignment="Center"
                            Command="{Binding RefreshChatCommand}"
                            controls:ButtonState.IsBusy="{Binding IsRefreshingChat}"
                            ToolTip="Sohbet bağlantılarını yenile">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OD.Button.Ghost}">
                                <Setter Property="AutomationProperties.Name" Value="Sohbet bağlantılarını yenile"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRefreshingChat}" Value="True">
                                        <Setter Property="AutomationProperties.Name"
                                                Value="Sohbet bağlantıları yenileniyor"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path>
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource OD.IconPath}">
                                    <Setter Property="Data" Value="{StaticResource OD.Path.Refresh}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChatRefreshDone}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource OD.Path.Check}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <ItemsControl x:Name="ChatStatusList"
                                  ItemsSource="{Binding ChatStatusRows}"
                                  VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Öğeler arası boşluk SAĞDA: alt satır soldan hizalı
                                     başlar. "Instagram" etiketi ilk hesabın öğesinin
                                     içinde: şerit nereden kırılırsa kırılsın hesabından
                                     ayrılmaz. -->
                                <StackPanel Orientation="Horizontal"
                                            ToolTip="{Binding Tooltip}"
                                            Margin="{StaticResource OD.Pad.Right4}">
                                    <TextBlock Text="{Binding GroupLabel}"
                                               Style="{StaticResource OD.Text.Micro}"
                                               VerticalAlignment="Center"
                                               Margin="{StaticResource OD.Pad.Right3}"
                                               Visibility="{Binding GroupLabel,
                                                            Converter={StaticResource NullToCollapsedConverter}}"/>
                                    <Ellipse Width="8" Height="8"
                                             VerticalAlignment="Center"
                                             Margin="{StaticResource OD.Pad.Right2}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource OD.Brush.TextMute}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Live">
                                                        <Setter Property="Fill" Value="{StaticResource OD.Brush.Success}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                        <Setter Property="Fill" Value="{StaticResource OD.Brush.Amber}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding DisplayText}"
                                               FontSize="{StaticResource OD.Font.F1}"
                                               Foreground="{StaticResource OD.Brush.TextDim}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- ── Liste ────────────────────────────────────────────────── -->
            <ListBox Grid.Row="2"
                     x:Name="ChatList"
                     Style="{StaticResource OD.ListBox}"
                     ItemsSource="{Binding ChatView}"
                     MouseDoubleClick="ChatList_OnDoubleClick"
                     PreviewKeyDown="ChatList_OnPreviewKeyDown"
                     Background="Transparent"
                     Foreground="{StaticResource OD.Brush.Text}"
                     BorderThickness="0"
                     Padding="{StaticResource OD.Pad.2}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background"
                                Value="{Binding IsSenderBlacklisted,
                                                Converter={StaticResource BlacklistToBrushConverter}}"/>
                        <!-- Item'ı liste genişliğine yasla ki mesaj TextBlock'u
                             (Wrap) dar pencerede alt satıra geçsin — yoksa item
                             içeriğe göre yatayda taşıp kırpılıyordu. -->
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <!-- Rozet kolonu: taban ölçü OD.Layout.ChatBadgeColumn.
                                     Width yerine MinWidth çünkü (a) ColumnDefinition.Width
                                     GridLength ister, token sys:Double; (b) YouTube ikonu
                                     158:110 oranında ve 20 dp minimumun altına inemez —
                                     28 px'e sabitlenirse ikon 19,5 px'e küçülürdü. -->
                                <ColumnDefinition Width="Auto"
                                                  MinWidth="{StaticResource OD.Layout.ChatBadgeColumn}"/>
                                <!-- Satırın geri kalanı (ad alanı + mesaj + hesap etiketi) TEK yıldız
                                     kolonda: içindeki panel sonlu genişlikle ölçülür, böylece ad
                                     alanının ne kadar büyüyebileceğini satırın genişliği belirler.
                                     Ad alanı ayrı bir Auto kolonda dursaydı Grid onu sonsuz genişlikle
                                     ölçerdi: dar pencerede uzun ad, mesaja yer bırakmadan büyürdü. -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Platform rozeti — her platformun RESMİ marka ikonu
                                 (youtube/instagram/tiktok/facebook lowercase id'ler;
                                 bilinmeyen → nötr metin chip). İkonlar ve kullanım
                                 gerekçeleri Themes/PlatformIcons.xaml'de.
                                 Rozet tıklanabilir değil, yalnızca kaynak atfıdır.
                                 Genişlik 32: YouTube ikonu 158:110 oranında olduğu için
                                 20 px yükseklikte ~29 px yer kaplıyor (diğerleri kare). -->
                            <ContentControl Grid.Column="0" Content="{Binding}"
                                            Width="32" Height="20" Margin="0,0,10,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource OD.PlatformChip.Unknown}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Platform}" Value="youtube"><Setter Property="ContentTemplate" Value="{StaticResource OD.PlatformChip.YouTube}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Platform}" Value="instagram"><Setter Property="ContentTemplate" Value="{StaticResource OD.PlatformChip.Instagram}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Platform}" Value="tiktok"><Setter Property="ContentTemplate" Value="{StaticResource OD.PlatformChip.TikTok}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Platform}" Value="facebook"><Setter Property="ContentTemplate" Value="{StaticResource OD.PlatformChip.Facebook}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                            <!-- Ad alanı + mesaj + Instagram hesap etiketi. DockPanel çocuklarını
                                 YAZILDIKLARI sırayla ölçer; bu sıra aynı zamanda yer önceliğidir:

                                 1) Hesap etiketi (sağda). Yerini ilk o alır; böylece ada sığan
                                    satırlarda kodun başladığı x konumu etiketli ve etiketsiz satırda
                                    aynıdır. AccountTag'i
                                    yalnız Instagram birleştirme kapısı doldurur (iki ve üzeri Sayfa
                                    bağlıyken); null iken etiket boşluğuyla birlikte yer kaplamaz.
                                    Uzun hesap adı sondan kırpılır; tam adı ipucu verir.

                                 2) Ad alanı (solda): ad + "Kayıtlı" rozeti (telefonu kayıtlı
                                    müşteri; kural CustomerRepository.GetChatSenderMarks'ta). Rozet
                                    alanın sağ ucunda ve addan ÖNCE yazılı: yerini alır, ad kalanı
                                    doldurur. Kayıtsız satırda rozet boşluğuyla birlikte yer kaplamaz,
                                    ad o yeri de kullanır.
                                    Ad KESİLMEZ. Alan ada göre büyür: tabanı ChatNameColumn (ada sığan
                                    satırlarda mesaj aynı hizada başlar), tavanı ChatNameColumnMax.
                                    Yer mesajdan alınır, ama mesaja ayrılan tabana dokunulmaz: alanın
                                    sağ boşluğu (ChatMessageReserve) o tabandır. Alan ölçülürken kalan
                                    genişliğin tabanı düşülmüş hâlini görür; oraya sığmayan ad alt
                                    satıra iner.

                                 3) Mesaj: kalanı doldurur, sığmazsa alt satıra iner. Negatif sol
                                    boşluğu (ChatMessageReclaim), ad alanının ayırdığı tabanın üstüne
                                    oturmasını sağlar: mesaj tam ad alanının bittiği yerde başlar ve
                                    ayrılan tabanı da kullanır. -->
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding AccountTag}"
                                           ToolTip="{Binding AccountTooltip}"
                                           FontSize="{StaticResource OD.Font.F0}"
                                           Foreground="{StaticResource OD.Brush.TextMute}"
                                           MaxWidth="{StaticResource OD.Layout.ChatAccountTagMaxWidth}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Margin="{StaticResource OD.Pad.Left4}"
                                           Visibility="{Binding AccountTag,
                                                        Converter={StaticResource NullToCollapsedConverter}}"/>
                                <DockPanel DockPanel.Dock="Left"
                                           MinWidth="{StaticResource OD.Layout.ChatNameColumn}"
                                           MaxWidth="{StaticResource OD.Layout.ChatNameColumnMax}"
                                           Margin="{StaticResource OD.Pad.ChatMessageReserve}">
                                    <Border DockPanel.Dock="Right"
                                            CornerRadius="{StaticResource OD.Radius.Xs}"
                                            Padding="{StaticResource OD.Pad.1}"
                                            Margin="{StaticResource OD.Pad.Right2}"
                                            Background="{StaticResource OD.Brush.Surface2}"
                                            VerticalAlignment="Center"
                                            ToolTip="Telefonu kayıtlı müşteri"
                                            Visibility="{Binding IsSenderRegistered,
                                                         Converter={StaticResource BoolToVisibleConverter}}">
                                        <TextBlock Text="Kayıtlı" Style="{StaticResource OD.Text.Micro}"
                                                   Foreground="{StaticResource OD.Brush.Success}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Display}"
                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="{StaticResource OD.Pad.Right3}"
                                               ToolTip="{Binding Username}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Text}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                           Margin="{StaticResource OD.Pad.ChatMessageReclaim}"
                                           Foreground="{StaticResource OD.Brush.Text}"/>
                            </DockPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Müşteri Detayı"
                                  Command="{Binding PlacementTarget.DataContext.OpenCustomerDetailFromChatCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <!--
                          YouTube moderation menu items. OAuth audit kaydı için
                          açıldı (Settings → "YouTube'a Bağlan" kartıyla lockstep).
                          Kullanıcı YouTube'a bağlı değilse komutlar no-op/uyarı
                          verir; consent + audit ile birlikte kalıcı kullanılır.
                        -->
                        <MenuItem Header="YouTube'da mesajı sil"
                                  Command="{Binding PlacementTarget.DataContext.DeleteYouTubeMessageCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.SelectedItem.IsYouTube,
                                                       RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                       Converter={StaticResource BoolToVisibleConverter},
                                                       FallbackValue=Collapsed}"/>
                        <MenuItem Header="YouTube'da kullanıcıyı banla"
                                  Command="{Binding PlacementTarget.DataContext.BanYouTubeUserCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.SelectedItem.IsYouTube,
                                                       RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                       Converter={StaticResource BoolToVisibleConverter},
                                                       FallbackValue=Collapsed}"/>
                        <MenuItem Header="YouTube'da banı kaldır"
                                  Command="{Binding PlacementTarget.DataContext.UnbanYouTubeUserCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.SelectedItem.IsYouTube,
                                                       RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                       Converter={StaticResource BoolToVisibleConverter},
                                                       FallbackValue=Collapsed}"/>
                        <!--
                          Facebook moderation. Mirrors the YouTube pair above:
                          ExternalId is the Graph comment id, Username is the
                          page-scoped user id, so FacebookModerationService takes
                          both through unchanged. Requires a connected Page
                          (Settings → Facebook) — otherwise the commands warn.
                        -->
                        <MenuItem Header="Facebook'ta yorumu sil"
                                  Command="{Binding PlacementTarget.DataContext.DeleteFacebookCommentCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.SelectedItem.IsFacebook,
                                                       RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                       Converter={StaticResource BoolToVisibleConverter},
                                                       FallbackValue=Collapsed}"/>
                        <MenuItem Header="Facebook'ta kullanıcıyı banla"
                                  Command="{Binding PlacementTarget.DataContext.BanFacebookUserCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.SelectedItem.IsFacebook,
                                                       RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                       Converter={StaticResource BoolToVisibleConverter},
                                                       FallbackValue=Collapsed}"/>
                        <MenuItem Header="Facebook'ta banı kaldır"
                                  Command="{Binding PlacementTarget.DataContext.UnbanFacebookUserCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.SelectedItem.IsFacebook,
                                                       RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                       Converter={StaticResource BoolToVisibleConverter},
                                                       FallbackValue=Collapsed}"/>
                        <MenuItem Header="Kara Listeye Al…"
                                  Command="{Binding PlacementTarget.DataContext.AddChatSenderToBlacklistCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
