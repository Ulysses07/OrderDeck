<UserControl x:Class="OrderDeck.App.Views.Shell.PrintQueuePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:OrderDeck.App.Views.Shell">
    <UserControl.Resources>
        <!-- Sekme düğmesi (Kuyruk | Basılanlar, sahip kararı K1): OD.Chip'in
             RadioButton hâli. GroupName YOK: aynı ebeveyndeki radyolar zaten tek
             seçimli; grup adı süreç geneli olurdu ve paneli ikinci kez kuran
             (test, ileride ikinci görünüm) öbürünün sekmesini kapatırdı. -->
        <Style x:Key="PanelTab" TargetType="RadioButton" BasedOn="{StaticResource OD.Chip}">
            <Setter Property="Padding" Value="{StaticResource OD.Pad.3}"/>
            <Setter Property="Margin" Value="{StaticResource OD.Pad.X2}"/>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource OD.Panel}">
        <Grid>
            <!-- Eskiden üçüncü bir satır daha vardı: Yazdır/Sil/Temizle şeridi.
                 PrintSlot'a taşındı, çünkü çekmece bu paneli örtüyor ve
                 yazdırma çekmece açıkken de erişilebilir kalmalı (spec §6.2). -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Başlık şeridi: iki sekme + adet hapları ───────────────────
                 "Yazdırılacak Etiketler" başlığı Kuyruk sekmesine döndü; yanına
                 "Basılanlar" geldi (o yayının basılmış etiketleri, K1). -->
            <Border Grid.Row="0" Padding="{StaticResource OD.Pad.3}"
                    BorderBrush="{StaticResource OD.Brush.Border}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <RadioButton DockPanel.Dock="Left" Style="{StaticResource PanelTab}"
                                 IsChecked="{Binding IsQueueTabActive, Mode=TwoWay}"
                                 ToolTip="Yazdırılacak etiketler">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Kuyruk" VerticalAlignment="Center"/>
                            <!-- Hapın margin'i YATAY-YALNIZ (OD.Pad.X2): simetrik
                                 OD.Pad.3 kullanılsa hap kendi 8px dolgusunun üstüne
                                 8px dikey margin alır, başlık şeridi uzardı.
                                 Aynı gerekçe ShellTopBar'da da yazılı. -->
                            <Border Style="{StaticResource OD.CountPill}"
                                    Margin="{StaticResource OD.Pad.X2}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding PrintQueue.Count}"
                                           Style="{StaticResource OD.Text.Mono}"
                                           FontSize="{StaticResource OD.Font.F0}"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton DockPanel.Dock="Left" Style="{StaticResource PanelTab}"
                                 IsChecked="{Binding IsPrintedTabActive, Mode=TwoWay}"
                                 ToolTip="Bu yayında basılmış etiketler — fiyatı düzelt, yeniden bas, iptal et">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Basılanlar" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource OD.CountPill}"
                                    Margin="{StaticResource OD.Pad.X2}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding PrintedLabels.TotalCount}"
                                           Style="{StaticResource OD.Text.Mono}"
                                           FontSize="{StaticResource OD.Font.F0}"/>
                            </Border>
                            <!-- F5: sonuç şeridine okunmamış kayıt düştü (yeniden baskı,
                                 düzeltilmiş istek gönderimi). Sekme açılınca ya da şeridin
                                 "Tamam"ıyla kalkar. -->
                            <Ellipse x:Name="UnreadOutcomesDot"
                                     Width="8" Height="8"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource OD.Brush.Amber}"
                                     ToolTip="Yeni sonuç var — sekmeyi aç"
                                     Visibility="{Binding PrintedLabels.HasUnreadOutcomes, Converter={StaticResource BoolToVisibleConverter}}"/>
                        </StackPanel>
                    </RadioButton>
                    <!-- K4/F3: kuyrukta seçili satırların KODLARI — aynı çekmece. Kodun
                         yayındaki bütün etiketleri düzelir; basılmış olanı da varsa
                         yeniden baskı sorulur. -->
                    <Button DockPanel.Dock="Right" Content="Fiyatı düzelt"
                            Style="{StaticResource OD.Button.Ghost}"
                            FontSize="{StaticResource OD.Font.F0}"
                            Command="{Binding FixQueuePriceCommand}"
                            ToolTip="Seçili etiketlerin kodunun fiyatını düzelt (kodun bu yayındaki bütün etiketleri)"
                            Visibility="{Binding ShowQueueFixPrice, Converter={StaticResource BoolToVisibleConverter}}"/>
                </DockPanel>
            </Border>

            <shell:PrintedLabelsPanel Grid.Row="1"
                                      Margin="{StaticResource OD.Pad.Top3}"
                                      Visibility="{Binding IsPrintedTabActive, Converter={StaticResource BoolToVisibleConverter}}"/>

            <!-- ── Kuyruk listesi ──────────────────────────────────────────
                 ItemContainerStyle / ItemTemplate / ContextMenu
                 MainShellView.xaml:574-640'tan BİREBİR taşındı; bağlamalar,
                 dönüştürücüler ve komutlar değişmedi. İzin verilen tek
                 düzenleme kolon genişlikleri + fiyatın mono yazı tipi
                 (aşağıdaki yorumlara bak). -->
            <ListBox Grid.Row="1"
                     x:Name="QueueList"
                     Visibility="{Binding IsQueueTabActive, Converter={StaticResource BoolToVisibleConverter}}"
                     Style="{StaticResource OD.ListBox}"
                     ItemsSource="{Binding PrintQueue}"
                     SelectedItem="{Binding SelectedQueueItem, Mode=TwoWay}"
                     SelectionMode="Extended"
                     SelectionChanged="QueueList_OnSelectionChanged"
                     Background="Transparent"
                     Foreground="{StaticResource OD.Brush.Text}"
                     BorderThickness="0"
                     Padding="{StaticResource OD.Pad.2}"
                     MinHeight="{StaticResource OD.Layout.QueueMinHeight}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background"
                                Value="{Binding IsCustomerBlacklisted,
                                                Converter={StaticResource BlacklistToBrushConverter}}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <!-- Ad kolonu: OD.Layout.ChatUserMaxWidth'e sabit.
                                     ColumnDefinition.Width GridLength ister, token
                                     ise sys:Double — bu yüzden Width="Auto" +
                                     MinWidth/MaxWidth deseni (G12 ChatPanel ile
                                     aynı). Min=Max, çünkü her satır kendi Grid'i;
                                     Auto bırakılsaydı satırlar arasında mesaj
                                     kolonunun hizası kayardı. -->
                                <ColumnDefinition Width="Auto"
                                                  MinWidth="{StaticResource OD.Layout.ChatUserMaxWidth}"
                                                  MaxWidth="{StaticResource OD.Layout.ChatUserMaxWidth}"/>
                                <ColumnDefinition Width="*"/>
                                <!-- Fiyat: Auto. Mono rakam sabit genişlikli
                                     olduğu için kolon satırdan satıra zıplamaz,
                                     sabit 80px'e gerek kalmıyor. -->
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Display}"
                                       FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Username}"/>
                            <TextBlock Grid.Column="1" Text="{Binding MessageText}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Margin="6,0,6,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Price, StringFormat={}{0:N2} TL}"
                                       Style="{StaticResource OD.Text.Mono}"
                                       HorizontalAlignment="Right" FontWeight="Bold"
                                       Foreground="{StaticResource OD.Brush.Amber}"/>
                            <!-- Backup chip: 0 → "Yedek+" CTA, N → "Yedek N" badge.
                                 Click activates backup-selection mode for this label;
                                 subsequent chat double-click is routed to
                                 MainShellViewModel.TryAssignChatAsBackup.
                                 Mockup'ta karşılığı yok ama ÇALIŞAN bir özellik —
                                 zincir (BackupChipConverter + BeginAddBackupCommand)
                                 olduğu gibi korunuyor. -->
                            <Button Grid.Column="3"
                                    Margin="8,0,0,0"
                                    Padding="8,2"
                                    Style="{StaticResource OD.Button.Secondary}"
                                    FontSize="{StaticResource OD.Font.F0}"
                                    MinWidth="60"
                                    Content="{Binding BackupCount, Converter={StaticResource BackupChipConverter}}"
                                    Command="{Binding DataContext.BeginAddBackupCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Yedek müşteri ekle: tıkla, sonra chat'ten birini seç"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Müşteri Detayı"
                                  Command="{Binding PlacementTarget.DataContext.OpenCustomerDetailFromQueueCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Kara Listeye Al…"
                                  Command="{Binding PlacementTarget.DataContext.AddQueueRowToBlacklistCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
