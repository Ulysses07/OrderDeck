<UserControl x:Class="OrderDeck.App.Views.Shell.ShellBanners"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- On şerit aynı hücreyi paylaşır; z-sırası: kendi yayını uzaktan bitirildi
         (kalıcı bilgi, en altta) → sunucu → lisans → senkron kapatıldı → etiket gönderimi sonucu → yedek
         eklenemedi → yedek modu → çekiliş → yayını bitir sonucu → yayını bitir
         onayı. W2-09'un üç şeridinde RemoteSessions yoksa (testler)
         FallbackValue gizler. -->
    <Grid>
        <!-- Kendi açık yayını başka bilgisayardan bitirildi (W2-09, §5.7, M18):
             yayın sürer, sohbetten etiket ve baskı kesilmez; band yalnız bilgi.
             Operatör yayını bitirince devir görülür ve band kendiliğinden kalkar.
             Yayının geri kalanı boyunca kalıcı olduğu için EN ALTTA: sunucu,
             lisans ve öbür geçici uyarılar görünürken onun üstünde durur. -->
        <Border CornerRadius="{StaticResource OD.Radius.Md}"
                Background="{StaticResource OD.Brush.AmberTint}"
                BorderBrush="{StaticResource OD.Brush.AmberTintBorder}"
                BorderThickness="1"
                Visibility="{Binding RemoteSessions.OwnSessionBand,
                             Converter={StaticResource NullToCollapsedConverter},
                             FallbackValue=Collapsed}">
            <TextBlock Text="{Binding RemoteSessions.OwnSessionBand}"
                       Foreground="{StaticResource OD.Brush.Amber}"
                       FontWeight="SemiBold"
                       Margin="{StaticResource OD.Pad.4}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Border>

        <!-- Lisans sunucusuna erişilemiyor (heartbeat üst üste ≥2 başarısız). -->
        <Border CornerRadius="{StaticResource OD.Radius.Md}"
                Background="{StaticResource OD.Brush.AmberTint}"
                BorderBrush="{StaticResource OD.Brush.AmberTintBorder}"
                BorderThickness="1"
                Visibility="{Binding ServerOfflineBanner,
                             Converter={StaticResource NullToCollapsedConverter}}">
            <TextBlock Text="{Binding ServerOfflineBanner}"
                       Foreground="{StaticResource OD.Brush.Amber}"
                       FontWeight="SemiBold"
                       Margin="{StaticResource OD.Pad.4}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Border>

        <!-- Lisans süresi doluyor (≤7 gün). -->
        <Border CornerRadius="{StaticResource OD.Radius.Md}"
                Background="{StaticResource OD.Brush.AmberTint}"
                BorderBrush="{StaticResource OD.Brush.AmberTintBorder}"
                BorderThickness="1"
                Visibility="{Binding LicenseExpiryBanner,
                             Converter={StaticResource NullToCollapsedConverter}}">
            <TextBlock Text="{Binding LicenseExpiryBanner}"
                       Foreground="{StaticResource OD.Brush.Amber}"
                       FontWeight="SemiBold"
                       Margin="{StaticResource OD.Pad.4}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Border>

        <!-- Satış senkronu kapatıldı (W2-11, §5.3 mode-off): komut ucu modun
             kapandığını söyledi, Off turu koşuyor. Düğme yok: tur sonuçlanınca
             kendiliğinden kalkar. -->
        <Border CornerRadius="{StaticResource OD.Radius.Md}"
                Background="{StaticResource OD.Brush.InfoTint}"
                BorderBrush="{StaticResource OD.Brush.InfoTintBorder}"
                BorderThickness="1"
                Visibility="{Binding SalesModeOffBanner,
                             Converter={StaticResource NullToCollapsedConverter}}">
            <TextBlock Text="{Binding SalesModeOffBanner}"
                       Foreground="{StaticResource OD.Brush.Text}"
                       FontWeight="SemiBold"
                       Margin="{StaticResource OD.Pad.4}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Border>

        <!-- Etiket gönderiminin sonucu (W1-08): reddedilen değişiklik ya da
             başka bilgisayarda iptal edilmiş basılı kâğıt. W2-07: kalıntı
             kuyruğun komutları (imha edilecek kâğıt, uygulanamayan iptal,
             bekleyen komutun kalıcı reddi) da burada. Açılır pencere yok,
             "Tamam" kapatır. -->
        <Border CornerRadius="{StaticResource OD.Radius.Md}"
                Background="{StaticResource OD.Brush.AmberTint}"
                BorderBrush="{StaticResource OD.Brush.AmberTintBorder}"
                BorderThickness="1"
                Visibility="{Binding SalesPushWarning,
                             Converter={StaticResource NullToCollapsedConverter}}">
            <DockPanel LastChildFill="True" Margin="{StaticResource OD.Pad.4}">
                <Button DockPanel.Dock="Right"
                        Content="Tamam"
                        Command="{Binding DismissSalesPushWarningCommand}"
                        Style="{StaticResource OD.Button.Ghost}"
                        Foreground="{StaticResource OD.Brush.Amber}"
                        Margin="{StaticResource OD.Pad.2}"/>
                <TextBlock Text="{Binding SalesPushWarning}"
                           Foreground="{StaticResource OD.Brush.Amber}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Yedek eklenemedi (W2-06, devredilmiş yayının yedeği komutla): sebep
             satır içi; sonucu bilinmeyen komutta "Tekrar dene" aynı komutu
             gönderir. Açılır pencere yok, "Tamam" kapatır. -->
        <Border CornerRadius="{StaticResource OD.Radius.Md}"
                Background="{StaticResource OD.Brush.AmberTint}"
                BorderBrush="{StaticResource OD.Brush.AmberTintBorder}"
                BorderThickness="1"
                Visibility="{Binding BackupProblem,
                             Converter={StaticResource NullToCollapsedConverter}}">
            <DockPanel LastChildFill="True" Margin="{StaticResource OD.Pad.4}">
                <Button DockPanel.Dock="Right"
                        Content="Tamam"
                        Command="{Binding DismissBackupProblemCommand}"
                        Style="{StaticResource OD.Button.Ghost}"
                        Foreground="{StaticResource OD.Brush.Amber}"
                        Margin="{StaticResource OD.Pad.2}"/>
                <Button DockPanel.Dock="Right"
                        Content="Tekrar dene"
                        Command="{Binding RetryBackupCommand}"
                        Visibility="{Binding CanRetryBackup,
                                     Converter={StaticResource BoolToVisibleConverter}}"
                        Style="{StaticResource OD.Button.Ghost}"
                        Foreground="{StaticResource OD.Brush.Amber}"
                        FontWeight="SemiBold"
                        Margin="{StaticResource OD.Pad.2}"/>
                <TextBlock Text="{Binding BackupProblem}"
                           Foreground="{StaticResource OD.Brush.Amber}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Yedek seçim modu. Rakip şeritlerin ÜSTÜNDE durur (grid'de daha
             sonra gelir). BackupTargetLabel null olunca kendiliğinden kapanır. -->
        <Border CornerRadius="{StaticResource OD.Radius.Md}"
                Background="{StaticResource OD.Brush.InfoTint}"
                BorderBrush="{StaticResource OD.Brush.InfoTintBorder}"
                BorderThickness="1"
                Visibility="{Binding IsInBackupSelectionMode,
                             Converter={StaticResource BoolToVisibleConverter}}">
            <DockPanel LastChildFill="False" Margin="{StaticResource OD.Pad.4}">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding BackupModeBanner}"
                           Foreground="{StaticResource OD.Brush.Text}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right"
                        Content="İptal (ESC)"
                        Command="{Binding CancelBackupSelectionCommand}"
                        Style="{StaticResource OD.Button.Ghost}"
                        Foreground="{StaticResource OD.Brush.Info}"
                        Margin="{StaticResource OD.Pad.2}"/>
            </DockPanel>
        </Border>

        <!-- Çekiliş aktif. -->
        <Border CornerRadius="{StaticResource OD.Radius.Md}"
                Background="{StaticResource OD.Brush.AmberTintStrong}"
                BorderBrush="{StaticResource OD.Brush.AmberTintStrongBorder}"
                BorderThickness="1"
                Visibility="{Binding IsGiveawayActive,
                             Converter={StaticResource BoolToVisibleConverter}}">
            <DockPanel LastChildFill="False" Margin="{StaticResource OD.Pad.4}">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="{StaticResource OD.Pad.3}">
                    <Image Source="{StaticResource OD.Icon.Gift}"
                           Width="{StaticResource OD.Icon.Sm}"
                           Height="{StaticResource OD.Icon.Sm}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource OD.Pad.2}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Banner.Keyword}"
                               Foreground="{StaticResource OD.Brush.Amber}"
                               FontWeight="Bold"
                               FontSize="{StaticResource OD.Font.F2}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Banner.ParticipantCount, StringFormat={}{0} katılımcı}"
                           Foreground="{StaticResource OD.Brush.Text}"
                           Margin="{StaticResource OD.Pad.3}"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Banner.CountdownText}"
                           Foreground="{StaticResource OD.Brush.Text}"
                           Margin="{StaticResource OD.Pad.3}"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right"
                        Content="İptal"
                        Command="{Binding CancelGiveawayCommand}"
                        Style="{StaticResource OD.Button.Ghost}"
                        Foreground="{StaticResource OD.Brush.Accent}"
                        Margin="{StaticResource OD.Pad.2}"/>
                <Button DockPanel.Dock="Right"
                        Content="Şimdi Çek"
                        Command="{Binding DrawGiveawayNowCommand}"
                        Style="{StaticResource OD.Button.Ghost}"
                        Foreground="{StaticResource OD.Brush.Text}"
                        FontWeight="Bold"
                        Margin="{StaticResource OD.Pad.2}"/>
            </DockPanel>
        </Border>

        <!-- "Yayını bitir…"in sonucu (W2-09, §5.3): owner-active, handing-over
             ya da bağlantı sorunu. Sonucu bilinmeyen gönderimde "Tekrar dene"
             aynı komutu gönderir. Açılır pencere yok, "Tamam" kapatır. -->
        <Border CornerRadius="{StaticResource OD.Radius.Md}"
                Background="{StaticResource OD.Brush.AmberTint}"
                BorderBrush="{StaticResource OD.Brush.AmberTintBorder}"
                BorderThickness="1"
                Visibility="{Binding RemoteSessions.ForceEndProblem,
                             Converter={StaticResource NullToCollapsedConverter},
                             FallbackValue=Collapsed}">
            <DockPanel LastChildFill="True" Margin="{StaticResource OD.Pad.4}">
                <Button DockPanel.Dock="Right"
                        Content="Tamam"
                        Command="{Binding RemoteSessions.DismissForceEndProblemCommand}"
                        Style="{StaticResource OD.Button.Ghost}"
                        Foreground="{StaticResource OD.Brush.Amber}"
                        Margin="{StaticResource OD.Pad.2}"/>
                <Button DockPanel.Dock="Right"
                        Content="Tekrar dene"
                        Command="{Binding RemoteSessions.RetryForceEndCommand}"
                        Visibility="{Binding RemoteSessions.CanRetryForceEnd,
                                     Converter={StaticResource BoolToVisibleConverter},
                                     FallbackValue=Collapsed}"
                        Style="{StaticResource OD.Button.Ghost}"
                        Foreground="{StaticResource OD.Brush.Amber}"
                        FontWeight="SemiBold"
                        Margin="{StaticResource OD.Pad.2}"/>
                <TextBlock Text="{Binding RemoteSessions.ForceEndProblem}"
                           Foreground="{StaticResource OD.Brush.Amber}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- "Yayını bitir…" onayı (W2-09, spec 2026-10-13 §5.7, Y7): çipteki
             sessizlik dakikası ve makine adıyla spec metni. EN ÜSTTE: operatörün
             tıklamasının sonucu. "Yayını bitir" force-end gönderir (sunucu son
             sözü söyler: owner-active, handing-over); "Vazgeç" istek göndermez. -->
        <Border CornerRadius="{StaticResource OD.Radius.Md}"
                Background="{StaticResource OD.Brush.AmberTintStrong}"
                BorderBrush="{StaticResource OD.Brush.AmberTintStrongBorder}"
                BorderThickness="1"
                Visibility="{Binding RemoteSessions.ForceEndPrompt,
                             Converter={StaticResource NullToCollapsedConverter},
                             FallbackValue=Collapsed}">
            <DockPanel LastChildFill="True" Margin="{StaticResource OD.Pad.4}">
                <Button DockPanel.Dock="Right"
                        Content="Vazgeç"
                        Command="{Binding RemoteSessions.CancelForceEndCommand}"
                        Style="{StaticResource OD.Button.Ghost}"
                        Foreground="{StaticResource OD.Brush.Text}"
                        Margin="{StaticResource OD.Pad.2}"/>
                <Button DockPanel.Dock="Right"
                        Content="Yayını bitir"
                        Command="{Binding RemoteSessions.ConfirmForceEndCommand}"
                        Style="{StaticResource OD.Button.Ghost}"
                        Foreground="{StaticResource OD.Brush.Accent}"
                        FontWeight="Bold"
                        Margin="{StaticResource OD.Pad.2}"/>
                <TextBlock Text="{Binding RemoteSessions.ForceEndPrompt}"
                           Foreground="{StaticResource OD.Brush.Text}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
