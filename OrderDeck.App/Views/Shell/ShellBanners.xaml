<UserControl x:Class="OrderDeck.App.Views.Shell.ShellBanners"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dört şerit aynı hücreyi paylaşır; z-sırası MainShellView'daki ile
         birebir aynı: sunucu → lisans → yedek modu → çekiliş. -->
    <Grid>
        <!-- Lisans sunucusuna erişilemiyor (heartbeat üst üste ≥2 başarısız). -->
        <Border CornerRadius="{StaticResource OD.Radius.Md}"
                Background="{StaticResource OD.Brush.AmberTint}"
                BorderBrush="{StaticResource OD.Brush.AmberTintBorder}"
                BorderThickness="1"
                Visibility="{Binding ServerOfflineBanner,
                             Converter={StaticResource NullToCollapsedConverter}}">
            <TextBlock Text="{Binding ServerOfflineBanner}"
                       Foreground="{StaticResource OD.Brush.Amber}"
                       FontWeight="SemiBold"
                       Margin="{StaticResource OD.Pad.4}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Border>

        <!-- Lisans süresi doluyor (≤7 gün). -->
        <Border CornerRadius="{StaticResource OD.Radius.Md}"
                Background="{StaticResource OD.Brush.AmberTint}"
                BorderBrush="{StaticResource OD.Brush.AmberTintBorder}"
                BorderThickness="1"
                Visibility="{Binding LicenseExpiryBanner,
                             Converter={StaticResource NullToCollapsedConverter}}">
            <TextBlock Text="{Binding LicenseExpiryBanner}"
                       Foreground="{StaticResource OD.Brush.Amber}"
                       FontWeight="SemiBold"
                       Margin="{StaticResource OD.Pad.4}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Border>

        <!-- Yedek seçim modu. Rakip şeritlerin ÜSTÜNDE durur (grid'de daha
             sonra gelir). BackupTargetLabel null olunca kendiliğinden kapanır. -->
        <Border CornerRadius="{StaticResource OD.Radius.Md}"
                Background="{StaticResource OD.Brush.InfoTint}"
                BorderBrush="{StaticResource OD.Brush.InfoTintBorder}"
                BorderThickness="1"
                Visibility="{Binding IsInBackupSelectionMode,
                             Converter={StaticResource BoolToVisibleConverter}}">
            <DockPanel LastChildFill="False" Margin="{StaticResource OD.Pad.4}">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding BackupModeBanner}"
                           Foreground="{StaticResource OD.Brush.Text}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right"
                        Content="İptal (ESC)"
                        Command="{Binding CancelBackupSelectionCommand}"
                        Style="{StaticResource OD.Button.Ghost}"
                        Foreground="{StaticResource OD.Brush.Info}"
                        Margin="{StaticResource OD.Pad.2}"/>
            </DockPanel>
        </Border>

        <!-- Çekiliş aktif. -->
        <Border CornerRadius="{StaticResource OD.Radius.Md}"
                Background="{StaticResource OD.Brush.AmberTintStrong}"
                BorderBrush="{StaticResource OD.Brush.AmberTintStrongBorder}"
                BorderThickness="1"
                Visibility="{Binding IsGiveawayActive,
                             Converter={StaticResource BoolToVisibleConverter}}">
            <DockPanel LastChildFill="False" Margin="{StaticResource OD.Pad.4}">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="{StaticResource OD.Pad.3}">
                    <Image Source="{StaticResource OD.Icon.Gift}"
                           Width="{StaticResource OD.Icon.Sm}"
                           Height="{StaticResource OD.Icon.Sm}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource OD.Pad.2}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Banner.Keyword}"
                               Foreground="{StaticResource OD.Brush.Amber}"
                               FontWeight="Bold"
                               FontSize="{StaticResource OD.Font.F2}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Banner.ParticipantCount, StringFormat={}{0} katılımcı}"
                           Foreground="{StaticResource OD.Brush.Text}"
                           Margin="{StaticResource OD.Pad.3}"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Banner.CountdownText}"
                           Foreground="{StaticResource OD.Brush.Text}"
                           Margin="{StaticResource OD.Pad.3}"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right"
                        Content="İptal"
                        Command="{Binding CancelGiveawayCommand}"
                        Style="{StaticResource OD.Button.Ghost}"
                        Foreground="{StaticResource OD.Brush.Accent}"
                        Margin="{StaticResource OD.Pad.2}"/>
                <Button DockPanel.Dock="Right"
                        Content="Şimdi Çek"
                        Command="{Binding DrawGiveawayNowCommand}"
                        Style="{StaticResource OD.Button.Ghost}"
                        Foreground="{StaticResource OD.Brush.Text}"
                        FontWeight="Bold"
                        Margin="{StaticResource OD.Pad.2}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
