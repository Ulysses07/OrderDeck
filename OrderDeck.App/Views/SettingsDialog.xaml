<Window x:Class="OrderDeck.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OrderDeck.App.Controls"
        Title="Ayarlar" Width="980" Height="680" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#101219" Foreground="#F1F0EC" FontFamily="Segoe UI">
    <!-- NOT: Tüm görünüm stilleri SettingsTheme.xaml'den gelir ve YALNIZ bu
         pencereye scope'ludur (global DarkControls'ü diğer dialog'larda bozmaz).
         Tüm {Binding} ifadeleri ve code-behind handler'ları eski dialog ile
         birebir aynıdır — yalnız görünüm yenilendi. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/SettingsTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource S.WindowBg}"
                BorderBrush="{StaticResource S.Line}" BorderThickness="0,0,0,1"
                Padding="30,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="OrderDeck" FontFamily="{StaticResource S.Font.Display}"
                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource S.Text}"/>
                <Border Width="1" Background="{StaticResource S.Line2}" Margin="14,2,14,2"/>
                <TextBlock Text="Ayarlar" FontSize="14" Foreground="{StaticResource S.Dim}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource S.WindowBg}"
                BorderBrush="{StaticResource S.Line}" BorderThickness="0,1,0,0"
                Padding="30,14">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Logları Aç" Click="OnOpenLogs"
                        ToolTip="Serilog log dosyalarının olduğu klasörü Explorer'da açar"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ValidationError}" Foreground="{StaticResource S.Red}"
                               VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap"
                               MaxWidth="360"
                               Visibility="{Binding ValidationError, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <Button Content="İptal" Click="OnCancel" IsCancel="True" Margin="0,0,8,0"/>
                    <Button Content="Kaydet" Click="OnSave" IsDefault="True"
                            Style="{StaticResource S.PrimaryButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Sidebar + içerik -->
        <TabControl>
            <!-- ═══ Yazıcı ═══ -->
            <TabItem Header="Yazıcı">
                <StackPanel>
                    <TextBlock Style="{StaticResource S.PaneTitle}" Text="Yazıcı &amp; Çıktı"/>
                    <TextBlock Style="{StaticResource S.PaneDesc}"
                               Text="Termal etiket yazıcısı ve etiket ölçüleri."
                               Margin="0,4,0,18"/>

                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource S.CardTitle}" Text="Etiket Yazıcısı" Margin="0,0,0,14"/>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource S.FieldLabel}" Text="Yazıcı"/>
                                <ComboBox ItemsSource="{Binding AvailablePrinters}"
                                          SelectedItem="{Binding SelectedPrinter, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource S.FieldLabel}" Text="Yazı tipi"/>
                                <ComboBox ItemsSource="{Binding AvailableFonts}"
                                          SelectedItem="{Binding LabelFontFamily, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource S.CardTitle}" Text="Etiket Ölçüleri" Margin="0,0,0,14"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,14">
                                    <TextBlock Style="{StaticResource S.FieldLabel}" Text="Etiket genişliği"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding LabelWidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource S.Suffix}" Text="mm" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,14">
                                    <TextBlock Style="{StaticResource S.FieldLabel}" Text="Etiket yüksekliği"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding LabelHeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource S.Suffix}" Text="mm" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource S.FieldLabel}" Text="Etiket aralığı"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding LabelGapMm, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource S.Suffix}" Text="mm" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel/>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource S.FieldLabel}" Text="Kullanıcı font"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding LabelUserFontSize, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource S.Suffix}" Text="pt" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Style="{StaticResource S.FieldLabel}" Text="Mesaj font"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding LabelMessageFontSize, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource S.Suffix}" Text="pt" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </UniformGrid>
                            <Button Content="Test Etiketi Bas" Command="{Binding TestPrintCommand}"
                                    HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ OBS Overlay ═══ -->
            <TabItem Header="OBS Overlay">
                <StackPanel>
                    <TextBlock Style="{StaticResource S.PaneTitle}" Text="OBS Overlay"/>
                    <TextBlock Style="{StaticResource S.PaneDesc}"
                               Text="OBS Browser Source için chat overlay ayarları."
                               Margin="0,4,0,18"/>
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource S.FieldLabel}" Text="Overlay portu"/>
                                <TextBox Text="{Binding OverlayPort, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource S.Font.Mono}" MaxWidth="200" HorizontalAlignment="Left"/>
                                <Border Background="{StaticResource S.RedSoft}" CornerRadius="9" Padding="12,8" Margin="0,10,0,0"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="Port değişikliği için uygulamayı yeniden başlatman gerekir."
                                               Foreground="{StaticResource S.Amber}" FontSize="12" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource S.FieldLabel}" Text="Chat teması"/>
                                <ComboBox ItemsSource="{Binding AvailableThemes}"
                                          SelectedItem="{Binding ChatTheme, UpdateSourceTrigger=PropertyChanged}"
                                          MaxWidth="280" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ YouTube ═══ -->
            <TabItem Header="YouTube">
                <StackPanel>
                    <TextBlock Style="{StaticResource S.PaneTitle}" Text="YouTube"/>
                    <TextBlock Style="{StaticResource S.PaneDesc}"
                               Text="YouTube canlı yayın sohbetini OrderDeck'e bağla."
                               Margin="0,4,0,18"/>
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource S.CardTitle}" Text="YouTube Live Chat" Margin="0,0,0,14"/>
                            <TextBlock Style="{StaticResource S.FieldLabel}" Text="Kanal Handle (örn. @kullaniciadi)"/>
                            <TextBox Text="{Binding YouTubeChannelHandle, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource S.Hint}">
                                Kanal handle'ını yaz (@ ile veya @'sız), ya da tam YouTube Live URL'si yapıştır.
                                OrderDeck yayına başladığında otomatik bağlanır; tarayıcı açık tutmaya gerek yok.
                                Boş bırakırsan YouTube chat takibi devre dışı kalır.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Faz 2 — resmi YouTube API (gRPC streamList) ile chat çekme. -->
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource S.CardTitle}" Text="Resmi YouTube API (chat)" Margin="0,0,0,14"/>
                            <CheckBox Content="Resmi API ile chat çek (eksiksiz — Top chat filtresi yok)"
                                      IsChecked="{Binding UseOfficialYouTubeApi}"/>
                            <TextBlock Style="{StaticResource S.FieldLabel}" Text="YouTube Data API Key (AIza...)" Margin="0,12,0,0"/>
                            <TextBox Text="{Binding YouTubeApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource S.Hint}">
                                Açıkken sohbet resmi gRPC streamList'ten gelir (scraper chat'i kapanır; izleyici sayısı yine çekilir).
                                Google Cloud projenden bir API key gir. Günlük kota tüketir. Kapalıyken klasik scraper kullanılır.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Moderasyon UI: Google OAuth doğrulaması tamamlanana kadar gizli.
                         Servis kodu (YouTubeOAuthService/YouTubeModerationService) ve
                         chat sağ-tık menüsü binary'de; Visibility="Visible" yapınca uçtan
                         uca çalışır. Binding'ler korunur. -->
                    <Border Style="{StaticResource S.Card}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource S.CardTitle}" Text="YouTube Moderasyon (mesaj sil / kullanıcı banla)" Margin="0,0,0,14"/>
                            <TextBlock Text="{Binding YouTubeConnectionStatus}" FontWeight="Bold"
                                       Foreground="{StaticResource S.Text}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="YouTube'a Bağlan" Command="{Binding ConnectYouTubeCommand}"
                                        IsEnabled="{Binding IsYouTubeIdle}" Margin="0,0,8,0"/>
                                <Button Content="Bağlantıyı Kaldır" Command="{Binding DisconnectYouTubeCommand}"
                                        IsEnabled="{Binding IsYouTubeConnected}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource S.Hint}">
                                Bağlandıktan sonra yayın anında chat'te bir mesaja sağ tıklayıp
                                "YT'de mesajı sil" veya "YT'de kullanıcıyı banla" diyebilirsin.
                                Refresh token bilgisayarında DPAPI ile şifreli saklanır.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ Facebook ═══ -->
            <TabItem Header="Facebook">
                <StackPanel>
                    <TextBlock Style="{StaticResource S.PaneTitle}" Text="Facebook"/>
                    <TextBlock Style="{StaticResource S.PaneDesc}"
                               Text="Facebook Page'ini bağla — canlı yayın yorumları gerçek zamanlı çekilir, moderasyon (sil/banla) menüsü açılır."
                               Margin="0,4,0,18"/>
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource S.CardTitle}" Text="Facebook Live (Page bağla)" Margin="0,0,0,14"/>
                            <TextBlock Text="{Binding FacebookConnectionStatus}" FontWeight="Bold"
                                       Foreground="{StaticResource S.Text}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Facebook'a Bağlan" Command="{Binding ConnectFacebookCommand}"
                                        IsEnabled="{Binding IsFacebookIdle}" Margin="0,0,8,0"/>
                                <Button Content="Bağlantıyı Kaldır" Command="{Binding DisconnectFacebookCommand}"
                                        IsEnabled="{Binding IsFacebookConnected}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource S.Hint}">
                                Bağlandıktan sonra Page canlı yayın açtığında yorumlar otomatik olarak akmaya başlar — polling yok, anlık push.
                                Page access token bilgisayarında DPAPI ile şifreli saklanır. Birden fazla Page'in varsa bağlanırken seçim sorulur.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ Çekiliş Animasyonu ═══ -->
            <TabItem Header="Çekiliş Animasyonu">
                <StackPanel>
                    <TextBlock Style="{StaticResource S.PaneTitle}" Text="Çekiliş Animasyonu"/>
                    <TextBlock Style="{StaticResource S.PaneDesc}"
                               Text="Çekiliş çarkı/animasyonu ve ses ayarları."
                               Margin="0,4,0,18"/>
                    <Border Style="{StaticResource S.Card}">
                        <controls:AnimationPickerControl DataContext="{Binding AnimationPicker}"/>
                    </Border>
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource S.CardTitle}" Text="Ses" Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="Ses seviyesi" Style="{StaticResource S.FieldLabel}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding AnimationVolume, UpdateSourceTrigger=PropertyChanged}"
                                        Width="240" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding AnimationVolume, StringFormat={}{0:P0}}"
                                           FontFamily="{StaticResource S.Font.Mono}" Foreground="{StaticResource S.Dim}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" Width="46"/>
                            </StackPanel>
                            <CheckBox Content="Sessiz mod (tüm animasyonlar sessiz)"
                                      IsChecked="{Binding AnimationMuted}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ Ödeme & Kargo ═══ -->
            <TabItem Header="Ödeme &amp; Kargo">
                <StackPanel>
                    <TextBlock Style="{StaticResource S.PaneTitle}" Text="Ödeme &amp; Kargo"/>
                    <TextBlock Style="{StaticResource S.PaneDesc}"
                               Text="WhatsApp ödeme mesajı, banka bilgileri ve kargo eşiği."
                               Margin="0,4,0,18"/>

                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource S.CardTitle}" Text="WhatsApp Ödeme İsteme" Margin="0,0,0,14"/>
                            <TextBlock Style="{StaticResource S.FieldLabel}" Text="Mesaj Şablonu"/>
                            <TextBox Text="{Binding PaymentTemplate, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="200"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="{StaticResource S.Font.Mono}" FontSize="12.5"/>
                            <TextBlock Style="{StaticResource S.Hint}">
                                Placeholder: {ad} {tutar} {tarih} {iban} {hesap_sahibi} {papara}
                                <LineBreak/>
                                Kargo: {urun_toplami} · {kargo_ucreti} · {kargo}
                                <LineBreak/>
                                Bakiye: {toplam_oncesi} · {bakiye} · {net_tutar}
                            </TextBlock>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource S.FieldLabel}" Text="IBAN"/>
                                <TextBox Text="{Binding Iban, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource S.Font.Mono}"/>
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource S.FieldLabel}" Text="Hesap Sahibi"/>
                                <TextBox Text="{Binding AccountHolder, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource S.FieldLabel}" Text="Papara/Ziraat Numarası (opsiyonel)"/>
                                <TextBox Text="{Binding Papara, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource S.Font.Mono}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource S.CardTitle}" Text="Kargo" Margin="0,0,0,14"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource S.FieldLabel}" Text="Ücretsiz Kargo Eşiği"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding FreeShippingThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Bu tutar ve üzeri siparişlerde kargo ücretsiz. Boş bırak veya 0 yaz = kargo özelliği kapalı."/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource S.Suffix}" Text="₺" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Style="{StaticResource S.FieldLabel}" Text="Sabit Kargo Ücreti"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding ShippingFeeText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Eşik altında otomatik eklenecek kargo ücreti. Desi fark etmez."/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource S.Suffix}" Text="₺" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource S.Hint}">
                                Örnek: 5000 ₺ eşik + 150 ₺ kargo. Müşteri 4.000 ₺ alırsa sipariş kuyruğuna
                                otomatik 150 ₺ kargo satırı eklenir; 5.000 ₺ ve üzeri alırsa kargo ücretsiz.
                                İki alan da boş/0 ise kargo özelliği devre dışıdır.
                            </TextBlock>
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource S.FieldLabel}" Text="Ücretsiz Kargo Kazandın Mesajı"/>
                                <TextBox Text="{Binding ShippingWonTemplate, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="140"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                         FontFamily="{StaticResource S.Font.Mono}" FontSize="12.5"
                                         ToolTip="Müşteri kümülatif eşiği aştıktan sonra ShipNow seçildiğinde gönderilen WhatsApp mesajı."/>
                                <TextBlock Style="{StaticResource S.Hint}"
                                           Text="Placeholder: {ad} {kumulatif_tutar} {tarih}. Boş bırakılırsa mesaj atılmaz."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ Spam Filtresi ═══ -->
            <TabItem Header="Spam Filtresi">
                <StackPanel>
                    <TextBlock Style="{StaticResource S.PaneTitle}" Text="Spam Filtresi"/>
                    <TextBlock Style="{StaticResource S.PaneDesc}"
                               Text="Sohbete düşmeden önce uygulanan kurallar. Sadece açık kurallar uygulanır."
                               Margin="0,4,0,18"/>

                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <CheckBox Content="Spam filtresi açık" IsChecked="{Binding SpamFilterEnabled}"
                                      FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource S.CardTitle}" Text="Kurallar" Margin="0,0,0,14"/>
                            <CheckBox Content="Çift mesajları engelle (30 sn içinde aynı yazı)"
                                      IsChecked="{Binding SpamDropDuplicates}" Margin="0,0,0,12"/>
                            <CheckBox Content="Link içeren mesajları engelle"
                                      IsChecked="{Binding SpamDropLinks}" Margin="0,0,0,12"/>
                            <CheckBox Content="Tamamen büyük harfli (BAĞIRMA) mesajları engelle"
                                      IsChecked="{Binding SpamDropAllCaps}" Margin="0,0,0,12"/>
                            <CheckBox Content="Çok kısa mesajları engelle"
                                      IsChecked="{Binding SpamDropShortMessages}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="54,0,0,12">
                                <TextBlock Text="Minimum karakter" Style="{StaticResource S.FieldLabel}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Width="80"
                                         Text="{Binding SpamMinMessageLength, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding SpamDropShortMessages}"/>
                            </StackPanel>
                            <CheckBox Content="Yasaklı kelime içeren mesajları engelle"
                                      IsChecked="{Binding SpamDropProfanity}" Margin="0,0,0,8"/>
                            <StackPanel Margin="54,0,0,0">
                                <TextBlock Style="{StaticResource S.FieldLabel}" Text="Yasaklı kelimeler (virgül ile ayır)"/>
                                <TextBox IsEnabled="{Binding SpamDropProfanity}"
                                         Text="{Binding SpamBlockedWordsText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="120"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ Form Linki ═══ -->
            <TabItem Header="Form Linki" DataContext="{Binding IntakeForm}">
                <StackPanel>
                    <TextBlock Style="{StaticResource S.PaneTitle}" Text="Müşteri Bilgi Formu"/>
                    <TextBlock Style="{StaticResource S.PaneDesc}"
                               Text="Müşterilerin form doldurup WhatsApp'tan sana mesaj göndermesi için kalıcı bir link."
                               Margin="0,4,0,18"/>
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource S.FieldLabel}" Text="Slug (URL'in son parçası)"/>
                                <TextBox Text="{Binding Slug, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource S.Font.Mono}"
                                         ToolTip="Sadece küçük harf, rakam, tire. 3-32 karakter."/>
                                <TextBlock Style="{StaticResource S.Hint}"
                                           Text="Örnek: 'burakstreamer' → https://license.orderdeckapp.com/r/burakstreamer"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource S.FieldLabel}" Text="WhatsApp telefon (E.164 formatı)"/>
                                <TextBox Text="{Binding WhatsAppPhone, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource S.Font.Mono}"/>
                                <TextBlock Style="{StaticResource S.Hint}" Text="Örnek: +905551234567 (başında + ve ülke kodu olmalı)"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource S.FieldLabel}" Text="Form başlığı (opsiyonel)"/>
                                <TextBox Text="{Binding CustomTitle, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Form sayfasının üstünde görünür. Boş bırakılırsa 'Bilgi Gönder'."/>
                            </StackPanel>
                            <CheckBox Content="Form aktif (kapatırsan link 410 Gone döner)"
                                      IsChecked="{Binding IsActive}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Kaydet" Command="{Binding SaveCommand}"
                                        Style="{StaticResource S.PrimaryButton}" MinWidth="100"/>
                                <Button Content="Linki Kopyala" Command="{Binding CopyLinkCommand}"
                                        MinWidth="120" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Border Background="{StaticResource S.Field}" BorderBrush="{StaticResource S.Line2}"
                                    BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,16,0,0"
                                    Visibility="{Binding HasFormUrl, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Linkin" Style="{StaticResource S.FieldLabel}"/>
                                    <TextBlock Text="{Binding FormUrl}" FontFamily="{StaticResource S.Font.Mono}"
                                               TextWrapping="Wrap" Foreground="{StaticResource S.Amber}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}"
                                       Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ Müşteri App ═══ -->
            <TabItem Header="Müşteri App" DataContext="{Binding ShopperApp}">
                <StackPanel>
                    <TextBlock Style="{StaticResource S.PaneTitle}" Text="Müşteri Uygulaması"/>
                    <TextBlock Style="{StaticResource S.PaneDesc}"
                               Text="Müşterilerine paylaşacağın yayıncı kodu. Müşteri app'ten bu kodu girip seni takip eder."
                               Margin="0,4,0,18"/>
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource S.FieldLabel}" Text="Yayıncı kodu"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding CodeInput, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="20" IsEnabled="{Binding CanEditCode}"
                                         CharacterCasing="Lower" FontFamily="{StaticResource S.Font.Mono}"
                                         ToolTip="3-20 karakter, küçük harf ve rakam (örn. royal, mezat42)"/>
                                <Button Grid.Column="1" Margin="8,0,0,0" Content="Kaydet"
                                        IsEnabled="{Binding CanEditCode}" Command="{Binding SaveCommand}"
                                        Style="{StaticResource S.PrimaryButton}"/>
                            </Grid>

                            <TextBlock Foreground="{StaticResource S.Red}" Margin="0,10,0,0"
                                       Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}"/>
                            <TextBlock Foreground="{StaticResource S.Green}" Margin="0,10,0,0"
                                       Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}"/>
                            <TextBlock Foreground="{StaticResource S.Dim}" Margin="0,10,0,0"
                                       Text="{Binding CooldownMessage}" TextWrapping="Wrap"
                                       Visibility="{Binding CooldownMessage, Converter={StaticResource NullToCollapsedConverter}}"/>

                            <TextBlock Style="{StaticResource S.CardTitle}" Text="Kurallar" Margin="0,18,0,8"/>
                            <TextBlock Style="{StaticResource S.Hint}" Margin="0,0,0,4" Text="• 3-20 karakter, sadece a-z ve 0-9"/>
                            <TextBlock Style="{StaticResource S.Hint}" Margin="0,0,0,4" Text="• Bir kere belirlenince 7 gün boyunca değiştirilemez"/>
                            <TextBlock Style="{StaticResource S.Hint}" Margin="0,0,0,4" Text="• Bu kod sistemde tektir — başka yayıncı kullanıyorsa farklı bir kod seç"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ Kısayollar ═══ -->
            <TabItem Header="Kısayollar">
                <StackPanel>
                    <TextBlock Style="{StaticResource S.PaneTitle}" Text="Kısayollar"/>
                    <TextBlock Style="{StaticResource S.PaneDesc}"
                               Text="Klavye kısayollarını özelleştir."
                               Margin="0,4,0,18"/>
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <CheckBox Content="Özel kısayolları kullan"
                                      IsChecked="{Binding ShortcutsTab.UseCustom}" Margin="0,0,0,14"/>
                            <ItemsControl ItemsSource="{Binding ShortcutsTab.Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="220"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource S.Text}"/>
                                            <controls:ShortcutCaptureButton Grid.Column="1"
                                                Chord="{Binding Chord, Mode=TwoWay}"
                                                IsEnabled="{Binding DataContext.ShortcutsTab.UseCustom,
                                                                     RelativeSource={RelativeSource AncestorType=Window}}"
                                                Padding="10,6"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Kaydet" Command="{Binding ShortcutsTab.SaveCommand}"
                                        Style="{StaticResource S.PrimaryButton}"/>
                                <Button Content="Varsayılana Sıfırla" Command="{Binding ShortcutsTab.ResetToDefaultsCommand}"
                                        Style="{StaticResource S.DangerButton}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
