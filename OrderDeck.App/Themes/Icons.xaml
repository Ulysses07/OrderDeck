<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Tek renkli arayüz ikonları.

    Neden emoji değil: spec §10'un Faz 4 ölçümü "emoji ikon 0" diyor. Emoji
    ayrıca WPF'te renkli çizilemiyor (COLR/CPAL desteği yok), boyutu font
    ailesine göre oynuyor ve Windows sürümüne göre şekil değiştiriyor.

    Neden DrawingImage değil: DarkControls.xaml'daki OD.Icon.Gift gibi ÇOK
    RENKLİ ikonlar DrawingImage olmalı. Bunlar tek renkli — Path olarak
    çizilip Fill'i ana kontrolün Foreground'ından alırlarsa hover/disabled
    durumlarında kendiliğinden doğru renge geçerler.

    Hepsi 24x24 kutuya çizilidir. Kullanım: bir Path'in Data'sına bağla,
    Width/Height'ı OD.Icon.* ölçeğinden ver ve Stretch="Uniform" bırak.
  -->

  <!-- Saat: dış halka (çift daire, EvenOdd ile delik) + akrepler. -->
  <StreamGeometry x:Key="OD.Path.History">
    M2,12 A10,10 0 1 0 22,12 A10,10 0 1 0 2,12 Z
    M4,12 A8,8 0 1 0 20,12 A8,8 0 1 0 4,12 Z
    M11,6 L13,6 L13,11 L17,11 L17,13 L11,13 Z
  </StreamGeometry>

  <!-- İki kişi. Şekiller üst üste bindiği için F1 (Nonzero): EvenOdd olsaydı
       kesişimler delik olurdu. -->
  <StreamGeometry x:Key="OD.Path.Customers">
    F1
    M5.5,8 A3.5,3.5 0 1 0 12.5,8 A3.5,3.5 0 1 0 5.5,8 Z
    M2.5,20 C2.5,16.5 5.5,14.5 9,14.5 C12.5,14.5 15.5,16.5 15.5,20 Z
    M14,8.5 A3,3 0 1 0 20,8.5 A3,3 0 1 0 14,8.5 Z
    M17,14.5 C19.8,14.5 22,16.4 22,20 L17.3,20 C17.3,17.6 16.6,15.9 15.4,14.8
    C15.9,14.6 16.4,14.5 17,14.5 Z
  </StreamGeometry>

  <!-- Yasak işareti: halka + çapraz çubuk. Çubuk iç dairenin İÇİNDE kalıyor,
       o yüzden EvenOdd sayımı tek çıkıyor ve çubuk dolu görünüyor. -->
  <StreamGeometry x:Key="OD.Path.Blacklist">
    M2,12 A10,10 0 1 0 22,12 A10,10 0 1 0 2,12 Z
    M4,12 A8,8 0 1 0 20,12 A8,8 0 1 0 4,12 Z
    M5.8,7.2 L7.2,5.8 L18.2,16.8 L16.8,18.2 Z
  </StreamGeometry>

  <!-- Belge: köşesi kıvrık sayfa + iki satır. Kıvrım ve satırlar EvenOdd ile
       oyuk kalıyor. -->
  <StreamGeometry x:Key="OD.Path.Receipt">
    M5,2 L14,2 L19,7 L19,22 L5,22 Z
    M14,2 L19,7 L14,7 Z
    M7,11 L17,11 L17,13 L7,13 Z
    M7,15 L14,15 L14,17 L7,17 Z
  </StreamGeometry>

  <!-- Konuşma balonu + iki satır (oyuk). -->
  <StreamGeometry x:Key="OD.Path.Message">
    M3,4 L21,4 L21,17 L13,17 L8,21 L8,17 L3,17 Z
    M6,8 L18,8 L18,10 L6,10 Z
    M6,12 L14,12 L14,14 L6,14 Z
  </StreamGeometry>

  <!-- Zil. Gövde ile tokmak ayrı figür; üst üste binmedikleri için EvenOdd
       sorun çıkarmıyor. -->
  <StreamGeometry x:Key="OD.Path.Bell">
    M12,2 C15.3,2 18,4.7 18,8 L18,14 L20,17 L4,17 L6,14 L6,8 C6,4.7 8.7,2 12,2 Z
    M9.5,18.5 L14.5,18.5 A2.5,2.5 0 0 1 9.5,18.5 Z
  </StreamGeometry>

  <!-- Göz: dış badem + gözbebeği (EvenOdd ile oyuk). -->
  <StreamGeometry x:Key="OD.Path.Eye">
    M12,5 C17,5 21,9 22,12 C21,15 17,19 12,19 C7,19 3,15 2,12 C3,9 7,5 12,5 Z
    M8.5,12 A3.5,3.5 0 1 0 15.5,12 A3.5,3.5 0 1 0 8.5,12 Z
  </StreamGeometry>

  <!-- Üç nokta (taşma menüsü). -->
  <StreamGeometry x:Key="OD.Path.More">
    F1
    M4,12 A2,2 0 1 0 8,12 A2,2 0 1 0 4,12 Z
    M10,12 A2,2 0 1 0 14,12 A2,2 0 1 0 10,12 Z
    M16,12 A2,2 0 1 0 20,12 A2,2 0 1 0 16,12 Z
  </StreamGeometry>

  <!-- Çarpı (çekmeceyi kapat). İki çapraz çubuk; kesişimleri EvenOdd ile
       oyuk kalmasın diye F1 (Nonzero). -->
  <StreamGeometry x:Key="OD.Path.Close">
    F1
    M5.6,4.2 L12,10.6 L18.4,4.2 L19.8,5.6 L13.4,12 L19.8,18.4 L18.4,19.8
    L12,13.4 L5.6,19.8 L4.2,18.4 L10.6,12 L4.2,5.6 Z
  </StreamGeometry>

  <!-- Takvim: gövde + iç oyuk (üstte başlık bandı bırakır) + iki halka.
       Halkalar gövdeye DEĞMİYOR (y=2..5, gövde y=5'ten başlıyor): EvenOdd
       sayımında üst üste binen bölge oyuk çıkardı. -->
  <StreamGeometry x:Key="OD.Path.Calendar">
    M3,5 L21,5 L21,21 L3,21 Z
    M5,10 L19,10 L19,19 L5,19 Z
    M7,2 L9,2 L9,5 L7,5 Z
    M15,2 L17,2 L17,5 L15,5 Z
  </StreamGeometry>

  <!-- Ok başları (takvimde önceki/sonraki ay). Tek kapalı çokgen, oyuk yok. -->
  <StreamGeometry x:Key="OD.Path.ChevronLeft">
    M14.5,5.4 L15.9,6.8 L10.7,12 L15.9,17.2 L14.5,18.6 L7.9,12 Z
  </StreamGeometry>
  <StreamGeometry x:Key="OD.Path.ChevronRight">
    M9.5,5.4 L8.1,6.8 L13.3,12 L8.1,17.2 L9.5,18.6 L16.1,12 Z
  </StreamGeometry>

  <!--
    İkon Path'i. Fill'i en yakın Button'ın Foreground'ından alır: NavButton'ın
    hover tetikleyicisi Foreground'u değiştirdiğinde ikon da onunla birlikte
    döner, ayrıca tetikleyici yazmaya gerek kalmaz.
  -->
  <Style x:Key="OD.IconPath" TargetType="Path">
    <Setter Property="Width"  Value="{StaticResource OD.Icon.Md}"/>
    <Setter Property="Height" Value="{StaticResource OD.Icon.Md}"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Fill"
            Value="{Binding Foreground,
                    RelativeSource={RelativeSource AncestorType=Button}}"/>
  </Style>
</ResourceDictionary>
