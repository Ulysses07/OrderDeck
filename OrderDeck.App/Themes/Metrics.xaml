<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!--
    OrderDeck ölçü tokenları.

    Bu dosyanın dışında sabit sayı KULLANILMAZ. Uygulamada bugün 18 farklı
    FontSize var; ölçek altı basamağa indi ve orada kalması bu sözlüğün tek
    kaynak olmasına bağlı. Yeni bir değer gerekiyorsa önce buraya eklenir.
  -->

  <!-- Font aileleri. Gömülü .ttf'ler pack URI ile: klasör + "#" + yüz adı.
       Sans 400/500/600, Mono 400/500/700, Display yalnız 700 kullanılıyor. -->
  <FontFamily x:Key="OD.Font.Sans">pack://application:,,,/OrderDeck.App;component/Fonts/#IBM Plex Sans</FontFamily>
  <FontFamily x:Key="OD.Font.Mono">pack://application:,,,/OrderDeck.App;component/Fonts/#JetBrains Mono</FontFamily>
  <!-- Aile adı "Bricolage Grotesque 14pt" — ölçüldü; kısaltılmış hâli kısmi
       eşleşme yapıp sentezlenmiş bir ağırlık (900) daha ekliyor. -->
  <FontFamily x:Key="OD.Font.Display">pack://application:,,,/OrderDeck.App;component/Fonts/#Bricolage Grotesque 14pt</FontFamily>

  <!-- Tip ölçeği: 6 basamak -->
  <sys:Double x:Key="OD.Font.F0">11</sys:Double>    <!-- mikro etiket, rozet, saat -->
  <sys:Double x:Key="OD.Font.F1">12.5</sys:Double>  <!-- ikincil metin, kullanıcı adı -->
  <sys:Double x:Key="OD.Font.F2">14</sys:Double>    <!-- GÖVDE (varsayılan) -->
  <sys:Double x:Key="OD.Font.F3">20</sys:Double>    <!-- panel başlığı, ürün adı -->
  <sys:Double x:Key="OD.Font.F4">32</sys:Double>    <!-- istatistik değeri, fiyat -->
  <sys:Double x:Key="OD.Font.F5">64</sys:Double>    <!-- aktif ürün kodu (tek yer) -->

  <!-- Boşluk ölçeği: 7 basamak -->
  <sys:Double x:Key="OD.Space.1">2</sys:Double>   <!-- kıl payı: liste satırları arası -->
  <sys:Double x:Key="OD.Space.2">4</sys:Double>   <!-- çok dar: rozet içi dikey dolgu -->
  <sys:Double x:Key="OD.Space.3">8</sys:Double>   <!-- dar: satır içi, ikon-metin arası -->
  <sys:Double x:Key="OD.Space.4">12</sys:Double>  <!-- panel içi standart -->
  <sys:Double x:Key="OD.Space.5">16</sys:Double>  <!-- blok arası, başlık dolgusu -->
  <sys:Double x:Key="OD.Space.6">20</sys:Double>  <!-- geniş: kenar çubuğu yan dolgu -->
  <sys:Double x:Key="OD.Space.7">24</sys:Double>  <!-- en geniş: hero yan dolgu -->

  <!-- Aynı ölçeğin Thickness hali. WPF'te CSS 'gap' karşılığı yok; boşluk
       Margin/Padding ile verilir, o yüzden her basamağın iki biçimi var. -->
  <Thickness x:Key="OD.Pad.1">2</Thickness>
  <Thickness x:Key="OD.Pad.2">4</Thickness>
  <Thickness x:Key="OD.Pad.3">8</Thickness>
  <Thickness x:Key="OD.Pad.4">12</Thickness>
  <Thickness x:Key="OD.Pad.5">16</Thickness>
  <Thickness x:Key="OD.Pad.6">20</Thickness>
  <Thickness x:Key="OD.Pad.7">24</Thickness>

  <!-- Tek yönlü boşluklar. Simetrik OD.Pad.* yetmediği yerlerde; sayı XAML'a
       değil buraya yazılsın diye token. WPF'te Margin="0,{StaticResource X},0,0"
       geçersiz — Thickness içine markup extension gömülemez, tam Thickness
       tokenı gerekir.
       Basamak numarası simetrik kardeşiyle AYNI değeri gösterir:
       Top5 = OD.Pad.5 = OD.Space.5 = 16. Numara/değer eşleşmesi bozulursa
       token okunurluğunu kaybeder — yeni bir tek yönlü token eklerken
       değeri OD.Space.* ölçeğinden seç. -->
  <Thickness x:Key="OD.Pad.Top3"    Left="0" Top="8"  Right="0" Bottom="0"/>
  <Thickness x:Key="OD.Pad.Top4"    Left="0" Top="12" Right="0" Bottom="0"/>
  <Thickness x:Key="OD.Pad.Top5"    Left="0" Top="16" Right="0" Bottom="0"/>
  <Thickness x:Key="OD.Pad.Top6"    Left="0" Top="20" Right="0" Bottom="0"/>
  <Thickness x:Key="OD.Pad.Bottom3" Left="0" Top="0"  Right="0" Bottom="8"/>
  <Thickness x:Key="OD.Pad.Bottom5" Left="0" Top="0"  Right="0" Bottom="16"/>
  <Thickness x:Key="OD.Pad.Left4"   Left="12" Top="0" Right="0" Bottom="0"/>

  <!-- Yatay-yalnız boşluklar. Yüksekliği sabit şeritlerde (üst bar 56px,
       içindeki birincil buton 46px) dikey margin içeriği kırpar; kırpma
       exception atmadığı için ancak ekranda fark edilir. -->
  <Thickness x:Key="OD.Pad.X2" Left="4"  Top="0" Right="4"  Bottom="0"/>
  <Thickness x:Key="OD.Pad.X5" Left="16" Top="0" Right="16" Bottom="0"/>

  <!-- Köşe yarıçapı: 5 basamak -->
  <CornerRadius x:Key="OD.Radius.Xs">4</CornerRadius>     <!-- çip, kod parçacığı -->
  <CornerRadius x:Key="OD.Radius.Sm">6</CornerRadius>     <!-- input, küçük buton -->
  <CornerRadius x:Key="OD.Radius.Md">8</CornerRadius>     <!-- satır, buton, banner -->
  <CornerRadius x:Key="OD.Radius.Lg">10</CornerRadius>    <!-- panel, kart -->
  <CornerRadius x:Key="OD.Radius.Full">999</CornerRadius> <!-- hap -->

  <!-- İkon ölçüsü: 4 basamak (Path/Viewbox kenar uzunluğu) -->
  <sys:Double x:Key="OD.Icon.Sm">14</sys:Double>
  <sys:Double x:Key="OD.Icon.Md">16</sys:Double>
  <sys:Double x:Key="OD.Icon.Lg">20</sys:Double>
  <sys:Double x:Key="OD.Icon.Xl">26</sys:Double>

  <!-- Düzen sabitleri -->
  <sys:Double x:Key="OD.Layout.SideWidth">224</sys:Double>      <!-- sol kenar çubuğu -->
  <sys:Double x:Key="OD.Layout.SideWidthMin">64</sys:Double>    <!-- ikon modu (<1360px) -->
  <!-- Sağ panel 344 değil 400 (2026-08-08): kod ve fiyat kutuları üstteki
       şeritten buraya indi, 64px'lik kod yazısı 344'te nefes alamıyordu.
       Sohbetin daralması da istenen sonuçtu. -->
  <sys:Double x:Key="OD.Layout.RightWidth">400</sys:Double>     <!-- sağ panel -->
  <sys:Double x:Key="OD.Layout.DrawerWidth">400</sys:Double>    <!-- çekmece (sağ paneli örter) -->
  <sys:Double x:Key="OD.Layout.TopbarHeight">56</sys:Double>
  <sys:Double x:Key="OD.Layout.ButtonHeight">46</sys:Double>    <!-- birincil buton -->
  <!-- Yayın butonu iki durumda iki farklı metin taşıyor ("Yayın Başlat" /
       "Yayını Bitir"). İçeriğe göre ölçülürse buton durum değişince
       genişliğini oynatır ve yanındaki Çekiliş butonunu kaydırır; sabit
       genişlik ikisini de aynı boyda tutar. 132 = uzun metnin ölçülen
       genişliği (~120) + nefes payı. -->
  <sys:Double x:Key="OD.Layout.StreamButtonWidth">132</sys:Double>
  <sys:Double x:Key="OD.Layout.ContentMaxWidth">1760</sys:Double> <!-- fazlası ortalanır -->
  <!-- Takvim gün hücresi (OD.DatePicker). Kare ve sabit: 7 sütun içeriğe göre
       ölçülürse "1" ile "30" farklı genişlik alır ve haftalar hizasız çıkar. -->
  <sys:Double x:Key="OD.Layout.CalendarCell">32</sys:Double>

  <!-- Anahtar düğme (OD.Toggle). Ray ile topuz ayrı token: topuz raydan
       2 (OD.Space.1) küçük olmalı, ikisi tek sayıdan türetilemez.
       Köşe yarıçapı token değil OD.Radius.Full — 999 her iki ölçüde de
       yarım daireye kırpılıyor. -->
  <sys:Double x:Key="OD.Layout.ToggleWidth">40</sys:Double>
  <sys:Double x:Key="OD.Layout.ToggleHeight">24</sys:Double>
  <sys:Double x:Key="OD.Layout.ToggleThumb">18</sys:Double>

  <!-- Kaydırgaç (OD.Slider, çekiliş ses seviyesi). Ray ince, topuz ray
       yüksekliğini aştığı için ikisi ayrı ölçü. -->
  <sys:Double x:Key="OD.Layout.SliderTrack">4</sys:Double>
  <sys:Double x:Key="OD.Layout.SliderThumb">16</sys:Double>
  <!-- Pencerenin asgari ölçüsü (MainWindow.MinWidth/MinHeight).
       1280 değil 960: 1920'lik ekranda yarım pencere tam 960 ve operatör
       uygulamayı yayın/tarayıcı yanına böyle koyuyor. 1360 kırılımı zaten
       kenar çubuğunu ikon rayına indiriyor, 960'ta yerleşim taşmadan sığar. -->
  <sys:Double x:Key="OD.Layout.AppMinWidth">960</sys:Double>
  <sys:Double x:Key="OD.Layout.AppMinHeight">720</sys:Double>
  <!-- Açılış ölçüsü. 1280x800 DEĞİL: o ölçü hem 1360 hem 850 kırılımının
       altında kalıyor, yani uygulama her açılışta indirgenmiş yerleşimle
       (ikon rayı + kısa ürün görseli + küçük kod yazısı) başlıyordu.
       İndirgeme dar ekranın çaresi olmalı, varsayılan hâl değil. -->
  <sys:Double x:Key="OD.Layout.AppStartWidth">1440</sys:Double>
  <sys:Double x:Key="OD.Layout.AppStartHeight">900</sys:Double>

  <!-- Faz 1'e özgü ölçüler. Mockup'ta CSS değişkeni olarak duruyorlar
       (h-pimg, h-q-min, w-col-*, w-user); WPF'te sabit sayı yazmamak
       için token'a çevrildiler.
       NOT: CSS değişken adlarını iki tireli hâliyle yazma — XML yorumu
       içinde iki ardışık tire yasak (MC3000). -->
  <sys:Double x:Key="OD.Layout.ProductImageHeight">142</sys:Double>
  <!-- Alçak pencerede (<850px) ürün görseli kısalır: mockup
       @media (max-height:849px) altında h-pimg 56px. -->
  <sys:Double x:Key="OD.Layout.ProductImageHeightShort">56</sys:Double>
  <sys:Double x:Key="OD.Layout.QueueMinHeight">64</sys:Double>
  <sys:Double x:Key="OD.Layout.ChatBadgeColumn">28</sys:Double>
  <sys:Double x:Key="OD.Layout.ChatUserMaxWidth">132</sys:Double>
  <!-- Aktif ürün kodunun yazı boyu; alçak pencerede (<850px) küçüğü.
       Font ölçeğine (F0..F5) yeni basamak eklemiyoruz — bu, tek bir
       kontrolün duyarlı ölçüsü, tipografi basamağı değil.
       Spec §7 bunları 64/44 diyordu; kod ve fiyat üstteki tam genişlik
       şeritten sağ sütuna inince (2026-08-08) o boy gereksiz yer
       kaplıyordu, 44/32'ye indirildi. Kazanılan yükseklik doğrudan
       yazdırılacak etiketler listesine gitti. -->
  <sys:Double x:Key="OD.Layout.CodeFont">44</sys:Double>
  <sys:Double x:Key="OD.Layout.CodeFontShort">32</sys:Double>
</ResourceDictionary>
