<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        "Yeni Çekiliş" dialoguna özel tema. SettingsTheme'i merge eder (paylaşılan
        ToggleSwitch/ModernTextBox/ModernComboBox/PrimaryButton/Card + fontlar) ama
        AKSANI AMBER'e çevirir (çekiliş = kutlama). Yalnız NewGiveawayDialog'a
        scope'lu. SettingsTheme'in aksan stilleri DynamicResource S.Accent kullanır;
        burada S.Accent'i amber'e set ettiğimiz için toggle/odak/primary buton amber olur.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/SettingsTheme.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Aksan override: amber (SettingsTheme'in kırmızı default'unu gölgeler) -->
    <SolidColorBrush x:Key="S.Accent"      Color="#FFB23E"/>
    <SolidColorBrush x:Key="S.AccentSoft"  Color="#24FFB23E"/>
    <SolidColorBrush x:Key="S.AccentHover" Color="#FFC061"/>

    <!-- ── Chip (ListBoxItem) — süre + platform seçimi ───────────────────── -->
    <Style x:Key="S.Chip" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource S.Font.Body}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource S.Dim}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{StaticResource S.Field}"
                            BorderBrush="{StaticResource S.Line2}" BorderThickness="1"
                            CornerRadius="9" Padding="13,8" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource S.Dim2}"/>
                            <Setter Property="Foreground" Value="{StaticResource S.Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource S.AccentSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource S.Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource S.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── ChipList (ListBox) — yatay sarmalı, çerçevesiz ────────────────── -->
    <Style x:Key="S.ChipList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource S.Chip}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Stepper butonu (− / +) — kare, ghost tabanlı ──────────────────── -->
    <Style x:Key="S.StepperBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
</ResourceDictionary>
