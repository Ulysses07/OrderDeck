<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Faz 1'in tükettiği bileşen stilleri. Spec §9: Style'lar önden değil,
      TÜKETİLDİKLERİ fazda yazılır — kullanılmayan stil doğrulanmamış tasarım
      borcudur. Faz 2-4 kendi ihtiyaçlarını buraya ekleyecek.

      Buradaki hiçbir değer sabit değil: renk Colors.xaml'den, ölçü
      Metrics.xaml'den, süre Motion.xaml'den geliyor. App.xaml bu üçünü
      Controls.xaml'den ÖNCE merge ediyor, StaticResource çözülüyor.
    -->

    <!-- Panel/kart yüzeyi: sohbet paneli, ürün kartı, kuyruk, hero. -->
    <Style x:Key="OD.Panel" TargetType="Border">
        <Setter Property="Background"   Value="{StaticResource OD.Brush.Surface}"/>
        <Setter Property="BorderBrush"  Value="{StaticResource OD.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource OD.Radius.Lg}"/>
    </Style>

    <!-- Birincil eylem: Yazdır. Mockup .btn-print -->
    <Style x:Key="OD.Button.Primary" TargetType="Button">
        <Setter Property="Height"     Value="{StaticResource OD.Layout.ButtonHeight}"/>
        <Setter Property="Background" Value="{StaticResource OD.Brush.Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource OD.Brush.OnAccent}"/>
        <Setter Property="FontFamily" Value="{StaticResource OD.Font.Sans}"/>
        <Setter Property="FontSize"   Value="{StaticResource OD.Font.F2}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <!-- Yalnız yatay: Height sabit 46, simetrik dolgu içeriği kırpardı. -->
        <Setter Property="Padding"    Value="{StaticResource OD.Pad.X5}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource OD.Radius.Md}"
                            RenderTransformOrigin="0.5,0.5">
                        <Grid>
                            <!-- Hover örtüsü. Eskiden hover'da arka plan sabit
                                 AccentHot'a çevriliyordu; bu stil artık tek
                                 renkli değil (yayın butonu kapalıyken yeşil,
                                 açıkken kırmızı). Şablon içindeki TargetName
                                 setter'ı dışarıdaki Style/DataTrigger'dan
                                 EZİLEMEZ — o yüzden hover rengi şablondan
                                 çıkarıldı. Yarı saydam beyaz örtü altındaki
                                 rengi bilmeden aydınlatır.
                                 Padding buradan ContentPresenter'a taşındı:
                                 örtü butonun tamamını kaplasın. -->
                            <Border x:Name="Veil" Opacity="0"
                                    Background="{StaticResource OD.Brush.OnAccent}"
                                    CornerRadius="{StaticResource OD.Radius.Md}"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}">
                                <ContentPresenter.Resources>
                                    <!-- DarkControls.xaml'de örtük bir TextBlock
                                         stili var ve Foreground'u sabitliyor.
                                         Örtük stil MİRAS ALINAN değeri yener, yani
                                         ContentPresenter'ın metin için ürettiği
                                         TextBlock butonun Foreground'unu HİÇ
                                         görmüyordu — OnAccent setter'ı ölü değerdi,
                                         kırmızı zeminde fark edilmemişti. Yeşil
                                         zeminde açık yazı 2.2:1'e düşünce çıktı.
                                         Stil ContentPresenter'ın KENDİ sözlüğünde
                                         olmalı: ControlTemplate.Resources'a
                                         konursa üretilen TextBlock oraya bakmıyor
                                         (ölçüldü), uygulama sözlüğünü buluyor. -->
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{Binding Foreground,
                                                        RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Veil" Property="Opacity" Value="0.14"/>
                            <!-- 1px yukarı kalkma. Transform'a x:Name verip
                                 TargetName ile Y'yi kurcalamak MC4111 verir:
                                 tetikleyici yalnız şablonun eleman ağacındaki
                                 adlara erişir, RenderTransform içindeki nesneye
                                 değil. Bu yüzden transform'un TAMAMI Border'a
                                 tetikleyiciden set ediliyor. -->
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-1"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- İkincil eylem: birincilin YANINDAKİ gerçek seçenek ("Kargo Beklesin",
         "Beklemeye Devam"). Faz 2b'de ölçümle doğdu — o iki çekmecede dikey
         dizilen ikinci düğme Ghost'la yazılmıştı ve düğme gibi görünmüyordu:
         Ghost çerçevesiz ve içeriği SOLA yaslı (nav öğesi kalıbı), tam
         genişlikte kullanılınca liste satırı gibi okunuyor.

         Birincilden farkı yalnız zemin: aynı yükseklik, aynı yazı ölçüsü,
         ortalanmış içerik, dolgu yerine 1px çerçeve. Böylece iki düğme yan
         yana ya da alt alta aynı ağırlıkta duruyor, hiyerarşiyi renk
         söylüyor. -->
    <Style x:Key="OD.Button.Secondary" TargetType="Button">
        <Setter Property="Height"     Value="{StaticResource OD.Layout.ButtonHeight}"/>
        <Setter Property="Foreground" Value="{StaticResource OD.Brush.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource OD.Font.Sans}"/>
        <Setter Property="FontSize"   Value="{StaticResource OD.Font.F2}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Padding"    Value="{StaticResource OD.Pad.X5}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent"
                            BorderBrush="{StaticResource OD.Brush.BorderStrong}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource OD.Radius.Md}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}">
                            <ContentPresenter.Resources>
                                <!-- Birincildeki tuzağın aynısı: DarkControls'ün
                                     örtük TextBlock stili miras alınan Foreground'u
                                     yener, yani yukarıdaki setter içerik metnine
                                     hiç ulaşmaz. Ölçüldü — düğme yazısı sönük
                                     çıkıyordu. Sözlük ContentPresenter'ın KENDİsinde
                                     olmalı. -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground,
                                                    RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource OD.Brush.Surface2}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Arka planı olmayan buton: nav öğeleri, "Temizle", ikon butonları. -->
    <Style x:Key="OD.Button.Ghost" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource OD.Brush.TextDim}"/>
        <Setter Property="FontFamily" Value="{StaticResource OD.Font.Sans}"/>
        <Setter Property="FontSize"   Value="{StaticResource OD.Font.F2}"/>
        <Setter Property="Padding"    Value="{StaticResource OD.Pad.4}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent"
                            CornerRadius="{StaticResource OD.Radius.Md}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource OD.Brush.Surface2}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource OD.Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Çip: sohbet başlığındaki "Sadece A12". Mockup .chip -->
    <Style x:Key="OD.Chip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource OD.Brush.TextDim}"/>
        <Setter Property="FontFamily" Value="{StaticResource OD.Font.Sans}"/>
        <Setter Property="FontSize"   Value="{StaticResource OD.Font.F1}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding"    Value="{StaticResource OD.Pad.4}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{StaticResource OD.Brush.Surface2}"
                            BorderBrush="{StaticResource OD.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource OD.Radius.Sm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground"
                                    Value="{StaticResource OD.Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource OD.Brush.Accent}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource OD.Brush.AccentHot}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Metin girişi. Mockup .search / .input.
         TargetType Border DEĞİL TextBox: Faz 1'de bu stil altı yerde
         doğrudan bir TextBox'a uygulanıyor (kod, fiyat, sohbet arama, ürün
         adı, beden dizesi, adet). TextBox'ta CornerRadius özelliği yok, o
         yüzden yuvarlatma ControlTemplate içindeki Border'dan geliyor —
         WPF'te "yuvarlak input" için tek doğru yol bu. -->
    <Style x:Key="OD.TextBox" TargetType="TextBox">
        <Setter Property="Background"      Value="{StaticResource OD.Brush.Surface2}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource OD.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="{StaticResource OD.Pad.4}"/>
        <Setter Property="Foreground"      Value="{StaticResource OD.Brush.Text}"/>
        <Setter Property="CaretBrush"      Value="{StaticResource OD.Brush.Text}"/>
        <Setter Property="FontFamily"      Value="{StaticResource OD.Font.Sans}"/>
        <Setter Property="FontSize"        Value="{StaticResource OD.Font.F2}"/>
        <!-- Varsayılan Center: tek satırlık kutular (çoğunluk) dikeyde ortalı
             kalsın. Çok satırlı kutu VerticalContentAlignment="Top" diyerek
             metni üste çekebilsin diye şablon bu değeri OKUYOR, sabitlemiyor —
             sabit Center yüzünden not alanı metni kutunun ortasında asılı
             kalıyordu. -->
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource OD.Radius.Sm}">
                        <Grid>
                            <!-- PART_ContentHost adı zorunlu: TextBox metni
                                 buraya yerleştirir, adı değişirse kutu boş görünür. -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <!-- İpucu metni Tag'den okunur: Tag="Ara…" yazan her
                                 kutu placeholder kazanır, ek kod gerekmez.
                                 WPF'in yerleşik placeholder'ı yok; alternatif her
                                 kutunun yanına elle bir TextBlock + DataTrigger
                                 koymaktı (CustomerSearchDialog'da öyle yapılmış).
                                 Şablona alındı ki Faz 2'nin çekmecelerindeki
                                 onlarca giriş kutusu bunu tekrarlamasın.
                                 IsHitTestVisible=False: tıklama alttaki kutuya
                                 geçsin, ipucu fareyi yutmasın. -->
                            <TextBlock x:Name="Hint"
                                       Text="{TemplateBinding Tag}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{StaticResource OD.Brush.TextMute}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{StaticResource OD.Brush.Accent}"/>
                        </Trigger>
                        <!-- Odakta da görünür kalır; yazı girilince kaybolur.
                             Odakta gizlemek, boş kutuya tıklayan operatörün
                             ne yazacağını tam o anda unutturur. -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Tarih seçici ═══════════════════════════════════════════════════
         Faz 2b (2026-08-10), DekontEkleDrawer'ın "ÖDEME TARİHİ" alanı için.
         DarkControls.xaml uygulamadaki ~20 yerleşik kontrolü karartıyor ama
         DatePicker ile Calendar o listede HİÇ yoktu: koyu formun ortasında
         bembeyaz bir kutu ve açık renkli bir takvim çıkıyordu. Pencere
         sürümünde de öyleydi — yani regresyon değil, dönüşümle görünür hale
         gelen eski bir açık.

         Beş stil gerekiyor, çünkü WPF'in tarih seçicisi beş ayrı kontrolden
         kurulu: DatePicker (kutu + düğme + popup), içindeki DatePickerTextBox,
         popup'a KODLA yerleştirilen Calendar (o yüzden şablondan değil
         CalendarStyle özelliğinden veriliyor), takvimin gövdesi CalendarItem
         ve hücreler CalendarDayButton (gün) / CalendarButton (ay-yıl).

         Yalnız gereken şablonlar ve renkler yazıldı. WPF'te açık stil tema
         stilini komple değiştirmez, yalnız YAZDIĞI özelliklerde yener; bu
         yüzden Calendar'ın kendi ControlTemplate'ine dokunulmadı — hücre
         yerleşimini varsayılan tema kurmaya devam ediyor. -->

    <Style x:Key="OD.CalendarDayButton" TargetType="CalendarDayButton">
        <Setter Property="FontFamily" Value="{StaticResource OD.Font.Sans}"/>
        <Setter Property="FontSize"   Value="{StaticResource OD.Font.F1}"/>
        <Setter Property="Foreground" Value="{StaticResource OD.Brush.Text}"/>
        <Setter Property="Width"      Value="{StaticResource OD.Layout.CalendarCell}"/>
        <Setter Property="Height"     Value="{StaticResource OD.Layout.CalendarCell}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            Margin="{StaticResource OD.Pad.1}"
                            CornerRadius="{StaticResource OD.Radius.Xs}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <!-- Düğme stillerindeki tuzağın aynısı: DarkControls'ün
                                     örtük TextBlock stili miras alınan Foreground'u
                                     yener, yani seçili günün yazısı OnAccent'e hiç
                                     dönmezdi. -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground,
                                                    RelativeSource={RelativeSource AncestorType=CalendarDayButton}}"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Komşu ayların taşan günleri: görünür ama sönük. -->
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource OD.Brush.TextMute}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource OD.Brush.Surface2}"/>
                        </Trigger>
                        <!-- Bugün yalnız çerçeveyle işaretli; dolgu seçime ayrıldı,
                             ikisi aynı anda doluysa hangisi seçili anlaşılmıyor. -->
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource OD.Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource OD.Brush.Accent}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource OD.Brush.Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource OD.Brush.OnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ay ve yıl hücreleri: başlığa tıklanınca açılan iki üst görünüm.
         Gün hücresiyle aynı dil, yalnız kare değil (içerik "Oca".."Ara"). -->
    <Style x:Key="OD.CalendarButton" TargetType="CalendarButton">
        <Setter Property="FontFamily" Value="{StaticResource OD.Font.Sans}"/>
        <Setter Property="FontSize"   Value="{StaticResource OD.Font.F1}"/>
        <Setter Property="Foreground" Value="{StaticResource OD.Brush.Text}"/>
        <Setter Property="MinHeight"  Value="{StaticResource OD.Layout.CalendarCell}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            Margin="{StaticResource OD.Pad.1}"
                            Padding="{StaticResource OD.Pad.2}"
                            CornerRadius="{StaticResource OD.Radius.Xs}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground,
                                                    RelativeSource={RelativeSource AncestorType=CalendarButton}}"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource OD.Brush.TextMute}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource OD.Brush.Surface2}"/>
                        </Trigger>
                        <!-- CalendarButton'da IsSelected YOK (ölçüldü, MC4109).
                             Karşılığı HasSelectedDays: seçili tarihi İÇEREN ay/yıl
                             hücresi — burada aranan vurgu zaten bu. -->
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource OD.Brush.Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource OD.Brush.OnAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Takvimin gövdesi: başlık şeridi + gün ızgarası + ay/yıl ızgarası.
         PART_* adları ZORUNLU — CalendarItem hücreleri koddan bu ızgaralara
         yerleştiriyor, ad değişirse takvim boş açılır. Sütun/satır sayıları da
         sabit: ay görünümü 7x7 (ilk satır gün adları), yıl görünümü 4x3. -->
    <Style x:Key="OD.CalendarItem" TargetType="CalendarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <!-- Gün adı başlıkları. Anahtar x:Static olmak ZORUNDA:
                             CalendarItem bu şablonu adıyla değil, yalnız bu
                             ComponentResourceKey ile ve yalnız kendi
                             Template.Resources'ında arıyor. -->
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Text="{Binding}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="{StaticResource OD.Pad.2}"
                                       FontFamily="{StaticResource OD.Font.Sans}"
                                       FontSize="{StaticResource OD.Font.F0}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OD.Brush.TextMute}"/>
                        </DataTemplate>
                        <!-- Başlık şeridinin üç düğmesi (önceki / ay-yıl / sonraki).
                             Örtük stil: şablon içinde kaldığı için yalnız bu üçünü
                             yakalıyor, DarkControls'ün genel Button stilini burada
                             yeniyor. -->
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource OD.Brush.TextDim}"/>
                            <Setter Property="FontFamily" Value="{StaticResource OD.Font.Sans}"/>
                            <Setter Property="FontSize"   Value="{StaticResource OD.Font.F1}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Cursor"     Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent"
                                                Padding="{StaticResource OD.Pad.3}"
                                                CornerRadius="{StaticResource OD.Radius.Xs}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center">
                                                <ContentPresenter.Resources>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground"
                                                                Value="{Binding Foreground,
                                                                        RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                    </Style>
                                                </ContentPresenter.Resources>
                                            </ContentPresenter>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource OD.Brush.Surface2}"/>
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource OD.Brush.Text}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ControlTemplate.Resources>

                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource OD.Radius.Md}"
                            Padding="{StaticResource OD.Pad.3}">
                        <Grid x:Name="PART_Root">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PART_PreviousButton" Grid.Column="0">
                                    <Path Data="{StaticResource OD.Path.ChevronLeft}"
                                          Style="{StaticResource OD.IconPath}"
                                          Width="{StaticResource OD.Icon.Sm}"
                                          Height="{StaticResource OD.Icon.Sm}"/>
                                </Button>
                                <Button x:Name="PART_HeaderButton" Grid.Column="1"
                                        Foreground="{StaticResource OD.Brush.Text}"/>
                                <Button x:Name="PART_NextButton" Grid.Column="2">
                                    <Path Data="{StaticResource OD.Path.ChevronRight}"
                                          Style="{StaticResource OD.IconPath}"
                                          Width="{StaticResource OD.Icon.Sm}"
                                          Height="{StaticResource OD.Icon.Sm}"/>
                                </Button>
                            </Grid>

                            <Grid x:Name="PART_MonthView" Grid.Row="1" Visibility="Visible">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                            </Grid>

                            <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Hidden">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/>
                                    <ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                            </Grid>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Görünüm değişimi şablonun işi: CalendarItem iki ızgarayı da
                             doldurur ama hangisinin görüneceğini söylemez. -->
                        <DataTrigger Value="Year"
                                     Binding="{Binding DisplayMode,
                                               RelativeSource={RelativeSource AncestorType=Calendar}}">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_YearView"  Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Value="Decade"
                                     Binding="{Binding DisplayMode,
                                               RelativeSource={RelativeSource AncestorType=Calendar}}">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_YearView"  Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Takvimin kendisi. Şablon yazılmıyor; zemin/kenarlık buradan verilince
         varsayılan şablon bunları CalendarItem'a TemplateBinding ile geçiriyor. -->
    <Style x:Key="OD.Calendar" TargetType="Calendar">
        <Setter Property="Background"      Value="{StaticResource OD.Brush.Surface}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource OD.Brush.BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground"      Value="{StaticResource OD.Brush.Text}"/>
        <Setter Property="CalendarItemStyle"      Value="{StaticResource OD.CalendarItem}"/>
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource OD.CalendarDayButton}"/>
        <Setter Property="CalendarButtonStyle"    Value="{StaticResource OD.CalendarButton}"/>
    </Style>

    <!-- Tarih alanı. OD.TextBox ile aynı kutu (Surface2 zemin, Sm yarıçap,
         odakta Accent kenarlık); farkı sağdaki takvim düğmesi. -->
    <Style x:Key="OD.DatePicker" TargetType="DatePicker">
        <Setter Property="Background"      Value="{StaticResource OD.Brush.Surface2}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource OD.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground"      Value="{StaticResource OD.Brush.Text}"/>
        <Setter Property="FontFamily"      Value="{StaticResource OD.Font.Sans}"/>
        <Setter Property="FontSize"        Value="{StaticResource OD.Font.F2}"/>
        <Setter Property="CalendarStyle"   Value="{StaticResource OD.Calendar}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <ControlTemplate.Resources>
                        <!-- Yazı kutusu kendi çerçevesini çizmiyor: çerçeve dıştaki
                             Root'un, kutu onun içinde saydam duruyor.
                             PART_Watermark BİLEREK yok — varsayılan şablonda ipucu
                             metnini ("Tarih seçin") görünür/gizli yapan şey görsel
                             durumlar; onları yazmadan eklenirse ipucu seçili tarihin
                             ÜSTÜNE binip kalıyor. Kontrolün kodu null'a dayanıklı. -->
                        <Style TargetType="DatePickerTextBox">
                            <Setter Property="Background"      Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding"         Value="{StaticResource OD.Pad.4}"/>
                            <Setter Property="CaretBrush"      Value="{StaticResource OD.Brush.Text}"/>
                            <Setter Property="SelectionBrush"  Value="{StaticResource OD.Brush.Accent}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DatePickerTextBox">
                                        <!-- PART_ContentHost adı zorunlu (bkz. OD.TextBox). -->
                                        <Decorator x:Name="PART_ContentHost"
                                                   Margin="{TemplateBinding Padding}"
                                                   VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ControlTemplate.Resources>

                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource OD.Radius.Sm}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                               Focusable="{TemplateBinding Focusable}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontSize="{TemplateBinding FontSize}"/>

                            <Button x:Name="PART_Button" Grid.Column="1"
                                    Focusable="False" Cursor="Hand"
                                    Foreground="{StaticResource OD.Brush.TextDim}"
                                    ToolTip="Takvimi aç">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent"
                                                Padding="{StaticResource OD.Pad.3}">
                                            <Path Data="{StaticResource OD.Path.Calendar}"
                                                  Style="{StaticResource OD.IconPath}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource OD.Brush.Text}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Takvim buraya KODLA konuyor (DatePicker popup'ın
                                 Child'ını kendisi atıyor), o yüzden içi boş. -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=Root}"
                                   StaysOpen="False"
                                   AllowsTransparency="True"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{StaticResource OD.Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bölüm üstü küçük büyük-harf etiket. Mockup .micro -->
    <Style x:Key="OD.Text.Micro" TargetType="TextBlock">
        <Setter Property="FontFamily"     Value="{StaticResource OD.Font.Sans}"/>
        <Setter Property="FontSize"       Value="{StaticResource OD.Font.F0}"/>
        <Setter Property="FontWeight"     Value="SemiBold"/>
        <Setter Property="Foreground"     Value="{StaticResource OD.Brush.TextMute}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- Sayısal değer: sabit genişlikli rakam, sayaçlar zıplamasın. -->
    <Style x:Key="OD.Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OD.Font.Mono}"/>
        <Setter Property="Foreground" Value="{StaticResource OD.Brush.Text}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- Hap sayaç: kuyruk başlığındaki adet. Mockup .q-count -->
    <Style x:Key="OD.CountPill" TargetType="Border">
        <Setter Property="Background"   Value="{StaticResource OD.Brush.Surface2}"/>
        <Setter Property="BorderBrush"  Value="{StaticResource OD.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource OD.Radius.Full}"/>
        <Setter Property="Padding"      Value="{StaticResource OD.Pad.3}"/>
    </Style>

    <!-- ══ Veri ızgarası (Faz 3) ═════════════════════════════════════════
         Dört sayfa tüketiyor: Kara Liste, Yayın Geçmişi, Yayın Raporu,
         Dönem Raporu. Spec §9 gereği stil ancak şimdi yazıldı.

         DarkControls'taki örtük DataGrid* stilleri eski token setine
         (OD.Bg.*, OD.Fg.*) bağlı; buradakiler yeni palete bağlı ve
         x:Key'li, yani sayfalar dönüştükçe eskisi kendiliğinden
         kullanımdan düşüyor (Faz 4'te DarkControls silinecek).

         Zebra şerit YOK. Pencere sürümünde AlternatingRowBackground
         vardı; satır zeminini hem zebra hem de üzerine-gelme durumu
         yazmak istiyor, ikisi aynı özelliğe oturuyor. Seçim + üzerine
         gelme okunaklılık için zebradan daha değerli, o yüzden zebra
         düştü. -->
    <Style x:Key="OD.DataGrid.Header" TargetType="DataGridColumnHeader">
        <Setter Property="Background"  Value="{StaticResource OD.Brush.Surface2}"/>
        <Setter Property="Foreground"  Value="{StaticResource OD.Brush.TextMute}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OD.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding"     Value="{StaticResource OD.Pad.3}"/>
        <Setter Property="FontFamily"  Value="{StaticResource OD.Font.Sans}"/>
        <Setter Property="FontSize"    Value="{StaticResource OD.Font.F0}"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style x:Key="OD.DataGrid.Cell" TargetType="DataGridCell">
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Foreground"  Value="{StaticResource OD.Brush.Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"     Value="{StaticResource OD.Pad.3}"/>
        <Setter Property="FontFamily"  Value="{StaticResource OD.Font.Sans}"/>
        <Setter Property="FontSize"    Value="{StaticResource OD.Font.F1}"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- Varsayılan şablon odakta bir kenarlık çiziyor ve
                     dolguyu yok sayıyor; ikisi de burada elde. -->
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource OD.Brush.Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource OD.Brush.OnAccent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OD.DataGrid.Row" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <!-- Seçim hücrede boyanıyor; burada yalnız üzerine gelme var.
                 Sıra önemli: seçili satırda da IsMouseOver doğru olur,
                 ama hücrenin kendi zemini bu satır zeminini örttüğü için
                 çakışma görünmüyor. -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource OD.Brush.Surface2}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OD.DataGrid" TargetType="DataGrid">
        <Setter Property="Background"      Value="{StaticResource OD.Brush.Surface}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource OD.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground"   Value="Transparent"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility"   Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly"          Value="True"/>
        <Setter Property="SelectionUnit"       Value="FullRow"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource OD.DataGrid.Header}"/>
        <Setter Property="CellStyle"         Value="{StaticResource OD.DataGrid.Cell}"/>
        <Setter Property="RowStyle"          Value="{StaticResource OD.DataGrid.Row}"/>
    </Style>

    <!-- ══ Form dili (Faz 3b) ═════════════════════════════════════════════
         Ayarlar sayfası tek başına 60+ alan taşıyor; pencere sürümünde bu
         dil SettingsTheme.xaml'de, YALNIZ o pencereye scope'lu olarak
         duruyordu (434 satır, ayrı bir renk sözlüğüyle). Sayfaya inince
         scope numarası gereksiz kaldı ve stiller buraya, tek palete
         bağlanarak taşındı; SettingsTheme silindi.

         Aşağıdaki beş metin stili spec §10'un "benzersiz FontSize ≤ 6"
         kuralının pratikteki karşılığı: form metninin beş rolü var
         (bölme başlığı, kart başlığı, alan etiketi, ipucu, birim eki) ve
         her biri ölçekten bir basamak seçiyor, yeni basamak açmıyor. -->

    <!-- Form kartı. OD.Panel yüzeyin kendisi (kenarlık + yuvarlatma);
         kart ayrıca iç dolgu ve alt boşluk taşıyor. Ayrı stil, çünkü
         panel yerleşim tarafından ölçülen bir yüzey (sohbet, kuyruk),
         kart ise akış içinde alt alta dizilen bir blok. -->
    <Style x:Key="OD.Card" TargetType="Border" BasedOn="{StaticResource OD.Panel}">
        <Setter Property="Padding" Value="{StaticResource OD.Pad.6}"/>
        <Setter Property="Margin"  Value="{StaticResource OD.Pad.Bottom5}"/>
    </Style>

    <!-- Bölme başlığı: "Yazıcı & Çıktı". Sayfa başlığı DEĞİL — onu
         PageHost'un şeridi gösteriyor. -->
    <Style x:Key="OD.Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OD.Font.Display}"/>
        <Setter Property="FontSize"   Value="{StaticResource OD.Font.F3}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource OD.Brush.Text}"/>
    </Style>

    <!-- Kart başlığı: "Etiket Ölçüleri". -->
    <Style x:Key="OD.Text.Section" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OD.Font.Sans}"/>
        <Setter Property="FontSize"   Value="{StaticResource OD.Font.F2}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource OD.Brush.Text}"/>
        <Setter Property="Margin"     Value="{StaticResource OD.Pad.Bottom3}"/>
    </Style>

    <!-- Alan etiketi: girdi kutusunun üstündeki ad. -->
    <Style x:Key="OD.Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily"    Value="{StaticResource OD.Font.Sans}"/>
        <Setter Property="FontSize"      Value="{StaticResource OD.Font.F1}"/>
        <Setter Property="Foreground"    Value="{StaticResource OD.Brush.TextDim}"/>
        <Setter Property="TextWrapping"  Value="Wrap"/>
        <Setter Property="Margin"        Value="{StaticResource OD.Pad.Bottom3}"/>
    </Style>

    <!-- İpucu: alanın altındaki açıklama. TextMute, çünkü etiketten de
         geride durmalı — okunması gereken sıra ad → değer → açıklama. -->
    <Style x:Key="OD.Text.Hint" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{StaticResource OD.Font.Sans}"/>
        <Setter Property="FontSize"     Value="{StaticResource OD.Font.F0}"/>
        <Setter Property="Foreground"   Value="{StaticResource OD.Brush.TextMute}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin"       Value="{StaticResource OD.Pad.Top3}"/>
    </Style>

    <!-- Birim eki: kutunun sağındaki mm / pt / ₺. Mono, çünkü yanındaki
         sayıyla aynı satıra oturuyor ve orantılı yazıda hizası kayıyor. -->
    <Style x:Key="OD.Text.Suffix" TargetType="TextBlock"
           BasedOn="{StaticResource OD.Text.Mono}">
        <Setter Property="FontSize"          Value="{StaticResource OD.Font.F1}"/>
        <Setter Property="Foreground"        Value="{StaticResource OD.Brush.TextMute}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"            Value="{StaticResource OD.Pad.X2}"/>
    </Style>

    <!-- ══ Açılır liste ═══════════════════════════════════════════════════
         Üç yerde: yazıcı seçimi, etiket yazı tipi, sohbet teması.
         Şablon baştan yazılıyor çünkü WPF'in yerleşik ComboBox'ı açılır
         listesini sistem renkleriyle çiziyor; koyu zeminde beyaz bir
         panel açılıyordu. -->
    <ControlTemplate x:Key="OD.ComboBox.Toggle" TargetType="ToggleButton">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource OD.Radius.Sm}">
            <Path Data="{StaticResource OD.Path.ChevronDown}"
                  Width="{StaticResource OD.Icon.Sm}"
                  Height="{StaticResource OD.Icon.Sm}"
                  Stretch="Uniform"
                  Fill="{StaticResource OD.Brush.TextMute}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="{StaticResource OD.Pad.4}"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush"
                        Value="{StaticResource OD.Brush.Accent}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="OD.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource OD.Font.Sans}"/>
        <Setter Property="FontSize"   Value="{StaticResource OD.Font.F2}"/>
        <Setter Property="Foreground" Value="{StaticResource OD.Brush.Text}"/>
        <Setter Property="Padding"    Value="{StaticResource OD.Pad.3}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource OD.Radius.Xs}"
                            Margin="{StaticResource OD.Pad.1}">
                        <ContentPresenter
                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Klavyeyle gezinme (IsHighlighted) ile seçili olan
                             AYNI görünüyor: listede tek bir vurgu olsun,
                             operatör hangisinin seçileceğini tek yerden görsün. -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource OD.Brush.Surface2}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource OD.Brush.Surface2}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource OD.Brush.AccentHot}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OD.ComboBox" TargetType="ComboBox">
        <Setter Property="Background"      Value="{StaticResource OD.Brush.Surface2}"/>
        <Setter Property="Foreground"      Value="{StaticResource OD.Brush.Text}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource OD.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="{StaticResource OD.Pad.4}"/>
        <Setter Property="FontFamily"      Value="{StaticResource OD.Font.Sans}"/>
        <Setter Property="FontSize"        Value="{StaticResource OD.Font.F2}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource OD.ComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Template="{StaticResource OD.ComboBox.Toggle}"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}"/>
                        <!-- Seçili öğe düğmenin ÜSTÜNE çiziliyor ve tıklamayı
                             yutmuyor; tersi olsaydı metne tıklamak listeyi
                             açmazdı. -->
                        <ContentPresenter IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Popup Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Slide"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{StaticResource OD.Brush.Surface2}"
                                    BorderBrush="{StaticResource OD.Brush.BorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource OD.Radius.Sm}"
                                    Margin="{StaticResource OD.Pad.Top3}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    MinWidth="{Binding ActualWidth,
                                              RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Anahtar ════════════════════════════════════════════════════════
         CheckBox ama kutucuk değil: ayarlarda 12 açık/kapalı alan var ve
         hepsi "şu an açık mı?" sorusuna cevap veriyor. Anahtar bunu
         uzaktan da okutuyor, kutucuk okutmuyor. -->
    <Style x:Key="OD.Toggle" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource OD.Font.Sans}"/>
        <Setter Property="FontSize"   Value="{StaticResource OD.Font.F2}"/>
        <Setter Property="Foreground" Value="{StaticResource OD.Brush.Text}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Zemin Transparent: şeffaf Grid tıklama almaz,
                         yalnız ray ve yazı tıklanabilir olurdu. -->
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track"
                                Width="{StaticResource OD.Layout.ToggleWidth}"
                                Height="{StaticResource OD.Layout.ToggleHeight}"
                                CornerRadius="{StaticResource OD.Radius.Full}"
                                Background="{StaticResource OD.Brush.Surface2}"
                                BorderBrush="{StaticResource OD.Brush.BorderStrong}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Border x:Name="Thumb"
                                    Width="{StaticResource OD.Layout.ToggleThumb}"
                                    Height="{StaticResource OD.Layout.ToggleThumb}"
                                    CornerRadius="{StaticResource OD.Radius.Full}"
                                    Background="{StaticResource OD.Brush.TextMute}"
                                    HorizontalAlignment="Left"
                                    Margin="{StaticResource OD.Pad.1}"/>
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="{StaticResource OD.Pad.Left4}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background"
                                    Value="{StaticResource OD.Brush.Accent}"/>
                            <Setter TargetName="Track" Property="BorderBrush"
                                    Value="{StaticResource OD.Brush.Accent}"/>
                            <Setter TargetName="Thumb" Property="Background"
                                    Value="{StaticResource OD.Brush.OnAccent}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment"
                                    Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor"  Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Kaydırgaç ══════════════════════════════════════════════════════
         Tek tüketici: çekiliş animasyonu ses seviyesi. DarkControls'te
         Slider HİÇ yoktu — koyu sayfanın ortasında sistem temasının açık
         gri rayı çıkıyordu. Pencere sürümünde de öyleydi (SettingsTheme
         de yazmamış), yani dönüşümle görünür olan eski bir açık. -->
    <Style x:Key="OD.Slider" TargetType="Slider">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="{StaticResource OD.Layout.SliderTrack}"
                                CornerRadius="{StaticResource OD.Radius.Full}"
                                Background="{StaticResource OD.Brush.Surface2}"
                                BorderBrush="{StaticResource OD.Brush.Border}"
                                BorderThickness="1"/>
                        <!-- Track adı zorunlu: Slider topuzun konumunu bu
                             parçadan hesaplıyor, adı değişirse topuz sabit kalır. -->
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="{StaticResource OD.Layout.SliderThumb}"
                                                     Height="{StaticResource OD.Layout.SliderThumb}"
                                                     Fill="{StaticResource OD.Brush.Accent}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <!-- Yineleme düğmeleri şeffaf ama VAR: raya
                                 tıklayınca değer o yöne adımlıyor. -->
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Background="Transparent"
                                              BorderThickness="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Background="Transparent"
                                              BorderThickness="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Bölme rayı ═════════════════════════════════════════════════════
         Ayarların on sekmesi. TabControl kalıyor çünkü seçili bölmeyi
         hangi ContentPresenter'ın göstereceğini WPF zaten çözüyor; şablon
         yalnız yatay şerit yerine sol ray çiziyor.

         Ray genişliği kabuğun kenar çubuğuyla AYNI token: sayfa kenar
         çubuğunun üstünü örtüyor, iki ray farklı genişlikte olsaydı sayfa
         açılırken sol kenar kayardı. -->
    <Style x:Key="OD.Nav.Tabs" TargetType="TabControl">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="{StaticResource OD.Layout.SideWidth}"
                                Background="{StaticResource OD.Brush.Surface}"
                                BorderBrush="{StaticResource OD.Brush.Border}"
                                BorderThickness="0,0,1,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Padding="{StaticResource OD.Pad.4}">
                                <StackPanel IsItemsHost="True"/>
                            </ScrollViewer>
                        </Border>
                        <ScrollViewer Grid.Column="1"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="{StaticResource OD.Pad.7}">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OD.Nav.Tab" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource OD.Font.Sans}"/>
        <Setter Property="FontSize"   Value="{StaticResource OD.Font.F2}"/>
        <Setter Property="Foreground" Value="{StaticResource OD.Brush.TextDim}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent"
                            CornerRadius="{StaticResource OD.Radius.Md}"
                            Margin="{StaticResource OD.Pad.1}"
                            Padding="{StaticResource OD.Pad.4}">
                        <ContentPresenter ContentSource="Header"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource OD.Brush.Surface2}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource OD.Brush.Text}"/>
                        </Trigger>
                        <!-- Seçili öğe kenar çubuğunun nav satırıyla aynı
                             dili konuşuyor: dolu aksan zemin + OnAccent yazı.
                             Şerit + sönük zemin denemesi (pencere sürümü)
                             dar rayda seçiliyi hover'dan ayırmıyordu. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource OD.Brush.Accent}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource OD.Brush.OnAccent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Belirsiz ilerleme çubuğu (BootGate "Hazırlanıyor", LoginGate "meşgul").
         Varsayılan Aero şablonu YEŞİL çizer ve kapalı paletin dışında kalır;
         ayrıca DarkControls'te de örtük karşılığı yok. Determinate mod da
         çalışsın diye PART_Indicator korunuyor, ama bugün yalnız
         IsIndeterminate kullanılıyor.

         Belirsiz animasyon: dar bir parlak blok rayın soluna girip sağından
         çıkıyor. TranslateTransform üzerinden, Width'e dokunmadan — layout
         her karede yeniden ölçülmesin. -->
    <Style x:Key="OD.ProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="{StaticResource OD.Layout.ProgressHeight}"/>
        <Setter Property="Background" Value="{StaticResource OD.Brush.Surface2}"/>
        <Setter Property="Foreground" Value="{StaticResource OD.Brush.Accent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="Track"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource OD.Radius.Full}"
                            ClipToBounds="True">
                        <Grid>
                            <Rectangle x:Name="PART_Track" Fill="Transparent"/>
                            <Rectangle x:Name="PART_Indicator"
                                       HorizontalAlignment="Left"
                                       Fill="{TemplateBinding Foreground}"/>
                            <Rectangle x:Name="Pulse"
                                       Width="80"
                                       HorizontalAlignment="Left"
                                       Visibility="Collapsed"
                                       Fill="{TemplateBinding Foreground}">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="PulseShift" X="-80"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Pulse" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PulseLoop">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PulseShift"
                                                         Storyboard.TargetProperty="X"
                                                         From="-80" To="440"
                                                         Duration="0:0:1.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="PulseLoop"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
