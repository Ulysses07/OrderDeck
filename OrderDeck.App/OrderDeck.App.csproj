<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Lokal default; CI release (-p:Version) tag'den override eder. In-app
         güncelleme kontrolü bu sürümü server'daki LatestVersion ile karşılaştırır. -->
    <Version>0.1.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <UseWPF>true</UseWPF>
    <!-- OrderDeck.App.exe gömülü ikonu (installer\make-icon.ps1 ile üretilir). -->
    <ApplicationIcon>orderdeck.ico</ApplicationIcon>
    <!-- Velopack: özel [STAThread] Main entry point. App.xaml aşağıda
         ApplicationDefinition yerine Page olarak derlenir; Main'i biz yazıp
         VelopackApp.Build().Run()'ı WPF'ten ÖNCE çağırıyoruz (install/update
         hook'ları hızlı çalışıp çıkmalı, WPF yükünden kaçınmalı). -->
    <StartupObject>OrderDeck.App.App</StartupObject>
  </PropertyGroup>

  <!-- App.xaml'i ApplicationDefinition (otomatik Main üretir) yerine Page
       yap ki kendi Main'imiz StartupObject olarak geçerli olsun. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrderDeck.Core\OrderDeck.Core.csproj" />
    <ProjectReference Include="..\OrderDeck.PdfParsing\OrderDeck.PdfParsing.csproj" />
    <ProjectReference Include="..\OrderDeck.Chat\OrderDeck.Chat.csproj" />
    <ProjectReference Include="..\OrderDeck.Overlay\OrderDeck.Overlay.csproj" />
    <ProjectReference Include="..\OrderDeck.Labeling\OrderDeck.Labeling.csproj" />
    <ProjectReference Include="..\OrderDeck.Licensing\OrderDeck.Licensing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>OrderDeck.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Overlay wwwroot'u publish çıktısına dahil et. OrderDeck.Overlay (Web SDK)
       kendi Content'ine CopyToPublishDirectory verir; ama bu, ProjectReference
       üzerinden tüketen bu WPF App'in `dotnet publish` çıktısına transitif AKMAZ
       (yalnızca build/bin'e kopyalanır, publish'te düşer). OverlayHost runtime'da
       AppContext.BaseDirectory\wwwroot okuduğu için, açık bu kural olmadan
       installer'da overlay sayfaları (chat/giveaway/preview) eksik kalır.
       Dosyalar wwwroot\ altına link'lenip hem output hem publish'e taşınır. -->
  <ItemGroup>
    <Content Include="..\OrderDeck.Overlay\wwwroot\**\*">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Marka fontları (Ayarlar penceresi) — WPF Resource olarak gömülür,
       pack URI ile referans: /Fonts/#Bricolage Grotesque 14pt, #JetBrains Mono -->
  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="SharpVectors.Reloaded" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
</Project>
