<Project>
  <PropertyGroup>
    <!--
      NU1903 — SQLitePCLRaw.lib.e_sqlite3 (≤2.1.11), Microsoft.Data.Sqlite üzerinden
      transitif gelir. Advisory GHSA-2m69-gcr7-jv3q (SQLite <3.50.2'de aggregate
      term/column taşması). 2026-06 itibarıyla SQLitePCLRaw'ın YAMALI sürümü YOK.
      Projeler TreatWarningsAsErrors kullandığından bu NuGet audit uyarısı restore'u
      kırıyor. Yamalı SQLitePCLRaw çıkana kadar uyarı görünür kalsın ama build'i
      kırmasın. TODO: SQLitePCLRaw yamalı sürüme geçince bu satırı kaldır.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1903</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
